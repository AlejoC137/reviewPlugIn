<Window x:Class="RevitToSupabasePlugin.ManagerFamiliasLadrilloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de Familias de Ladrillo &amp; Pegas (Mortero) | ARCA REVIEW" 
        Height="740" Width="1080" 
        MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen" 
        Background="#FCF9F4"
        Foreground="#1C1C19"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#1C1C19"
        FontFamily="Segoe UI, Inter, sans-serif"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ReviewDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Estilo Lista Limpia ARCA -->
            <Style x:Key="ArcaListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="#1C1C19"/>
                <Setter Property="BorderBrush" Value="#1C1C19"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#1C1C19"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="#E5E2DD" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#D1E4F9"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0F4369"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F6F3EE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- 0: Línea Técnica Superior de Marca -->
            <RowDefinition Height="3"/>
            <!-- 1: Encabezado Institucional Review -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Cuerpo Principal a 3 Columnas -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- LÍNEA SUPERIOR DE MARCA -->
        <Rectangle Grid.Row="0" Fill="#0F4369" HorizontalAlignment="Stretch"/>

        <!-- ENCABEZADO DE IDENTIDAD ARCA REVIEW -->
        <Border Grid.Row="1" Background="#F6F3EE" BorderBrush="#1C1C19" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧱" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="GESTOR DE FAMILIAS DE ALBAÑILERÍA &amp; PEGAS" FontSize="14" FontWeight="Bold" Foreground="#0F4369" VerticalAlignment="Center"/>
                        <Border Background="#D1E4F9" BorderBrush="#0F4369" BorderThickness="1" CornerRadius="0" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ALBAÑILERÍA TÉCNICA" FontSize="9" FontWeight="Bold" Foreground="#0F4369"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Catálogo de piezas de mampostería, bloques de ladrillo y familias paramétricas de mortero de pega (PegaH / PegaV)." 
                               FontSize="11" Foreground="#72777F" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUERPO PRINCIPAL A 3 COLUMNAS -->
        <Grid Grid.Row="2" Margin="12,10,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="270" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA 1: CATÁLOGO DE LADRILLOS Y PEGAS -->
            <Grid Grid.Column="0" Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- CARD SUPERIOR: Familias de Ladrillo -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#1C1C19" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="🧱 Familias de Ladrillo" FontSize="12.5" FontWeight="Bold" Foreground="#0F4369"/>
                            <TextBlock Text="Ladrillos y bloques del proyecto" FontSize="10" Foreground="#72777F" Margin="0,1,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="lstBricks" Grid.Row="1" SelectionChanged="LstBricks_SelectionChanged" DisplayMemberPath="FullName" 
                                 Style="{StaticResource ArcaListBoxStyle}" Margin="0,0,0,8"/>

                        <StackPanel Grid.Row="2">
                            <Button x:Name="btnAddBrick" Content="➕ Agregar Nuevo Ladrillo" Click="BtnAddBrick_Click" 
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,0,4"/>
                            <Button x:Name="btnExportBrick" Content="📤 Exportar Ladrillo" Click="BtnExportBrick_Click" 
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SPLITTER VERTICAL INTERNO -->
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#C2C7CF" Cursor="SizeNS"/>

                <!-- CARD INFERIOR: Familias de Pega (Mortero) -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#1C1C19" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="🧈 Familias de Pega (Mortero)" FontSize="12.5" FontWeight="Bold" Foreground="#0F4369"/>
                            <TextBlock Text="Pegas horizontales (PegaH) y verticales (PegaV)" FontSize="10" Foreground="#72777F" Margin="0,1,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="lstPegas" Grid.Row="1" SelectionChanged="LstPegas_SelectionChanged" DisplayMemberPath="FullName" 
                                 Style="{StaticResource ArcaListBoxStyle}" Margin="0,0,0,8"/>

                        <StackPanel Grid.Row="2">
                            <Button x:Name="btnAddPega" Content="➕ Agregar Nueva Pega" Click="BtnAddPega_Click" 
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,0,4"/>
                            <Button x:Name="btnExportPega" Content="📤 Exportar Pega" Click="BtnExportPega_Click" 
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- SPLITTER 1 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#C2C7CF" Cursor="SizeWE"/>

            <!-- COLUMNA 2: GESTIÓN Y PROPIEDADES DEL TIPO -->
            <Border Grid.Column="2" Background="#F6F3EE" BorderBrush="#1C1C19" BorderThickness="1" Padding="10" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Gestión de Componente" FontWeight="Bold" FontSize="12.5" Foreground="#0F4369" Margin="0,0,0,8"/>

                    <!-- BOTONES DE ACCIÓN RÁPIDA -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnLocate" Content="📍 Ubicar" Click="BtnLocate_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,2,0" IsEnabled="False" ToolTip="Ubicar ejemplares en Revit"/>
                            <Button x:Name="btnUpdate" Content="🔄 Actualizar" Click="BtnUpdate_Click" Style="{StaticResource SecondaryButton}" Grid.Column="1" Margin="2,0,0,0" IsEnabled="False" ToolTip="Actualizar archivo RFA"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnEdit" Content="✏️ Editar" Click="BtnEdit_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,2,0" IsEnabled="False" ToolTip="Abrir familia en editor de Revit"/>
                            <Button x:Name="btnDuplicate" Content="📑 Duplicar" Click="BtnDuplicate_Click" Style="{StaticResource SecondaryButton}" Grid.Column="1" Margin="2,0,0,0" IsEnabled="False" ToolTip="Duplicar tipo seleccionado"/>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnDeleteType" Content="🗑️ Borrar Tipo" Click="BtnDeleteType_Click" Style="{StaticResource DangerButton}" Margin="0,0,2,0" FontSize="10" IsEnabled="False"/>
                            <Button x:Name="btnDelete" Content="🗑️ Borrar Fam." Click="BtnDelete_Click" Style="{StaticResource DangerButton}" Grid.Column="1" Margin="2,0,0,0" FontSize="10" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Propiedades del Tipo" FontWeight="Bold" FontSize="12.5" Foreground="#0F4369" Margin="0,4,0,6"/>
                    
                    <!-- CAMPOS DE PROPIEDADES -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="pnlProperties" IsEnabled="False" Margin="0,0,4,0">
                            <TextBlock Text="IDENTIFICACIÓN" Foreground="#0F4369" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            
                            <TextBlock Text="Nombre Familia:" Foreground="#72777F" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtFamilyName" Style="{StaticResource ArcaTextBox}" Margin="0,0,0,6"/>
                            
                            <TextBlock Text="Nombre Tipo:" Foreground="#72777F" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtTypeName" Style="{StaticResource ArcaTextBox}" Margin="0,0,0,8"/>

                            <TextBlock Text="DIMENSIONES (CM)" Foreground="#0F4369" FontSize="10" FontWeight="Bold" Margin="0,2,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Largo (Depth):" Foreground="#72777F" FontSize="9.5" Margin="0,0,0,2"/>
                                    <TextBox x:Name="txtDepth" Style="{StaticResource ArcaTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Ancho (Width):" Foreground="#72777F" FontSize="9.5" Margin="0,0,0,2"/>
                                    <TextBox x:Name="txtWidth" Style="{StaticResource ArcaTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
                                    <TextBlock Text="Alto (Height):" Foreground="#72777F" FontSize="9.5" Margin="0,0,0,2"/>
                                    <TextBox x:Name="txtHeight" Style="{StaticResource ArcaTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,0">
                                    <TextBlock Text="Pared (Thickness):" Foreground="#72777F" FontSize="9.5" Margin="0,0,0,2"/>
                                    <TextBox x:Name="txtThickness" Style="{StaticResource ArcaTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="DATOS BIM" Foreground="#0F4369" FontSize="10" FontWeight="Bold" Margin="0,4,0,4"/>

                            <TextBlock Text="Costo ($):" Foreground="#72777F" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtCost" Style="{StaticResource ArcaTextBox}" Margin="0,0,0,6"/>
                            
                            <TextBlock Text="Descripción:" Foreground="#72777F" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtDescription" Style="{StaticResource ArcaTextBox}" Margin="0,0,0,6"/>
                            
                            <TextBlock Text="Fabricante:" Foreground="#72777F" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtManufacturer" Style="{StaticResource ArcaTextBox}" Margin="0,0,0,6"/>
                            
                            <TextBlock Text="Material Asignado:" Foreground="#72777F" FontSize="10" Margin="0,0,0,2"/>
                            <ComboBox x:Name="cmbMaterial" DisplayMemberPath="Name" Margin="0,0,0,10" Background="#FFFFFF" Foreground="#1C1C19" BorderBrush="#1C1C19" BorderThickness="1" Padding="6,4"/>

                            <Button x:Name="btnSaveProperties" Content="💾 Guardar Propiedades" Click="BtnSaveProperties_Click" 
                                    Style="{StaticResource SuccessButton}" Height="34" Margin="0,2,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- SPLITTER 2 -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="#C2C7CF" Cursor="SizeWE"/>

            <!-- COLUMNA 3: PREVISUALIZADOR 3D INTERACTIVO -->
            <Grid Grid.Column="4" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Previsualizador Técnico 3D" FontWeight="Bold" FontSize="12.5" Foreground="#0F4369" Grid.Row="0" Margin="0,0,0,8"/>

                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="0" ClipToBounds="True">
                    <Grid MouseLeftButtonDown="Viewport_MouseLeftButtonDown" MouseLeftButtonUp="Viewport_MouseLeftButtonUp" MouseMove="Viewport_MouseMove" MouseWheel="Viewport_MouseWheel" Background="Transparent">
                        
                        <!-- Main 3D Viewport -->
                        <Viewport3D x:Name="viewport3D">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="camera3D" Position="1,1,1" LookDirection="-1,-1,-1" UpDirection="0,0,1" FieldOfView="45"/>
                            </Viewport3D.Camera>
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup x:Name="modelGroup">
                                        <AmbientLight Color="#666666" />
                                        <DirectionalLight Color="#FFFFFF" Direction="-1,-1,-1" />
                                        <DirectionalLight Color="#444444" Direction="1,1,1" />
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                        </Viewport3D>

                        <!-- Labels and Overlay -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#CC0F172A" BorderBrush="#0F4369" BorderThickness="1" Padding="8,4" Margin="10">
                            <StackPanel>
                                <TextBlock x:Name="lblViewOrientation" Text="Isométrica" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"/>
                                <TextBlock x:Name="lblBrickSize" Text="Selecciona un ladrillo o pega" Foreground="#94A3B8" FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Axis Gizmo 3D -->
                        <Viewport3D x:Name="gizmoViewport" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="gizmoCamera" Position="2,2,2" LookDirection="-1,-1,-1" UpDirection="0,0,1" FieldOfView="45"/>
                            </Viewport3D.Camera>
                            <ModelVisual3D x:Name="gizmoVisual">
                                <ModelVisual3D.Content>
                                    <Model3DGroup x:Name="gizmoGroup">
                                        <AmbientLight Color="White"/>
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                        </Viewport3D>
                        <Canvas Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                            <TextBlock x:Name="lblAxisZ" Text="Z" Foreground="#38BDF8" Canvas.Top="0" Canvas.Left="40" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="lblAxisY" Text="Y" Foreground="#4ADE80" Canvas.Top="60" Canvas.Left="70" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="lblAxisX" Text="X" Foreground="#F87171" Canvas.Top="60" Canvas.Left="0" FontSize="10" FontWeight="Bold"/>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
