<Window x:Class="RevitToSupabasePlugin.ManagerFamiliasLadrilloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager de Familias de Ladrillo" 
        Height="700" Width="850" 
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen" 
        Background="#121214"
        Foreground="#E3E5E8"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#38A169"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1C20"/>
            <Setter Property="Foreground" Value="#121214"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1C20"/>
            <Setter Property="Foreground" Value="#F7FAFC"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2B2D31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA: Formulario -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="🧱 Manager de Familias" FontSize="22" FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#38A169" Offset="0.0"/>
                                <GradientStop Color="#4FD1C5" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Configura familias de ladrillos" FontSize="11" Foreground="#A0AEC0" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Configuración Básica -->
                <GroupBox Header="1. Dimensiones y Material" Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nombre -->
                        <TextBlock Text="Nombre:" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="11" Grid.Row="0" Grid.ColumnSpan="5"/>
                        <TextBox x:Name="txtName" Grid.Row="1" Grid.ColumnSpan="5" Text="Ladrillo Tipo 1"/>

                        <!-- Dimensiones -->
                        <TextBlock Text="Largo (cm):" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="11" Grid.Row="2" Grid.Column="0"/>
                        <TextBox x:Name="txtLength" Grid.Row="3" Grid.Column="0" Text="24" TextChanged="Input_Changed"/>

                        <TextBlock Text="Ancho (cm):" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="11" Grid.Row="2" Grid.Column="2"/>
                        <TextBox x:Name="txtWidth" Grid.Row="3" Grid.Column="2" Text="11.5" TextChanged="Input_Changed"/>

                        <TextBlock Text="Alto (cm):" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="11" Grid.Row="2" Grid.Column="4"/>
                        <TextBox x:Name="txtHeight" Grid.Row="3" Grid.Column="4" Text="7" TextChanged="Input_Changed"/>

                        <TextBlock Text="Material Principal:" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="11" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"/>
                        <ComboBox x:Name="cmbMaterial" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" SelectedIndex="0" SelectionChanged="CmbMaterial_SelectionChanged">
                            <ComboBoxItem Content="Ladrillo N°4 Rayado"/>
                            <ComboBoxItem Content="Ladrillo N°4 Barranquilla"/>
                            <ComboBoxItem Content="Bloque N°4 Tradicional Helios"/>
                            <ComboBoxItem Content="Bloque N°5 Tradicional Helios"/>
                            <ComboBoxItem Content="Bloquelón Santafe"/>
                            <ComboBoxItem Content="Personalizado..."/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- Módulos de Inteligencia -->
                <GroupBox Header="2. Módulos de Comportamiento Inteligente" Grid.Row="2">
                    <StackPanel>
                        <!-- Pega -->
                        <CheckBox x:Name="chkPega" Content="Incluir Sistema de Pega (Mortero)" IsChecked="True" Foreground="#E3E5E8" Margin="0,5,0,5" Checked="Input_Changed" Unchecked="Input_Changed"/>
                        
                        <!-- Recortes -->
                        <CheckBox x:Name="chkRecortes" Content="Sistema de Recortes Adaptativos (Void)" IsChecked="True" Foreground="#E3E5E8" Margin="0,5,0,5" Checked="Input_Changed" Unchecked="Input_Changed"/>
                        
                        <!-- Dovela -->
                        <CheckBox x:Name="chkDovela" Content="Perforación para Dovela Central" IsChecked="False" Foreground="#E3E5E8" Margin="0,5,0,5" Checked="Input_Changed" Unchecked="Input_Changed"/>

                        <!-- Canchado -->
                        <CheckBox x:Name="chkCanchado" Content="Caras Canchadas (Experimental)" IsChecked="False" Foreground="#E3E5E8" Margin="0,5,0,10" Checked="Input_Changed" Unchecked="Input_Changed"/>

                        <!-- Geometría Adicional (Opcional) -->
                        <TextBlock Text="Perfil Base Adicional (.rfa):" Foreground="#A0AEC0" Margin="0,10,0,5" FontSize="11"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtProfilePath" Grid.Column="0" IsReadOnly="True" Margin="0" Text="Ninguno..."/>
                            
                            <ComboBox x:Name="cmbProfileOrientation" Grid.Column="2" Width="90" Margin="0" SelectedIndex="0" SelectionChanged="Input_Changed">
                                <ComboBoxItem Content="Frontal"/>
                                <ComboBoxItem Content="Lateral"/>
                                <ComboBoxItem Content="Superior"/>
                            </ComboBox>
                            
                            <Button x:Name="btnBrowseProfile" Grid.Column="4" Content="Cargar..." Width="80" Margin="0" Click="BtnBrowseProfile_Click"/>
                        </Grid>

                        <!-- Restaurando Rotación y Offsets -->
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Rotación (°):" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="12"/>
                                <ComboBox x:Name="cmbProfileRotation" SelectedIndex="0" Margin="0" SelectionChanged="Input_Changed">
                                    <ComboBoxItem Content="0°"/>
                                    <ComboBoxItem Content="90°"/>
                                    <ComboBoxItem Content="180°"/>
                                    <ComboBoxItem Content="270°"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                <TextBlock Text="Offset X (cm):" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="12"/>
                                <TextBox x:Name="txtOffsetX" Text="0" Margin="0" TextChanged="Input_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Offset Y (cm):" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="12"/>
                                <TextBox x:Name="txtOffsetY" Text="0" Margin="0" TextChanged="Input_Changed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Status Bar -->
                <TextBlock x:Name="txtStatus" Text="Listo para configurar." Foreground="#718096" FontStyle="Italic" Grid.Row="3" Margin="0,0,0,10" FontSize="12"/>

                <!-- Build Button -->
                <Button x:Name="btnBuild" Grid.Row="4" Height="45" Click="BtnBuild_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="6" BorderThickness="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#38A169" Offset="0"/>
                                        <GradientStop Color="#2F855A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="🚀 Generar y Guardar Familia" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </ScrollViewer>

        <!-- COLUMNA DERECHA: Previsualizador 2D -->
        <Border Grid.Column="1" Background="#0D0D0F" BorderBrush="#2D3748" BorderThickness="1,0,0,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Previsualizador Interactivo" FontWeight="SemiBold" FontSize="14" Foreground="#A0AEC0" Grid.Row="0" Margin="0,0,0,10"/>
                <Grid Grid.Row="1" Margin="10">
                    <Border Background="#1A1A1D" CornerRadius="8" ClipToBounds="True">
                        <Grid MouseLeftButtonDown="Viewport_MouseLeftButtonDown" MouseLeftButtonUp="Viewport_MouseLeftButtonUp" MouseMove="Viewport_MouseMove" MouseWheel="Viewport_MouseWheel" Background="Transparent">
                            
                            <!-- Main 3D Viewport -->
                            <Viewport3D x:Name="viewport3D">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera x:Name="camera3D" Position="1,1,1" LookDirection="-1,-1,-1" UpDirection="0,0,1" FieldOfView="45"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup x:Name="modelGroup">
                                            <AmbientLight Color="#666666" />
                                            <DirectionalLight Color="#FFFFFF" Direction="-1,-1,-1" />
                                            <DirectionalLight Color="#444444" Direction="1,1,1" />
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>

                            <!-- Labels and Overlay -->
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10">
                                <TextBlock x:Name="lblViewOrientation" Text="Isométrica" Foreground="#A0AEC0" FontWeight="Bold" FontSize="16"/>
                                <TextBlock x:Name="lblBrickSize" Text="L: 0 x W: 0 x H: 0" Foreground="#718096" FontSize="12"/>
                            </StackPanel>

                            <!-- Axis Gizmo 3D -->
                            <Viewport3D x:Name="gizmoViewport" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera x:Name="gizmoCamera" Position="2,2,2" LookDirection="-1,-1,-1" UpDirection="0,0,1" FieldOfView="45"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D x:Name="gizmoVisual">
                                    <ModelVisual3D.Content>
                                        <Model3DGroup x:Name="gizmoGroup">
                                            <AmbientLight Color="White"/>
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>
                            <Canvas Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                                <TextBlock x:Name="lblAxisZ" Text="Z" Foreground="#4299E1" Canvas.Top="0" Canvas.Left="40" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="lblAxisY" Text="Y" Foreground="#48BB78" Canvas.Top="60" Canvas.Left="70" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="lblAxisX" Text="X" Foreground="#F56565" Canvas.Top="60" Canvas.Left="0" FontSize="10" FontWeight="Bold"/>
                            </Canvas>
                            
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
