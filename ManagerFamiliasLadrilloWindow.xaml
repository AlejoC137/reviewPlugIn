<Window x:Class="RevitToSupabasePlugin.ManagerFamiliasLadrilloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de Familias de Ladrillo" 
        Height="700" Width="1000" 
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" 
        Background="#121214"
        Foreground="#E3E5E8"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#38A169"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="#1A1C20" Margin="0,10,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="5" ShadowDepth="2"/>
                                </Border.Effect>
                            </Border>
                            <Border Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#121214" Padding="5,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2B2D31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F4248"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#15171A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#2B6CB0"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2D3748"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA 1: Selección (Ladrillos y Pegas) -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CARD SUPERIOR: Familias de Ladrillo -->
            <Border Grid.Row="0" Background="#1A202C" CornerRadius="8" Padding="10" BorderBrush="#2D3748" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="🧱 Familias de Ladrillo" FontSize="14" FontWeight="Bold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#38A169" Offset="0.0"/>
                                    <GradientStop Color="#4FD1C5" Offset="1.0"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Ladrillos y bloques del proyecto" FontSize="10" Foreground="#A0AEC0" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="lstBricks" Grid.Row="1" SelectionChanged="LstBricks_SelectionChanged" DisplayMemberPath="FullName" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="btnAddBrick" Content="➕ Agregar Nuevo Ladrillo" Click="BtnAddBrick_Click" Background="#2B6CB0" Margin="0,0,0,4"/>
                        <Button x:Name="btnExportBrick" Content="📤 Exportar Ladrillo" Click="BtnExportBrick_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SPLITTER INTERNO -->
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#2D3748" Cursor="SizeNS"/>

            <!-- CARD INFERIOR: Familias de Pega (Mortero) -->
            <Border Grid.Row="2" Background="#1A202C" CornerRadius="8" Padding="10" BorderBrush="#2D3748" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="🧈 Familias de Pega (Mortero)" FontSize="14" FontWeight="Bold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DD6B20" Offset="0.0"/>
                                    <GradientStop Color="#F6AD55" Offset="1.0"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Pegas horizontales (PegaH) y verticales (PegaV)" FontSize="10" Foreground="#A0AEC0" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="lstPegas" Grid.Row="1" SelectionChanged="LstPegas_SelectionChanged" DisplayMemberPath="FullName" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="btnAddPega" Content="➕ Agregar Nueva Pega" Click="BtnAddPega_Click" Background="#D69E2E" Margin="0,0,0,4"/>
                        <Button x:Name="btnExportPega" Content="📤 Exportar Pega" Click="BtnExportPega_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- BARRA 1: Modificar Tamaño Columna 1 vs 2 -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#2D3748" Cursor="SizeWE" ToolTip="Arrastrar para ajustar ancho de columna"/>

        <!-- COLUMNA 2: Gestión (Botones y Propiedades) -->
        <Border Grid.Column="2" BorderBrush="#2D3748" BorderThickness="1,0,1,0" Padding="10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Gestión" FontWeight="SemiBold" FontSize="14" Foreground="#A0AEC0" Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,0,0,15">
                    <Button x:Name="btnLocate" Content="📍 Ubicar en Modelo" Click="BtnLocate_Click" Height="32" IsEnabled="False"/>
                    <Button x:Name="btnUpdate" Content="🔄 Actualizar RFA" Click="BtnUpdate_Click" Height="32" IsEnabled="False"/>
                    <Button x:Name="btnEdit" Content="✏️ Editar Familia" Click="BtnEdit_Click" Height="32" IsEnabled="False"/>
                    <Button x:Name="btnDuplicate" Content="📑 Duplicar Tipo" Click="BtnDuplicate_Click" Height="32" IsEnabled="False"/>
                    <Button x:Name="btnDelete" Content="🗑️ Eliminar Familia" Click="BtnDelete_Click" Height="32" IsEnabled="False" Background="#E53E3E"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Propiedades del Tipo" FontWeight="SemiBold" FontSize="14" Foreground="#A0AEC0" Margin="0,0,0,10"/>
                
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="pnlProperties" IsEnabled="False">
                        <TextBlock Text="Identificación:" Foreground="#E3E5E8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Familia" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtFamilyName" Margin="0,0,0,6" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                        <TextBlock Text="Tipo" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtTypeName" Margin="0,0,0,10" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>

                        <TextBlock Text="Dimensiones (cm):" Foreground="#E3E5E8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Largo (Depth)" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtDepth" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Ancho (Width)" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtWidth" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
                                <TextBlock Text="Alto (Height)" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtHeight" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,0">
                                <TextBlock Text="Pared (Thickness)" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtThickness" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Costo ($)" Foreground="#A0AEC0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtCost" Margin="0,0,0,8" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                        
                        <TextBlock Text="Descripción" Foreground="#A0AEC0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtDescription" Margin="0,0,0,8" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                        
                        <TextBlock Text="Fabricante" Foreground="#A0AEC0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtManufacturer" Margin="0,0,0,8" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                        
                        <TextBlock Text="Material" Foreground="#A0AEC0" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbMaterial" DisplayMemberPath="Name" Margin="0,0,0,12" Background="#2D3748" Foreground="#121214"/>

                        <Button x:Name="btnSaveProperties" Content="💾 Guardar Propiedades" Click="BtnSaveProperties_Click" Height="35" Background="#38A169"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- BARRA 2: Modificar Tamaño Columna 2 vs 3 -->
        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#2D3748" Cursor="SizeWE" ToolTip="Arrastrar para ajustar ancho del previsualizador"/>

        <!-- COLUMNA 3: Previsualizador 3D -->
        <Grid Grid.Column="4" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Previsualizador Interactivo" FontWeight="SemiBold" FontSize="14" Foreground="#A0AEC0" Grid.Row="0" Margin="0,0,0,10"/>
            <Border Grid.Row="1" Background="#1A1A1D" CornerRadius="8" ClipToBounds="True" BorderBrush="#2D3748" BorderThickness="1">
                <Grid MouseLeftButtonDown="Viewport_MouseLeftButtonDown" MouseLeftButtonUp="Viewport_MouseLeftButtonUp" MouseMove="Viewport_MouseMove" MouseWheel="Viewport_MouseWheel" Background="Transparent">
                    
                    <!-- Main 3D Viewport -->
                    <Viewport3D x:Name="viewport3D">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="camera3D" Position="1,1,1" LookDirection="-1,-1,-1" UpDirection="0,0,1" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="modelGroup">
                                    <AmbientLight Color="#666666" />
                                    <DirectionalLight Color="#FFFFFF" Direction="-1,-1,-1" />
                                    <DirectionalLight Color="#444444" Direction="1,1,1" />
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>

                    <!-- Labels and Overlay -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10">
                        <TextBlock x:Name="lblViewOrientation" Text="Isométrica" Foreground="#A0AEC0" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="lblBrickSize" Text="Selecciona un ladrillo" Foreground="#718096" FontSize="12"/>
                    </StackPanel>

                    <!-- Axis Gizmo 3D -->
                    <Viewport3D x:Name="gizmoViewport" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="gizmoCamera" Position="2,2,2" LookDirection="-1,-1,-1" UpDirection="0,0,1" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D x:Name="gizmoVisual">
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="gizmoGroup">
                                    <AmbientLight Color="White"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>
                    <Canvas Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                        <TextBlock x:Name="lblAxisZ" Text="Z" Foreground="#4299E1" Canvas.Top="0" Canvas.Left="40" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="lblAxisY" Text="Y" Foreground="#48BB78" Canvas.Top="60" Canvas.Left="70" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="lblAxisX" Text="X" Foreground="#F56565" Canvas.Top="60" Canvas.Left="0" FontSize="10" FontWeight="Bold"/>
                    </Canvas>
                    
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
