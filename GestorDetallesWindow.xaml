<Window x:Class="RevitToSupabasePlugin.GestorDetallesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📐 Gestor de Detalles &amp; Estandarización Constructiva | ARCA REVIEW"
        Height="780" Width="940"
        MinHeight="650" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4"
        Foreground="#1C1C19"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo Botón Primario (Navy) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F4369"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0F4369"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Verde Ejecutar -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#137333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#137333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E8E3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Secundario (Blueprint Ivory) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1E4F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo TextBox ARCA -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#0F4369"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Condiciones Opcionales -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Tabs (Prompt, JSON, Diagnóstico) -->
            <RowDefinition Height="*"/>
            <!-- 3: Status & Botones -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#F6F3EE" CornerRadius="4" Padding="14,10" Margin="0,0,0,14" BorderBrush="#1C1C19" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📐 Gestor y Estandarizador de Detalles Constructivos" FontSize="16" FontWeight="Bold" Foreground="#0F4369"/>
                    <TextBlock x:Name="TxtActiveViewInfo" Text="Detectando vista activa de Revit..." FontSize="12" Foreground="#72777F" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#D1E4F9" BorderBrush="#0F4369" BorderThickness="1" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="DB: Conectado ● Estándar BIM" FontSize="11" Foreground="#0F4369" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Condiciones Opcionales (No forzosas) -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="4" Padding="14,10" Margin="0,0,0,14" BorderBrush="#1C1C19" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="CONDICIONES DE CONTORNO (OPCIONALES - NO FORZOSAS)" FontSize="11" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                        <TextBlock Text="Exposición Climática:" FontSize="11" FontWeight="SemiBold" Foreground="#1C1C19" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtClimate" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Ej: Lluvia batiente / Viento severo / Interior seco"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                        <TextBlock Text="Criterio de Desempeño / Norma:" FontSize="11" FontWeight="SemiBold" Foreground="#1C1C19" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtPerformance" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Ej: Aislamiento pasivo / CTE-HE / Estándar constructivo"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <TextBlock Text="Notas o Limitaciones Específicas del Proyecto:" FontSize="11" FontWeight="SemiBold" Foreground="#1C1C19" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtNotes" Style="{StaticResource DarkTextBoxStyle}" Height="38" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Tabs de Información y Resultados -->
        <TabControl Grid.Row="2" Background="#FFFFFF" BorderBrush="#1C1C19" BorderThickness="1" Margin="0,0,0,14">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#F6F3EE"/>
                    <Setter Property="Foreground" Value="#72777F"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="BorderBrush" Value="#E5E2DD"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#0F4369"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="#1C1C19"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Meta-Prompt -->
            <TabItem Header="📄 Meta-Prompt Generado">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Información extraída de la vista activa para el modelo de lenguaje / notebook:" FontSize="11" Foreground="#72777F" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtPromptPreview" Grid.Row="1" Style="{StaticResource DarkTextBoxStyle}"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                </Grid>
            </TabItem>

            <!-- Tab 2: JSON Response -->
            <TabItem Header="⚡ JSON de Respuesta IA">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="JSON estructurado de la IA con las acciones paramétricas y recomendaciones:" FontSize="11" Foreground="#72777F" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtJsonResponse" Grid.Row="1" Style="{StaticResource DarkTextBoxStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                </Grid>
            </TabItem>

            <!-- Tab 3: Reporte Constructivo -->
            <TabItem Header="📋 Recomendaciones Constructivas">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <Border Background="#F6F3EE" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="SÍNTESIS DE LA SOLUCIÓN" FontWeight="Bold" FontSize="12" Foreground="#0F4369" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtReportSummary" Text="No se ha ejecutado ninguna evaluación todavía." TextWrapping="Wrap" FontSize="11" Foreground="#1C1C19"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F6F3EE" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ESTRATEGIA TÉRMICA &amp; PUENTES TÉRMICOS" FontWeight="Bold" FontSize="12" Foreground="#0F4369" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtReportThermal" Text="Pendiente de análisis." TextWrapping="Wrap" FontSize="11" Foreground="#1C1C19"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F6F3EE" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ESTANQUEIDAD AL AGUA &amp; GOTERONES" FontWeight="Bold" FontSize="12" Foreground="#0F4369" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtReportWaterproofing" Text="Pendiente de análisis." TextWrapping="Wrap" FontSize="11" Foreground="#1C1C19"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F6F3EE" BorderBrush="#BA1A1A" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="ALERTAS DE CONSTRUCTIBILIDAD EN OBRA" FontWeight="Bold" FontSize="12" Foreground="#BA1A1A" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtReportWarnings" Text="Sin alertas." TextWrapping="Wrap" FontSize="11" Foreground="#1C1C19"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer / Botonera -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnIngestCad" Grid.Column="0" Content="📥 Importar CAD a 3D Base" Style="{StaticResource SecondaryButtonStyle}" Click="BtnIngestCad_Click"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGeneratePrompt" Content="1. Analizar Vista &amp; Crear Prompt" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="BtnGeneratePrompt_Click"/>
                <Button x:Name="BtnApply" Content="2. Confirmar &amp; Ejecutar en Revit" Style="{StaticResource SuccessButtonStyle}" Click="BtnApply_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
