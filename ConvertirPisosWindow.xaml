<Window x:Class="RevitToSupabasePlugin.ConvertirPisosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instanciador y Despiece Profesional de Enchapes (Face-Based) | ARCA REVIEW" 
        Height="820" Width="1300" 
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen" 
        Background="#FCF9F4"
        Foreground="#1C1C19"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#1C1C19"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="#0F4369"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="#FFFFFF" Margin="0,8,0,0"/>
                            <Border Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FCF9F4" Padding="6,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1E4F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <ControlTemplate x:Key="PisosComboToggle" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="#FFFFFF" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#0F4369"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#0F4369"/>
                    <Setter TargetName="ToggleBorder" Property="Background" Value="#F6F3EE"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#1C1C19"/>
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#D1E4F9"/>
                                            <Setter Property="Foreground" Value="#0F4369"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0F4369"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource PisosComboToggle}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,24,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1C1C19"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="220">
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#1C1C19"
                                            BorderThickness="1"
                                            Margin="0,1,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" Color="#1C1C19" Opacity="0.15"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" MinWidth="370"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Columna Izquierda: Formulario de Parámetros -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="4" Padding="12" BorderBrush="#1C1C19" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header de Selección -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="📐 Despiece de Enchapes (Face-Based)" FontSize="16" FontWeight="Bold" Foreground="#0F4369"/>
                    <TextBlock x:Name="txtFloorSummary" Text="Anfitriones seleccionados: 1 elemento" FontSize="11" Foreground="#1C1C19" Margin="0,2,0,0"/>
                    <TextBlock x:Name="txtFloorDimensions" Text="Área: 0.00 m² | Longitud: 0.00 m" FontSize="10" Foreground="#72777F" Margin="0,2,0,0"/>
                    <TextBlock x:Name="txtLayerNotice" Text="💡 Capas del muro/piso leídas automáticamente" FontSize="10" Foreground="#137333" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Formulario de Configuración -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,4,0">

                        <!-- SECCIÓN 1: FAMILIA FACE-BASED (TILES BASE) -->
                        <GroupBox Header="1. Familia de Baldosas (Face-Based: Tiles Base)">
                            <StackPanel>
                                <TextBlock Text="Tipo / Familia de Baldosa:" FontSize="11" Foreground="#A0AEC0"/>
                                <ComboBox x:Name="cmbTileType" SelectionChanged="cmbTileType_SelectionChanged"/>

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                        <TextBlock Text="Largo (cm):" FontSize="10" Foreground="#718096"/>
                                        <TextBox x:Name="txtTileLength" Text="60.0" TextChanged="TileParam_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                        <TextBlock Text="Ancho (cm):" FontSize="10" Foreground="#718096"/>
                                        <TextBox x:Name="txtTileWidth" Text="60.0" TextChanged="TileParam_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="2,0,0,0">
                                        <TextBlock Text="Espesor (cm):" FontSize="10" Foreground="#718096"/>
                                        <TextBox x:Name="txtTileThick" Text="1.0" TextChanged="TileParam_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Material de la Baldosa:" FontSize="11" Foreground="#A0AEC0" Margin="0,4,0,0"/>
                                <ComboBox x:Name="cmbTileMaterial" DisplayMemberPath="Name" SelectionChanged="ParamControl_Changed"/>

                                <!-- Motor Exclusivo de Familias Cargables en Revit -->
                                <Border Background="#101419" CornerRadius="4" Padding="6" Margin="0,6,0,0" BorderBrush="#2D3748" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Motor Exclusivo de Familias Cargables (.RFA):" FontSize="10" FontWeight="Bold" Foreground="#48BB78" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Baldosas: Tiles Base.rfa desde (0,0) con Cut Lat y Cut Top paramétricos." FontSize="9" Foreground="#A0AEC0" Margin="4,0,0,1"/>
                                        <TextBlock Text="• Juntas: Base Tiles Pega.rfa (horizontales continuas en Span Direction + subobjetos verticales sin solape)." FontSize="9" Foreground="#A0AEC0" Margin="4,0,0,1"/>
                                        <TextBlock Text="• Zócalo: Familia cargable perimetral desde el (0,0) con longitud y perfil." FontSize="9" Foreground="#A0AEC0" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- SECCIÓN 2: CAPAS A MODELAR (MORTERO, PEGA, BALDOSAS, JUNTAS) -->
                        <GroupBox Header="2. Capas Constructivas (Reemplazo de Torta de Suelo)">
                            <StackPanel>
                                <!-- Panel de Absorción Automática de Espesor -->
                                <Border Background="#1C2128" CornerRadius="6" Padding="8" Margin="0,0,0,8" BorderBrush="#3182CE" BorderThickness="1">
                                    <StackPanel>
                                        <CheckBox x:Name="chkAutoAbsorbFloorThickness" Content="Absorber espesor total del suelo en Mortero" IsChecked="True" Checked="AutoAbsorb_Changed" Unchecked="AutoAbsorb_Changed" FontWeight="Bold" Foreground="#63B3ED"/>
                                        <TextBlock x:Name="txtStratigraphyBreakdown" Text="Estratigrafía: Top Enchape en N.P.T. | Mortero: 8.5 cm | Pega: 5 mm | Baldosa: 1.0 cm (Total: 10.0 cm)" FontSize="10" Foreground="#A0AEC0" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        <CheckBox x:Name="chkDeleteOriginalFloor" Content="Eliminar suelo original tras crear el despiece (Reemplazo total)" IsChecked="False" Margin="0,4,0,0" FontSize="11" Foreground="#FEB2B2"/>
                                    </StackPanel>
                                </Border>

                                <!-- Capa 1: Mortero / Contrapiso / Revoque Base -->
                                <Border Background="#15171A" CornerRadius="6" Padding="8" Margin="0,0,0,6" BorderBrush="#2D3748" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" x:Name="chkModelRevoque" Content="☑ Modelar Mortero de Nivel / Solado" IsChecked="True" Checked="ParamControl_Changed" Unchecked="ParamControl_Changed" FontWeight="SemiBold"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBox x:Name="txtRevoqueThickCm" Text="3.0" Width="45" TextChanged="RevoqueParam_Changed"/>
                                                <TextBlock Text=" cm" VerticalAlignment="Center" FontSize="10" Foreground="#A0AEC0"/>
                                            </StackPanel>
                                        </Grid>
                                        <ComboBox x:Name="cmbRevoqueMaterial" DisplayMemberPath="Name" Margin="0,4,0,0" SelectionChanged="ParamControl_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Capa 2: Cama de Pega / Adhesivo -->
                                <Border Background="#15171A" CornerRadius="6" Padding="8" Margin="0,0,0,6" BorderBrush="#2D3748" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" x:Name="chkModelBeddingMortar" Content="☑ Modelar Pega / Adhesivo" IsChecked="True" Checked="ParamControl_Changed" Unchecked="ParamControl_Changed" FontWeight="SemiBold"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBox x:Name="txtBeddingThickMm" Text="5.0" Width="45" TextChanged="BeddingParam_Changed"/>
                                                <TextBlock Text=" mm" VerticalAlignment="Center" FontSize="10" Foreground="#A0AEC0"/>
                                            </StackPanel>
                                        </Grid>
                                        <ComboBox x:Name="cmbBeddingMaterial" DisplayMemberPath="Name" Margin="0,4,0,0" SelectionChanged="ParamControl_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Capa 3: Baldosas / Piezas (Tiles) -->
                                <Border Background="#15171A" CornerRadius="6" Padding="8" Margin="0,0,0,6" BorderBrush="#2D3748" BorderThickness="1">
                                    <CheckBox x:Name="chkModelTiles" Content="☑ Modelar Baldosas / Tiles (Tiles Base)" IsChecked="True" Checked="ParamControl_Changed" Unchecked="ParamControl_Changed" FontWeight="SemiBold" Foreground="#63B3ED"/>
                                </Border>

                                <!-- Capa 4: Juntas / Fragua 3D (Perimetral 5mm e Interior 3-4mm con Base Tiles Pega.rfa) -->
                                <Border Background="#15171A" CornerRadius="6" Padding="8" BorderBrush="#2D3748" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" x:Name="chkGenerateJointMesh" Content="☑ Modelar Juntas (Base Tiles Pega.rfa)" IsChecked="True" Checked="ParamControl_Changed" Unchecked="ParamControl_Changed" FontWeight="SemiBold"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBox x:Name="txtJointInner" Text="3.0" Width="45" TextChanged="ParamControl_Changed"/>
                                                <TextBlock Text=" mm" VerticalAlignment="Center" FontSize="10" Foreground="#A0AEC0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                <TextBlock Text="Junta Perímetro (mm):" FontSize="10" Foreground="#A0AEC0"/>
                                                <TextBox x:Name="txtJointPerimeter" Text="5.0" TextChanged="ParamControl_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                                <TextBlock Text="Material Junta Interna:" FontSize="10" Foreground="#A0AEC0"/>
                                                <ComboBox x:Name="cmbGroutMaterial" DisplayMemberPath="Name" SelectionChanged="ParamControl_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,4,0,0">
                                            <TextBlock Text="Material / Perfil Junta Perimetral (5mm):" FontSize="10" Foreground="#A0AEC0"/>
                                            <ComboBox x:Name="cmbPerimeterJointMaterial" DisplayMemberPath="Name" SelectionChanged="ParamControl_Changed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- SECCIÓN 3: PARÁMETROS ESPECÍFICOS DE MURO (SI APLICA) -->
                        <GroupBox x:Name="grpWallParams" Header="3. Parámetros de Enchape en Muro">
                            <StackPanel>
                                <CheckBox x:Name="chkFullWallHeight" Content="Enchapar Altura Total del Muro" IsChecked="True" Checked="WallParam_Changed" Unchecked="WallParam_Changed"/>
                                
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Altura Enchape (cm):" FontSize="10" Foreground="#A0AEC0"/>
                                        <TextBox x:Name="txtCustomWallHeight" Text="210.0" IsEnabled="False" TextChanged="ParamControl_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Desfase Inferior (cm):" FontSize="10" Foreground="#A0AEC0"/>
                                        <TextBox x:Name="txtWallBaseOffset" Text="0.0" TextChanged="ParamControl_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- SECCIÓN 4: PATRÓN Y ALINEACIÓN -->
                        <GroupBox Header="4. Patrón de Aparejo y Orientación (Span Direction)">
                            <StackPanel>
                                <TextBlock Text="Patrón de Colocación:" FontSize="11" Foreground="#A0AEC0"/>
                                <ComboBox x:Name="cmbPattern" SelectionChanged="ParamControl_Changed">
                                    <ComboBoxItem Content="Ortogonal / Retícula Cuadriculada (Grid)" Tag="OrthogonalGrid" IsSelected="True"/>
                                    <ComboBoxItem Content="Arquitrabado / Traba al 50% (Matajuntas)" Tag="RunningBond50"/>
                                    <ComboBoxItem Content="Arquitrabado / Traba a 1/3 (Tercio)" Tag="ThirdBond33"/>
                                    <ComboBoxItem Content="Espina de Pez 90° (Herringbone)" Tag="Herringbone90"/>
                                    <ComboBoxItem Content="Espina de Pez 45° (Herringbone)" Tag="Herringbone45"/>
                                    <ComboBoxItem Content="Diagonal 45° (Damero / Diamante)" Tag="Diagonal45"/>
                                    <ComboBoxItem Content="Modular / Molinillo (Basketweave)" Tag="Basketweave"/>
                                </ComboBox>

                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Origen Cartesiano del Piso:" FontSize="11" Foreground="#A0AEC0"/>
                                        <ComboBox x:Name="cmbOrigin" SelectionChanged="ParamControl_Changed">
                                            <ComboBoxItem Content="Centro de Superficie"/>
                                            <ComboBoxItem Content="Plano Cartesiano (0,0) [AutoCAD]" IsSelected="True"/>
                                            <ComboBoxItem Content="Esquina Superior Derecha"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Rotación (°):" FontSize="11" Foreground="#A0AEC0"/>
                                        <TextBox x:Name="txtRotation" Text="0.0" TextChanged="ParamControl_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Desfase X / U (cm):" FontSize="11" Foreground="#A0AEC0"/>
                                        <TextBox x:Name="txtOffsetX" Text="0.0" TextChanged="ParamControl_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Desfase Y / V (cm):" FontSize="11" Foreground="#A0AEC0"/>
                                        <TextBox x:Name="txtOffsetY" Text="0.0" TextChanged="ParamControl_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- SECCIÓN 5: ZÓCALO / RODAPIÉ (SOBRE PISO) -->
                        <GroupBox x:Name="grpSkirting" Header="5. Zócalo / Rodapié (Apoyado sobre Piso)">
                            <StackPanel>
                                <CheckBox x:Name="chkEnableSkirting" Content="Generar Zócalo Perimetral (Sweep)" IsChecked="False" Checked="ParamControl_Changed" Unchecked="ParamControl_Changed" FontWeight="Bold" Foreground="#63B3ED"/>

                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                        <TextBlock Text="Altura (cm):" FontSize="10" Foreground="#A0AEC0"/>
                                        <TextBox x:Name="txtSkirtingHeight" Text="8.0" TextChanged="ParamControl_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                        <TextBlock Text="Espesor (cm):" FontSize="10" Foreground="#A0AEC0"/>
                                        <TextBox x:Name="txtSkirtingThickness" Text="1.2" TextChanged="ParamControl_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="2,0,0,0">
                                        <TextBlock Text="Bisel (mm):" FontSize="10" Foreground="#A0AEC0"/>
                                        <TextBox x:Name="txtSkirtingBevel" Text="1.5" TextChanged="ParamControl_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Material del Zócalo:" FontSize="11" Foreground="#A0AEC0"/>
                                <ComboBox x:Name="cmbSkirtingMaterial" DisplayMemberPath="Name" SelectionChanged="ParamControl_Changed"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- SECCIÓN 6: CATEGORÍA DE REVIT PARA ELEMENTOS -->
                        <GroupBox Header="6. Categoría de Revit Asignada">
                            <StackPanel>
                                <TextBlock Text="Categoría de Sistema:" FontSize="11" Foreground="#A0AEC0"/>
                                <ComboBox x:Name="cmbTargetCategory" Margin="0,4,0,0">
                                    <ComboBoxItem Content="🪜 Suelos / Pisos (OST_Floors) [Recomendado]" Tag="OST_Floors" IsSelected="True"/>
                                    <ComboBoxItem Content="🧱 Muros (OST_Walls) [Para Enchapes Verticales]" Tag="OST_Walls"/>
                                    <ComboBoxItem Content="📦 Modelos Genéricos (OST_GenericModel)" Tag="OST_GenericModel"/>
                                </ComboBox>
                                <TextBlock Text="Al seleccionar Suelos (OST_Floors), las piezas aparecen en Tablas de Suelos y heredan sus propiedades." FontSize="10" Foreground="#63B3ED" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- SECCIÓN 7: CÓMPUTO INSTANTÁNEO -->
                        <GroupBox Header="7. Métricas y Cómputos Rápidos">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                    <TextBlock Text="Piezas Completas:" FontSize="10" Foreground="#718096"/>
                                    <TextBlock x:Name="lblFullTiles" Text="0 pzas" FontSize="12" FontWeight="Bold" Foreground="#48BB78"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                    <TextBlock Text="Piezas Cortadas:" FontSize="10" Foreground="#718096"/>
                                    <TextBlock x:Name="lblCutTiles" Text="0 pzas" FontSize="12" FontWeight="Bold" Foreground="#ED8936"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,4,4">
                                    <TextBlock Text="Área Requerida (+% Desp):" FontSize="10" Foreground="#718096"/>
                                    <TextBlock x:Name="lblTotalAreaWaste" Text="0.00 m² (0%)" FontSize="12" FontWeight="Bold" Foreground="#63B3ED"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,4,0,4">
                                    <TextBlock Text="Metros Lin. Zócalo:" FontSize="10" Foreground="#718096"/>
                                    <TextBlock x:Name="lblSkirtingLinearM" Text="0.00 ml" FontSize="12" FontWeight="Bold" Foreground="#ECC94B"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4,4,0">
                                    <TextBlock Text="Longitud Juntas:" FontSize="10" Foreground="#718096"/>
                                    <TextBlock x:Name="lblJointTotalM" Text="0.00 m" FontSize="11" Foreground="#A0AEC0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,4,0,0">
                                    <TextBlock Text="Costo Estimado Material:" FontSize="10" Foreground="#718096"/>
                                    <TextBlock x:Name="lblEstimatedCost" Text="$ 0.00" FontSize="12" FontWeight="Bold" Foreground="#38A169"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <!-- Botón de Construcción -->
                <Button Grid.Row="2" Content="🚀 Generar Enchapes y Capas en Revit" Click="btnGenerateRevit_Click" Background="#0F4369" Foreground="#FFFFFF" BorderBrush="#0F4369" FontWeight="Bold" FontSize="13" Padding="12,12" Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- Divisor -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Columna Derecha: Viewport 3D y Leyenda -->
        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="4" Padding="12" BorderBrush="#1C1C19" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior con Controles y Leyenda -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="🧊 Vista 3D del Enchape" FontSize="15" FontWeight="Bold" Foreground="#63B3ED" VerticalAlignment="Center"/>
                        <TextBlock Text=" (Clic y arrastra para orbitar • Rueda para zoom)" FontSize="10" Foreground="#718096" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="🔄 Vista Frontal" Click="btnTopView_Click" Padding="8,4" Margin="0,0,6,0" FontSize="11" Background="#2B2D31"/>
                        <Button Content="📐 Vista Isométrica" Click="btnIsoView_Click" Padding="8,4" FontSize="11" Background="#2B2D31"/>
                    </StackPanel>
                </Grid>

                <!-- Viewport 3D -->
                <Border Grid.Row="1" Background="#0C0D10" CornerRadius="8" ClipToBounds="True" BorderBrush="#2D3748" BorderThickness="1">
                    <Viewport3D x:Name="viewport3D" MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="camera" Position="200,200,200" LookDirection="-200,-200,-200" UpDirection="0,0,1" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="modelGroup">
                                    <AmbientLight Color="#606060"/>
                                    <DirectionalLight Color="#FFFFFF" Direction="-1,-2,-3"/>
                                    <DirectionalLight Color="#707080" Direction="2,1,1"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>
                </Border>

                <!-- Leyenda de Colores Inferior -->
                <Border Grid.Row="2" Background="#15171A" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" BorderBrush="#2D3748" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="#A0AEC0" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Revoque" FontSize="10" Foreground="#E2E8F0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="#718096" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Cama Pega" FontSize="10" Foreground="#E2E8F0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="#319795" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Baldosa" FontSize="10" Foreground="#E2E8F0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="#DD6B20" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Corte" FontSize="10" Foreground="#E2E8F0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="#4A5568" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Fragua 3D" FontSize="10" Foreground="#E2E8F0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="#805AD5" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Zócalo" FontSize="10" Foreground="#E2E8F0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
