<Window x:Class="RevitToSupabasePlugin.ConfiguradorIAPlantillaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurador IA de Plantillas"
        Width="780" Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#1A1A2E">

    <Window.Resources>
        <!-- Button styles -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"  Value="#4F8EF7"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Padding"     Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6BA3FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A73D4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2D4A7A"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#00B48E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00D4AA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#4F8EF7"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4F8EF7"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A3A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background"   Value="#0F3460"/>
            <Setter Property="Foreground"   Value="#E2E8F0"/>
            <Setter Property="BorderBrush"  Value="#2D4A7A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="10,6"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="CaretBrush"   Value="#4F8EF7"/>
        </Style>

        <!-- PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background"   Value="#0F3460"/>
            <Setter Property="Foreground"   Value="#E2E8F0"/>
            <Setter Property="BorderBrush"  Value="#2D4A7A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="10,6"/>
            <Setter Property="FontSize"     Value="13"/>
        </Style>

        <!-- TextBlock default -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#E2E8F0"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="0" Background="#16213E" BorderBrush="#2D4A7A" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧠" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Configurador IA de Plantillas" FontSize="16" FontWeight="Bold" Foreground="#4F8EF7"/>
                        <TextBlock Text="Conecta tu DB · Genera un prompt · Aplica el JSON de la IA" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="BadgeAuth" Grid.Column="1" Background="#1E4620" CornerRadius="12"
                        Padding="10,4" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="TxtBadgeAuth" Text="✓ Conectado" Foreground="#00D4AA" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══ TABS ══ -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontSize"   Value="12"/>
                    <Setter Property="Padding"    Value="14,10"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#4F8EF7"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- ─ PASO 1: LOGIN ─ -->
            <TabItem Header="① Login" x:Name="TabLogin">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel Margin="30,20">
                        <TextBlock Text="Autenticación con Supabase" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Ingresa tus credenciales para conectarte a la base de datos del proyecto."
                                   Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Background="#16213E" CornerRadius="10" Padding="24" BorderBrush="#2D4A7A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Email" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtEmail" Margin="0,0,0,12"/>
                                <TextBlock Text="Contraseña" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="TxtPassword" Margin="0,0,0,14"/>
                                <Button x:Name="BtnLogin" Content="🔐  Conectar a Supabase"
                                        Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left"
                                        Click="BtnLogin_Click"/>
                                <TextBlock x:Name="TxtLoginStatus" Text="" Foreground="#F87171"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0D1B2A" CornerRadius="8" Padding="16"
                                BorderBrush="#1E3A5F" BorderThickness="1" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="¿Cómo funciona?" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#4F8EF7" Margin="0,0,0,6"/>
                                <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap">
                                    ① Login  →  ② Selecciona tablas  →  ③ Copia el mega-prompt  →  ④ Pega el JSON y aplica
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─ PASO 2: PROYECTO ─ -->
            <TabItem Header="② Proyecto" x:Name="TabProyecto" IsEnabled="False">
                <StackPanel Margin="30,20">
                    <TextBlock Text="Selecciona tu Proyecto" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Elige el proyecto sobre el cual deseas generar la configuración."
                               Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                        <WrapPanel x:Name="PanelProjectCards" Orientation="Horizontal" Margin="0,0,0,10"/>
                    </ScrollViewer>
                </StackPanel>
            </TabItem>

            <!-- ─ PASO 3: TABLAS ─ -->
            <TabItem Header="③ Tablas DB" x:Name="TabTablas" IsEnabled="False">
                <Grid Margin="30,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Selecciona las tablas a incluir en el prompt"
                                   FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Los datos de estas tablas se incluirán como contexto para la IA."
                                   Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="✓ Todas"  Style="{StaticResource GhostBtn}" Click="BtnSelAll_Click"  Margin="0,0,8,0"/>
                        <Button Content="✗ Ninguna" Style="{StaticResource GhostBtn}" Click="BtnSelNone_Click"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#16213E" CornerRadius="10" Padding="16"
                            BorderBrush="#2D4A7A" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="PanelTablas" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="3" x:Name="BtnFetchAndCopy" Margin="0,14,0,0"
                            Content="⬇  Cargar datos y continuar al Prompt"
                            Style="{StaticResource PrimaryBtn}"
                            HorizontalAlignment="Left"
                            Click="BtnFetchAndCopy_Click"/>
                </Grid>
            </TabItem>

            <!-- ─ PASO 4: MEGA-PROMPT ─ -->
            <TabItem Header="④ Mega-Prompt" x:Name="TabPrompt" IsEnabled="False">
                <Grid Margin="30,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Prompt generado para la IA"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Background="#16213E" CornerRadius="8" Padding="14"
                            BorderBrush="#2D4A7A" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Datos del modelo Revit a incluir:"
                                       FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkRevitInfo"      Content="Información del Proyecto" IsChecked="True" Margin="0,0,20,4"/>
                                <CheckBox x:Name="ChkRevitLevels"    Content="Niveles"                  IsChecked="True" Margin="0,0,20,4"/>
                                <CheckBox x:Name="ChkRevitMaterials" Content="Materiales"               IsChecked="True" Margin="0,0,20,4"/>
                                <CheckBox x:Name="ChkRevitSchedules" Content="Schedules"                IsChecked="True" Margin="0,0,20,4"/>
                                <CheckBox x:Name="ChkRevitViews"     Content="Vistas y Planos"          IsChecked="True" Margin="0,0,20,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBox Grid.Row="2" x:Name="TxtPrompt"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#0A1628" FontFamily="Consolas"
                             FontSize="11" Foreground="#B8C9E0"
                             BorderBrush="#2D4A7A" Padding="12"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnGeneratePrompt" Content="🔄 Regenerar" Style="{StaticResource GhostBtn}"
                                Click="BtnGeneratePrompt_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnCopyPrompt"     Content="📋 Copiar al portapapeles" Style="{StaticResource GreenBtn}"
                                Click="BtnCopyPrompt_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ─ PASO 5: APLICAR JSON ─ -->
            <TabItem Header="⑤ Aplicar JSON" x:Name="TabApply" IsEnabled="False">
                <Grid Margin="30,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Pega el JSON que te devolvió la IA"
                                   FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Copia la respuesta JSON de tu IA (Gemini, GPT, Claude) y pégala aquí. El plugin la aplicará sobre tu plantilla Revit."
                                   Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="📄 JSON de ejemplo" Style="{StaticResource GhostBtn}" Click="BtnInsertExample_Click" Margin="0,0,8,0"/>
                        <Button Content="🗑 Limpiar"          Style="{StaticResource GhostBtn}" Click="BtnClearJson_Click"/>
                    </StackPanel>

                    <TextBox Grid.Row="2" x:Name="TxtJsonInput"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             Background="#0A1628" FontFamily="Consolas"
                             FontSize="11" Foreground="#B8C9E0"
                             BorderBrush="#2D4A7A" Padding="12"/>

                    <Button Grid.Row="3" x:Name="BtnApplyJson"
                            Content="🚀  Aplicar a la Plantilla Revit"
                            Style="{StaticResource GreenBtn}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0" Padding="20,10" FontSize="14"
                            Click="BtnApplyJson_Click"/>

                    <Border Grid.Row="4" x:Name="BorderLog"
                            Background="#0A1628" CornerRadius="8"
                            BorderBrush="#2D4A7A" BorderThickness="1"
                            Margin="0,12,0,0" Padding="12" Visibility="Collapsed" MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="11"
                                       Foreground="#B8C9E0" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ══ STATUS BAR ══ -->
        <Border Grid.Row="2" Background="#16213E" BorderBrush="#2D4A7A" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="TxtStatus"
                           Text="Listo — ingresa tus credenciales para comenzar."
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtLoadingDots" Text="" Foreground="#4F8EF7"
                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
