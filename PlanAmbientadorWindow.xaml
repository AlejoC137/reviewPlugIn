<Window x:Class="RevitToSupabasePlugin.PlanAmbientadorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎨 PLAN AMBIENTADOR - Alto Nivel Arquitectónico | ARCA REVIEW"
        Height="820" Width="980"
        MinHeight="700" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#181825"
        Foreground="#CDD6F4">

    <Window.Resources>
        <!-- Estilo Botón Principal -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B4BEFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Secundario -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Checkbox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Estilo Card/Panel -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Info Vista Activa -->
            <RowDefinition Height="*"/>    <!-- 2: Contenido Scrollable -->
            <RowDefinition Height="Auto"/> <!-- 3: Barra de Acciones y Estado -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎨 PLAN AMBIENTADOR" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                        <Border Background="#313244" CornerRadius="6" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ALTO NIVEL ARQUITECTÓNICO" FontSize="10" FontWeight="Bold" Foreground="#A6E3A1"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Automatización gráfica, acotado profesional, estandarización de recintos y post-producción de plantas para presentación y concurso." 
                               FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ARCA REVIEW" FontSize="11" FontWeight="Bold" Foreground="#6C7086" HorizontalAlignment="Right"/>
                    <TextBlock Text="Revit 2027 Ready" FontSize="10" Foreground="#585B70" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- INFO VISTA ACTIVA -->
        <Border Grid.Row="1" Background="#24273A" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" BorderBrush="#363A4F" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📍 Vista Activa:" FontWeight="Bold" Foreground="#F9E2AF" Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtViewName" Text="Cargando..." FontWeight="SemiBold" Foreground="#CDD6F4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Escala:" Foreground="#A6ADC8" Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtViewScale" Text="1:50" FontWeight="SemiBold" Foreground="#89B4FA" Margin="0,0,16,0"/>
                    <TextBlock Text="Nivel:" Foreground="#A6ADC8" Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtViewLevel" Text="Nivel 1" FontWeight="SemiBold" Foreground="#A6E3A1"/>
                </StackPanel>
                <Button Grid.Column="2" Content="🔄 Refrescar Vista" Click="BtnRefreshView_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4"/>
            </Grid>
        </Border>

        <!-- CONTENIDO SCROLLABLE DE CONFIGURACIÓN -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA: GRÁFICOS Y AMBIENTACIÓN -->
                    <StackPanel Grid.Column="0">
                        <!-- PANEL 1: ESTILO GRÁFICO & VALORACIÓN -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🖌️ 1. Estilo Gráfico &amp; Jerarquía de Muros" FontSize="14" FontWeight="Bold" Foreground="#89B4FA"/>
                                </StackPanel>
                                <TextBlock Text="Aplica la valoración de línea de concurso a los elementos cortados." FontSize="11" Foreground="#9399B2" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox x:Name="chkMurosSolidos" IsChecked="True" Content="Muros en Corte Sólido (Gris Grafito / Negro #222222)"/>
                                <CheckBox x:Name="chkColumnasSolidas" IsChecked="True" Content="Columnas y Estructuras en Corte de Alto Contraste"/>
                                <CheckBox x:Name="chkAntepechos" IsChecked="True" Content="Muros Bajos y Antepechos en Línea Media (Sin relleno)"/>
                                
                                <Border Background="#181825" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tono de Muros:" VerticalAlignment="Center" Foreground="#A6ADC8" FontSize="11"/>
                                        <ComboBox x:Name="cmbWallColor" Grid.Column="1" Margin="8,0,0,0" Background="#313244" Foreground="#CDD6F4" SelectedIndex="0">
                                            <ComboBoxItem Content="Gris Grafito Minimalista (#2A2A2E)"/>
                                            <ComboBoxItem Content="Negro Tinta Puro (#000000)"/>
                                            <ComboBoxItem Content="Gris Cálido Arquitectónico (#3E3B3A)"/>
                                            <ComboBoxItem Content="Gris Claro Técnico (#555555)"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- PANEL 2: ILUMINACIÓN & SOMBRAS -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="☀️ 2. Sombras Ambientales &amp; Profundidad" FontSize="14" FontWeight="Bold" Foreground="#F9E2AF"/>
                                </StackPanel>
                                <TextBlock Text="Aporta tridimensionalidad sin saturar ni oscurecer la lectura técnica." FontSize="11" Foreground="#9399B2" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox x:Name="chkAmbientShadows" IsChecked="True" Content="Activar Sombras Ambientales Suaves (Ambient Shadows)"/>
                                <CheckBox x:Name="chkCastShadows" IsChecked="True" Content="Activar Sombras Arrojadas Calibradas (Sol a 45°, 20% intensidad)"/>
                                <CheckBox x:Name="chkAntiAliasing" IsChecked="True" Content="Líneas Suavizadas con Anti-Aliasing"/>
                                <CheckBox x:Name="chkCleanCAD" IsChecked="True" Content="Ocultar importaciones CAD, Planos de Ref. y Parásitos"/>
                            </StackPanel>
                        </Border>

                        <!-- PANEL 3: MOBILIARIO Y PAVIMENTOS -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🛋️ 3. Mobiliario, Aparatos &amp; Tramas de Suelo" FontSize="14" FontWeight="Bold" Foreground="#CBA6F7"/>
                                </StackPanel>
                                <TextBlock Text="Evita que los muebles y los pisos compitan visualmente con los muros." FontSize="11" Foreground="#9399B2" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox x:Name="chkHalftoneFurniture" IsChecked="True" Content="Mobiliario y Clósets en Halftone / Gris Sutil"/>
                                <CheckBox x:Name="chkHalftonePlumbing" IsChecked="True" Content="Aparatos Sanitarios y Cocina en Línea Atenuada"/>
                                <CheckBox x:Name="chkSoftFloors" IsChecked="True" Content="Suavizar Tramas de Pisos / Suelos (Gris Claro #B0B0B0)"/>
                                <CheckBox x:Name="chkSoftPlanting" IsChecked="True" Content="Vegetación y Árboles en Línea Fina y Esquemática"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- COLUMNA DERECHA: ROOMS Y ACOTADO -->
                    <StackPanel Grid.Column="2">
                        <!-- PANEL 4: ROOMS, ETIQUETAS & ESPACIOS -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🏷️ 4. Recintos, Nombres &amp; Zonificación" FontSize="14" FontWeight="Bold" Foreground="#A6E3A1"/>
                                </StackPanel>
                                <TextBlock Text="Identificación clara del programa arquitectónico con m² y niveles." FontSize="11" Foreground="#9399B2" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox x:Name="chkAutoCreateRooms" IsChecked="True" Content="Detectar y Crear Rooms en espacios cerrados vacíos"/>
                                <CheckBox x:Name="chkRoomTags" IsChecked="True" Content="Colocar Room Tags con Nombre, Área (m²) y N.P.T."/>
                                <CheckBox x:Name="chkUppercaseRooms" IsChecked="True" Content="Normalizar nombres a MAYÚSCULAS (ej. COCINA, ESTAR)"/>
                                
                                <Border Background="#181825" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Esquema Color:" VerticalAlignment="Center" Foreground="#A6ADC8" FontSize="11"/>
                                        <ComboBox x:Name="cmbColorScheme" Grid.Column="1" Margin="8,0,0,0" Background="#313244" Foreground="#CDD6F4" SelectedIndex="0">
                                            <ComboBoxItem Content="Ninguno (Plano Blanco Puro Técnico)"/>
                                            <ComboBoxItem Content="Zonificación Pastel Suave (Social, Privada, Húmeda)"/>
                                            <ComboBoxItem Content="Monocromático Arquitectónico (Gama de Grises)"/>
                                            <ComboBoxItem Content="Cálido / Tierra (Maderas y Texturas)"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- PANEL 5: ACOTADO JERARQUIZADO -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="📏 5. Acotado Arquitectónico Inteligente" FontSize="14" FontWeight="Bold" Foreground="#FAB387"/>
                                </StackPanel>
                                <TextBlock Text="Cadenas de cotas perimetrales e interiores alineadas y legibles." FontSize="11" Foreground="#9399B2" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox x:Name="chkCotaTotal" IsChecked="True" Content="Cadena 1: Cota Total Exterior (Largo y Ancho Máximo)"/>
                                <CheckBox x:Name="chkCotaEjes" IsChecked="True" Content="Cadena 2: Cota entre Ejes Estructurales (Grids)"/>
                                <CheckBox x:Name="chkCotaVanos" IsChecked="True" Content="Cadena 3: Cota de Vanos de Fachada (Puertas y Ventanas)"/>
                                <CheckBox x:Name="chkCotasInteriores" IsChecked="True" Content="Cotas Libres Interiores por Recinto (Ancho y Largo útil)"/>
                                
                                <Border Background="#181825" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Estilo de Cota:" VerticalAlignment="Center" Foreground="#A6ADC8" FontSize="11"/>
                                        <ComboBox x:Name="cmbDimStyle" Grid.Column="1" Margin="8,0,0,0" Background="#313244" Foreground="#CDD6F4" SelectedIndex="0">
                                            <ComboBoxItem Content="Diagonal Arquitectónica Fina (1.5 mm Tick)"/>
                                            <ComboBoxItem Content="Punto Arquitectónico Minimalista (Dot)"/>
                                            <ComboBoxItem Content="Línea Continua Fina Estándar"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- PANEL 6: ANOTACIONES Y DETALLES -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="📐 6. Simbología &amp; Anotaciones Complementarias" FontSize="14" FontWeight="Bold" Foreground="#F38BA8"/>
                                </StackPanel>
                                <TextBlock Text="Elementos de orientación, niveles y circulación vertical." FontSize="11" Foreground="#9399B2" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox x:Name="chkNptSpots" IsChecked="True" Content="Cotas de Nivel (N.P.T.) en Accesos, Terrazas y Zonas Húmedas"/>
                                <CheckBox x:Name="chkEscaleras" IsChecked="True" Content="Numeración de Peldaños y Flecha de Sentido en Escaleras"/>
                                <CheckBox x:Name="chkAccesoPrincipal" IsChecked="True" Content="Flecha de Ingreso / Acceso Principal Arquitectónico"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- BARRA INFERIOR: ACCIONES Y LOG -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CONSOLA / ESTADO -->
            <Border Grid.Row="0" Background="#11111B" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" BorderBrush="#313244" BorderThickness="1">
                <TextBlock x:Name="txtStatus" Text="Listo para ambientar la vista activa. Selecciona las opciones deseadas y pulsa 'Ambientar Planta Actual'." 
                           FontSize="11" Foreground="#A6ADC8" TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- BOTONES DE ACCIÓN -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button x:Name="btnAmbientarTodo" Content="🚀 Ambientar Planta Actual (1-Clic)" Click="BtnAmbientarTodo_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="btnSoloEstilo" Content="🎨 Solo Estilo Gráfico" Click="BtnSoloEstilo_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button x:Name="btnSoloRooms" Content="🏷️ Solo Rooms &amp; Tags" Click="BtnSoloRooms_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button x:Name="btnSoloCotas" Content="📏 Solo Cotas" Click="BtnSoloCotas_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                </WrapPanel>

                <Button Grid.Column="1" Content="Cerrar" Click="BtnCerrar_Click" Style="{StaticResource SecondaryButtonStyle}" Width="90"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
