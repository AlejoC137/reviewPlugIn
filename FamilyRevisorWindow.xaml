<Window x:Class="RevitToSupabasePlugin.FamilyRevisorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏷️ Renombrador &amp; Gestor Masivo de Familias (Family Revisor) | ARCA REVIEW"
        Height="820" Width="1160"
        MinHeight="660" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4"
        Foreground="#1C1C19"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo Botón Primario (Navy) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F4369"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0F4369"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Éxito (Emerald) -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Secundario (Ivory) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0CBC2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAE5DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Ámbar (Undo / Alerta) -->
        <Style x:Key="WarningButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B45309"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F59E0B"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E7EB"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Card Border -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0DCD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#C4BFB6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#C4BFB6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ENCABEZADO -->
        <Border Grid.Row="0" Background="#0F4369" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🏷️ RENOMBRADOR &amp; GESTOR DE FAMILIAS (FAMILY REVISER)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Estandarización sistemática de nomenclatura BIM, exportación de .RFA y sincronización con Excel/CSV" FontSize="11" Foreground="#D1E4F9" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1B5E8C" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="ARCA REVIEW Suite" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </Border>
                    <Button Content="💾 Exportar .RFA a Carpeta" Style="{StaticResource PrimaryButtonStyle}" Click="BtnExportRfa_Click" ToolTip="Exporta las familias cargables seleccionadas como archivos .rfa organizados por categorías en el disco"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. BARRA DE ÁMBITO (SCOPE) E INTERCAMBIO (CSV / EXCEL / IA) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ámbito de selección (DiRoots Scope) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ámbito del Modelo:" FontWeight="Bold" FontSize="11" Foreground="#0F4369" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton x:Name="rbScopeAll" Content="🌐 Todo el Proyecto" IsChecked="True" GroupName="ScopeGroup" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ScopeRadio_Checked"/>
                    <RadioButton x:Name="rbScopeActiveView" Content="👁️ Vista Activa" GroupName="ScopeGroup" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ScopeRadio_Checked"/>
                    <RadioButton x:Name="rbScopeSelection" Content="🎯 Selección Actual en Revit" GroupName="ScopeGroup" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ScopeRadio_Checked"/>
                    <Button Content="🔄 Recargar" Style="{StaticResource SecondaryButtonStyle}" Click="BtnReload_Click" ToolTip="Recarga los elementos del modelo según el ámbito seleccionado"/>
                </StackPanel>

                <!-- Herramientas de Intercambio & IA -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📊 Exportar CSV" Style="{StaticResource SecondaryButtonStyle}" Click="BtnExportCsv_Click" ToolTip="Exporta los nombres actuales y propuestos a un archivo CSV para editar en Excel" Margin="0,0,6,0"/>
                    <Button Content="📥 Importar CSV" Style="{StaticResource SecondaryButtonStyle}" Click="BtnImportCsv_Click" ToolTip="Lee un archivo CSV con nuevos nombres y actualiza la vista previa" Margin="0,0,6,0"/>
                    <Button Content="🤖 Estandarizar BIM (ISO)" Style="{StaticResource PrimaryButtonStyle}" Click="BtnStandardizeBim_Click" ToolTip="Aplica reglas automáticas de estandarización BIM (Elimina sufijos basura, formatea guiones y mayúsculas)" Margin="0,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. PANEL DE FILTROS Y REGLAS DE RENOMBRAMIENTO -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <StackPanel>
                <!-- Fila 1: Filtros de Vista en Tabla -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Filtrar por Categoría:" FontSize="11" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbCategories" SelectionChanged="CmbCategories_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Objetivo a Renombrar:" FontSize="11" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbScope" SelectionChanged="CmbScope_SelectionChanged">
                            <ComboBoxItem Content="Familias y Tipos" IsSelected="True"/>
                            <ComboBoxItem Content="Solo Familias"/>
                            <ComboBoxItem Content="Solo Tipos"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Búsqueda Rápida en Tabla:" FontSize="11" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtSearchFilter" TextChanged="TxtSearchFilter_TextChanged"/>
                    </StackPanel>
                </Grid>

                <Separator Background="#EAE5DC" Margin="0,2,0,8"/>

                <!-- Fila 2: Reglas de Modificación Masiva -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buscar -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Buscar Texto:" FontSize="11" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtFind" TextChanged="RuleInputs_Changed"/>
                        <CheckBox x:Name="chkMatchCase" Content="Coincidir Mayús." FontSize="10" Margin="0,3,0,0" Checked="RuleInputs_Changed" Unchecked="RuleInputs_Changed"/>
                    </StackPanel>

                    <!-- Reemplazar -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Reemplazar Con:" FontSize="11" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtReplace" TextChanged="RuleInputs_Changed"/>
                    </StackPanel>

                    <!-- Prefijo -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Prefijo (+):" FontSize="11" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtPrefix" TextChanged="RuleInputs_Changed"/>
                    </StackPanel>

                    <!-- Sufijo -->
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Sufijo (+):" FontSize="11" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtSuffix" TextChanged="RuleInputs_Changed"/>
                    </StackPanel>

                    <!-- Formato de Caso -->
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="Formato de Texto:" FontSize="11" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbCaseFormat" SelectionChanged="RuleInputs_Changed">
                            <ComboBoxItem Content="Mantener Original" IsSelected="True"/>
                            <ComboBoxItem Content="MAYÚSCULAS"/>
                            <ComboBoxItem Content="minúsculas"/>
                            <ComboBoxItem Content="Formato Título"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Botón Restablecer Reglas -->
                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                        <Button Content="🧹 Limpiar Reglas" Style="{StaticResource SecondaryButtonStyle}" Click="BtnResetRules_Click" ToolTip="Restablecer reglas de búsqueda"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. TABLA DATA GRID CON VISTA PREVIA Y VALIDACIÓN EN VIVO -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid x:Name="dgElements" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAE5DC" Background="#FFFFFF"
                      BorderThickness="0" RowHeight="28" FontSize="11"
                      CellEditEnding="DgElements_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="[X]" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                    
                    <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryName}" IsReadOnly="True" Width="140"/>
                    
                    <DataGridTextColumn Header="Familia Actual" Binding="{Binding OriginalFamilyName}" IsReadOnly="True" Width="180"/>
                    
                    <DataGridTextColumn Header="Nueva Familia" Binding="{Binding NewFamilyName, UpdateSourceTrigger=PropertyChanged}" Width="210">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#0F4369"/>
                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Tipo Actual" Binding="{Binding OriginalTypeName}" IsReadOnly="True" Width="180"/>
                    
                    <DataGridTextColumn Header="Nuevo Tipo" Binding="{Binding NewTypeName, UpdateSourceTrigger=PropertyChanged}" Width="210">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#059669"/>
                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Tipo de Familia" Binding="{Binding FamilyKindText}" IsReadOnly="True" Width="110"/>

                    <DataGridTextColumn Header="Estado de Validación" Binding="{Binding StatusText}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. BARRA INFERIOR DE ACCIONES Y DESHACER (UNDO) -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Acciones de Selección rápida -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="☑️ Seleccionar Todos" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSelectAll_Click" Margin="0,0,6,0"/>
                <Button Content="⬜ Deseleccionar" Style="{StaticResource SecondaryButtonStyle}" Click="BtnDeselectAll_Click" Margin="0,0,10,0"/>
                <TextBlock x:Name="lblStatusSummary" Text="Cargando elementos..." FontSize="11" Foreground="#555550" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Botones de Acción y Deshacer -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnUndo" Content="↩️ Deshacer Último Cambio" Style="{StaticResource WarningButtonStyle}" Click="BtnUndo_Click" IsEnabled="False" Margin="0,0,10,0" ToolTip="Revierte el último lote de renombramiento aplicado en Revit"/>
                <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="🚀 Aplicar Renombramiento en Revit" Style="{StaticResource SuccessButtonStyle}" Click="BtnApply_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
