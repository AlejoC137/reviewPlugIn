<Window x:Class="RevitToSupabasePlugin.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Procesando - ARCA REVIEW" Height="150" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#FCF9F4"
        Foreground="#1C1C19"
        FontFamily="Segoe UI, Inter, sans-serif"
        BorderThickness="2"
        BorderBrush="#0F4369">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- Top branded technical blue line -->
        <Rectangle Grid.Row="0" Fill="#0F4369" HorizontalAlignment="Stretch"/>

        <!-- Text Block -->
        <TextBlock x:Name="txtProgress" Grid.Row="1" Text="0 / 0 Elementos Procesados" 
                   Foreground="#1C1C19" FontSize="13" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Progress Bar -->
        <ProgressBar x:Name="progressBar" Grid.Row="2" Margin="16,2,16,2" 
                     Height="14" Minimum="0" Maximum="100" Value="0"
                     Foreground="#0F4369" Background="#E5E2DD" BorderBrush="#1C1C19" BorderThickness="1"/>

        <!-- Interrupt / Cancel Button -->
        <Button x:Name="btnInterrupt" Grid.Row="3" Content="Interrumpir / Cancelar" 
                Width="200" Height="26" Margin="0,4,0,0"
                Background="#F6F3EE" Foreground="#1C1C19" BorderBrush="#1C1C19" BorderThickness="1"
                FontSize="11" FontWeight="Bold" Click="BtnInterrupt_Click" Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#BA1A1A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#1C1C19"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
