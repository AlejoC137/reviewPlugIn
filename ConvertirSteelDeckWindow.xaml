<Window x:Class="RevitToSupabasePlugin.ConvertirSteelDeckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modelador e Instanciador de Steel Decks en Losas | ARCA REVIEW" 
        Height="760" Width="1160" 
        MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterScreen" 
        Background="#FCF9F4"
        Foreground="#1C1C19"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#1C1C19"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="#0F4369"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="#FFFFFF" Margin="0,8,0,0"/>
                            <Border Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FCF9F4" Padding="6,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1E4F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Columna Izquierda: Parámetros de Modelado de Steel Deck -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="4" Padding="12" Margin="0,0,10,0" BorderBrush="#1C1C19" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="📐 Modelación de Steel Deck" FontSize="16" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,4"/>
                    <TextBlock Text="Configuración de chapa, concreto y studs" FontSize="11" Foreground="#72777F" Margin="0,0,0,10"/>

                    <!-- 1. Perfil de Steel Deck -->
                    <GroupBox Header="1. Tipo y Perfil Steel Deck">
                        <StackPanel>
                            <TextBlock Text="Perfil de Chapa Colaborante:" FontSize="11" Foreground="#A0AEC0"/>
                            <ComboBox x:Name="cmbDeckType" DisplayMemberPath="Name" SelectionChanged="OnConfigChanged"/>

                            <Border Background="#15171A" CornerRadius="6" Padding="8" Margin="0,4,0,0" BorderBrush="#2D3748" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="lblRibHeight" Text="Altura: 5.08 cm" FontSize="11" Foreground="#CBD5E0"/>
                                        <TextBlock Grid.Column="1" x:Name="lblPitch" Text="Paso: 30.48 cm" FontSize="11" Foreground="#CBD5E0"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="lblGauge" Text="Calibre: Cal. 22" FontSize="11" Foreground="#63B3ED"/>
                                        <TextBlock Grid.Column="1" x:Name="lblSheetWidth" Text="Ancho útil: 91.4 cm" FontSize="11" Foreground="#CBD5E0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. Orientación y Distribución -->
                    <GroupBox Header="2. Orientación del Vano (Dirección Ondas)">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" x:Name="sldAngle" Minimum="0" Maximum="360" Value="0" TickFrequency="15" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="sldAngle_ValueChanged"/>
                                <TextBox Grid.Column="1" x:Name="txtAngle" Text="0°" TextAlignment="Center" Margin="6,0,0,0" TextChanged="txtAngle_TextChanged"/>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="0° Horiz." Margin="0,0,2,0" Padding="4,4" FontSize="11" Click="btnAngle0_Click"/>
                                <Button Grid.Column="1" Content="90° Vert." Margin="2,0,2,0" Padding="4,4" FontSize="11" Click="btnAngle90_Click"/>
                                <Button Grid.Column="2" Content="45° Diag." Margin="2,0,0,0" Padding="4,4" FontSize="11" Click="btnAngle45_Click"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3. Capas a Modelar -->
                    <GroupBox Header="3. Capas y Elementos a Generar">
                        <StackPanel>
                            <!-- Chapa Steel Deck -->
                            <CheckBox x:Name="chkGenDeck" Content="Generar Chapa Grecada Steel Deck" IsChecked="True" Foreground="#CBD5E0" FontWeight="Bold" Margin="0,0,0,6" Checked="OnConfigChanged" Unchecked="OnConfigChanged"/>
                            <TextBlock Text="Material de Chapa:" FontSize="11" Foreground="#A0AEC0"/>
                            <ComboBox x:Name="cmbSteelMat" DisplayMemberPath="Name" SelectionChanged="OnConfigChanged"/>

                            <!-- Capa de Concreto -->
                            <Separator Background="#2D3748" Margin="0,6,0,6"/>
                            <CheckBox x:Name="chkGenConcrete" Content="Generar Capa de Compresión de Concreto" IsChecked="True" Foreground="#CBD5E0" FontWeight="Bold" Margin="0,0,0,6" Checked="OnConfigChanged" Unchecked="OnConfigChanged"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Espesor sobre cresta (cm):" FontSize="11" Foreground="#A0AEC0"/>
                                    <TextBox x:Name="txtToppingCm" Text="5.0" TextChanged="OnConfigChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Material Concreto:" FontSize="11" Foreground="#A0AEC0"/>
                                    <ComboBox x:Name="cmbConcreteMat" DisplayMemberPath="Name" SelectionChanged="OnConfigChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Conectores de Cortante -->
                            <Separator Background="#2D3748" Margin="0,6,0,6"/>
                            <CheckBox x:Name="chkGenStuds" Content="Generar Pernos Nelson Studs" IsChecked="True" Foreground="#CBD5E0" FontWeight="Bold" Margin="0,0,0,6" Checked="OnConfigChanged" Unchecked="OnConfigChanged"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                    <TextBlock Text="Diámetro (pulg):" FontSize="10" Foreground="#A0AEC0"/>
                                    <TextBox x:Name="txtStudDiameter" Text="0.75" TextChanged="OnConfigChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                    <TextBlock Text="Altura (cm):" FontSize="10" Foreground="#A0AEC0"/>
                                    <TextBox x:Name="txtStudHeight" Text="10.0" TextChanged="OnConfigChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="2,0,0,0">
                                    <TextBlock Text="Paso (cm):" FontSize="10" Foreground="#A0AEC0"/>
                                    <TextBox x:Name="txtStudSpacing" Text="30.48" TextChanged="OnConfigChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Botón Principal de Acción -->
                    <Button x:Name="btnGenerate" Content="🏗️ Modelar Steel Deck en Revit" Background="#0F4369" Foreground="#FFFFFF" BorderBrush="#0F4369" FontWeight="Bold" FontSize="13" Padding="12,10" Margin="0,10,0,4" Click="btnGenerate_Click"/>
                    <Button Content="Cancelar" Background="#F6F3EE" Foreground="#1C1C19" BorderBrush="#1C1C19" Padding="10,6" Click="btnCancel_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Columna Derecha: Previsualización 2D/3D y Cuadro de Cómputos Métricos -->
        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="4" BorderBrush="#1C1C19" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior de la Vista Previa -->
                <Border Grid.Row="0" Background="#F6F3EE" Padding="12,8" BorderBrush="#1C1C19" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👁️ Vista de Planta y Distribución de Ondas" FontWeight="Bold" FontSize="13" Foreground="#0F4369"/>
                            <TextBlock Text=" • (Líneas azules: crestas | Puntos amarillos: Studs)" FontSize="11" Foreground="#72777F" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔍 Ajustar Vista" Padding="8,3" FontSize="11" Background="#FFFFFF" Foreground="#0F4369" BorderBrush="#0F4369" BorderThickness="1" Click="btnFitView_Click"/>
                    </Grid>
                </Border>

                <!-- Canvas de Dibujo 2D Interactivo -->
                <Canvas Grid.Row="1" x:Name="previewCanvas" Background="#FCF9F4" ClipToBounds="True" SizeChanged="previewCanvas_SizeChanged"/>

                <!-- Panel Inferior de Cómputos y Métricas Estimadas -->
                <Border Grid.Row="2" Background="#F6F3EE" Padding="14,10" BorderBrush="#1C1C19" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Métrica 1: Área -->
                        <Border Grid.Column="0" BorderBrush="#1C1C19" BorderThickness="0,0,1,0" Padding="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="ÁREA NETA" FontSize="10" Foreground="#72777F" FontWeight="Bold"/>
                                <TextBlock x:Name="lblKpiArea" Text="0.00 m²" FontSize="15" FontWeight="Bold" Foreground="#0F4369"/>
                                <TextBlock x:Name="lblKpiPaneles" Text="~0 Paneles" FontSize="10" Foreground="#1C1C19"/>
                            </StackPanel>
                        </Border>

                        <!-- Métrica 2: Volumen Concreto -->
                        <Border Grid.Column="1" BorderBrush="#1C1C19" BorderThickness="0,0,1,0" Padding="10,0">
                            <StackPanel>
                                <TextBlock Text="VOLUMEN CONCRETO" FontSize="10" Foreground="#72777F" FontWeight="Bold"/>
                                <TextBlock x:Name="lblKpiVolumen" Text="0.00 m³" FontSize="15" FontWeight="Bold" Foreground="#137333"/>
                                <TextBlock x:Name="lblKpiValles" Text="Valles: 0.0m³ | Top: 0.0m³" FontSize="10" Foreground="#1C1C19"/>
                            </StackPanel>
                        </Border>

                        <!-- Métrica 3: Conectores Studs -->
                        <Border Grid.Column="2" BorderBrush="#1C1C19" BorderThickness="0,0,1,0" Padding="10,0">
                            <StackPanel>
                                <TextBlock Text="NELSON STUDS" FontSize="10" Foreground="#72777F" FontWeight="Bold"/>
                                <TextBlock x:Name="lblKpiStuds" Text="0 Pzas" FontSize="15" FontWeight="Bold" Foreground="#0F4369"/>
                                <TextBlock x:Name="lblKpiStudsInfo" Text="Paso @ 30.48 cm" FontSize="10" Foreground="#1C1C19"/>
                            </StackPanel>
                        </Border>

                        <!-- Métrica 4: Peso y Costo -->
                        <Border Grid.Column="3" Padding="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="COSTO &amp; PESO" FontSize="10" Foreground="#72777F" FontWeight="Bold"/>
                                <TextBlock x:Name="lblKpiCosto" Text="$0.00 USD" FontSize="15" FontWeight="Bold" Foreground="#1C1C19"/>
                                <TextBlock x:Name="lblKpiPeso" Text="Peso chapa: 0 kg" FontSize="10" Foreground="#72777F"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
