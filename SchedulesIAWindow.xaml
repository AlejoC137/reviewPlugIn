<Window x:Class="RevitToSupabasePlugin.SchedulesIAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asistente de Tablas y Ensamblajes BIM - ARCA REVIEW" 
        Height="820" Width="980" 
        MinHeight="680" MinWidth="850"
        WindowStartupLocation="CenterScreen" 
        Background="#121214"
        Foreground="#E3E5E8"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#3182CE">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1C20"/>
            <Setter Property="Foreground" Value="#121214"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1C20"/>
            <Setter Property="Foreground" Value="#E3E5E8"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3182CE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1A1C20"/>
            <Setter Property="Foreground" Value="#A0AEC0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2D3748"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#3182CE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E3E5E8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. SELECCIÓN DE TABLA MAESTRA / PLANTILLA -->
        <GroupBox Header="1. Selecciona la Tabla de Planificación Maestra (Plantilla)" Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="cmbSchedules" DisplayMemberPath="Name" SelectionChanged="cmbSchedules_SelectionChanged" Grid.Row="0" Grid.Column="0" Margin="0,0,8,4"/>
                <Button x:Name="btnRefreshSchedules" Content="🔄 Recargar" Click="btnRefreshSchedules_Click" Grid.Row="0" Grid.Column="1" Background="#4A5568" Padding="10,6" Margin="0,0,0,4" ToolTip="Recargar tablas del modelo"/>

                <TextBlock x:Name="txtScheduleInfo" Grid.Row="1" Grid.ColumnSpan="2" Text="Selecciona una tabla para ver sus propiedades y campos." FontSize="11" Foreground="#A0AEC0" Margin="2,0,0,2"/>
            </Grid>
        </GroupBox>

        <!-- 2. CONTENIDO PRINCIPAL: 2 COLUMNAS (CAMPOS IZQUIERDA / ACCIONES DERECHA) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA: CAMPOS / PROPIEDADES -->
            <GroupBox Header="2. Campos y Propiedades de la Tabla" Grid.Column="0" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                        <Button Content="Todos" Click="btnSelectAll_Click" Margin="0,0,6,0" Padding="8,4" Background="#4A5568" FontSize="11"/>
                        <Button Content="Ninguno" Click="btnDeselectAll_Click" Padding="8,4" Background="#4A5568" FontSize="11"/>
                    </StackPanel>

                    <CheckBox x:Name="chkOnlySelectedFields" Grid.Row="1" Content="Replicar solo campos seleccionados" IsChecked="False" Margin="0,0,0,8" ToolTip="Si está desmarcado, se replicarán TODOS los campos de la tabla en su orden original." FontSize="11"/>

                    <ListBox x:Name="lstProperties" Grid.Row="2" Background="#1A1C20" Foreground="#E3E5E8" BorderBrush="#4A5568">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Foreground="#E3E5E8" Margin="0,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="txtFieldsCount" Grid.Row="3" Text="0 campos disponibles" FontSize="11" Foreground="#A0AEC0" Margin="2,6,0,0"/>
                </Grid>
            </GroupBox>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#2D3748" Cursor="SizeWE"/>

            <!-- COLUMNA DERECHA: PESTAÑAS (ENSAMBLAJES / GEMINI IA) -->
            <TabControl x:Name="mainTabControl" Grid.Column="2" Margin="4,0,0,0">
                <!-- TAB 1: ENSAMBLAJES (ASSEMBLIES) -->
                <TabItem Header="🏗️ Replicar en Ensamblajes (Assemblies)">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- LISTA DE ENSAMBLAJES -->
                        <GroupBox Header="Ensamblajes Detectados en el Modelo" Grid.Row="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Barra de Filtros de Ensamblajes -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtSearchAssembly" TextChanged="txtSearchAssembly_TextChanged" Margin="0,0,8,0" Padding="5,4" Background="#1A1C20" Foreground="#E3E5E8" BorderBrush="#4A5568" ToolTip="Filtrar por nombre o tipo de ensamblaje..."/>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                                        <Button Content="Todos" Click="btnSelectAllAssemblies_Click" Margin="0,0,4,0" Padding="6,4" Background="#4A5568" FontSize="11"/>
                                        <Button Content="Ninguno" Click="btnDeselectAllAssemblies_Click" Margin="0,0,4,0" Padding="6,4" Background="#4A5568" FontSize="11"/>
                                        <Button Content="Solo sin Tabla" Click="btnSelectWithoutSchedule_Click" Margin="0,0,4,0" Padding="6,4" Background="#4A5568" FontSize="11"/>
                                        <Button Content="Desde Modelo" Click="btnSelectFromRevit_Click" Padding="6,4" Background="#2B6CB0" FontSize="11" ToolTip="Seleccionar según los elementos seleccionados en Revit"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Listado de Ensamblajes -->
                                <ListBox x:Name="lstAssemblies" Grid.Row="1" Background="#1A1C20" Foreground="#E3E5E8" BorderBrush="#4A5568" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#2D3748" BorderThickness="0,0,0,1" Padding="4,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TypeName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                                            <TextBlock Text="{Binding Name, StringFormat=' ({0})'}" Foreground="#A0AEC0" FontSize="11"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding MemberCount, StringFormat='Elementos: {0}'}" FontSize="10" Foreground="#CBD5E0"/>
                                                        <TextBlock Text="{Binding CategoriesSummary, StringFormat='Categorías: {0}'}" FontSize="10" Foreground="#71717A" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="{Binding StatusColor}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding StatusBadge}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="txtAssembliesSummary" Grid.Row="2" Text="0 ensamblajes disponibles" FontSize="11" Foreground="#A0AEC0" Margin="2,4,0,0"/>
                            </Grid>
                        </GroupBox>

                        <!-- OPCIONES DE RÉPLICA DE FORMATO -->
                        <GroupBox Header="Opciones de Replicación de Campos y Formato" Grid.Row="1">
                            <StackPanel Orientation="Vertical">
                                <CheckBox x:Name="chkCreateIfNotExists" Content="Crear tabla de ensamblaje si aún no existe" IsChecked="True" Margin="0,2,0,4"/>
                                <CheckBox x:Name="chkReplicateFormat" Content="Replicar formato de campos (Cabecera, anchos de columna, alineación y unidades)" IsChecked="True" Margin="0,2,0,4"/>
                                <CheckBox x:Name="chkReplicateSorting" Content="Replicar reglas de clasificación y agrupación (Sorting &amp; Grouping)" IsChecked="True" Margin="0,2,0,4"/>
                                <CheckBox x:Name="chkReplicateFilters" Content="Replicar filtros de la tabla plantilla" IsChecked="True" Margin="0,2,0,4"/>
                                <CheckBox x:Name="chkReplicateItemize" Content="Replicar totales generales y desglose de ejemplares (Itemize)" IsChecked="True" Margin="0,2,0,4"/>
                                <CheckBox x:Name="chkReplicateTemplate" Content="Vincular View Template gráfica de la tabla maestra" IsChecked="True" Margin="0,2,0,2"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- BOTÓN DE ACCIÓN PRINCIPAL -->
                        <Button x:Name="btnApplyToAssemblies" Grid.Row="2" Content="🚀 Crear y Replicar Formato en Ensamblajes Seleccionados" Click="btnApplyToAssemblies_Click" Background="#10B981" Height="42" FontSize="13" Margin="0,0,0,10"/>

                        <!-- REGISTRO DE RESULTADOS -->
                        <GroupBox Header="Registro de Ejecución" Grid.Row="3" Margin="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="txtAssemblyLog" Text="Listo para procesar. Selecciona la tabla plantilla y los ensamblajes de destino." IsReadOnly="True" Background="#1A1C20" Foreground="#A0AEC0" BorderThickness="0" TextWrapping="Wrap" Margin="0"/>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- TAB 2: ASISTENTE GEMINI IA -->
                <TabItem Header="🤖 Asistente IA (Gemini)">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Header="3. Pre-prompts Rápidos" Grid.Row="0">
                            <StackPanel Orientation="Vertical">
                                <Button Content="Crear nueva propiedad con fórmula" Click="btnPrePromptFormula_Click" Margin="0,0,0,5" Padding="8,5" Background="#4A5568" HorizontalAlignment="Stretch"/>
                                <Button Content="Formatear vista condicionalmente" Click="btnPrePromptFormat_Click" Margin="0,0,0,5" Padding="8,5" Background="#4A5568" HorizontalAlignment="Stretch"/>
                                <Button Content="Modificar propiedades de elementos" Click="btnPrePromptModify_Click" Margin="0,0,0,5" Padding="8,5" Background="#4A5568" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="4. Escribe el Prompt para Gemini" Grid.Row="1">
                            <TextBox x:Name="txtPrompt" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True" 
                                     VerticalScrollBarVisibility="Auto" 
                                     Text="Ejemplo: Suma todos los valores de la columna Costo y crea una nueva propiedad sugerida para los elementos."/>
                        </GroupBox>

                        <Button x:Name="btnCopy" Grid.Row="2" Content="Copiar Información + Prompt al Portapapeles" Click="btnCopy_Click" Height="40" Margin="0,4,0,0"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
