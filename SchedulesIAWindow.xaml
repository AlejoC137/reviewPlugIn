<Window x:Class="RevitToSupabasePlugin.SchedulesIAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asistente de Tablas IA - Copiar a Gemini" 
        Height="750" Width="550" 
        MinHeight="600" MinWidth="450"
        WindowStartupLocation="CenterScreen" 
        Background="#121214"
        Foreground="#E3E5E8"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#3182CE">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1C20"/>
            <Setter Property="Foreground" Value="#121214"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1C20"/>
            <Setter Property="Foreground" Value="#E3E5E8"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3182CE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="1. Selecciona una Tabla de Planificación" Grid.Row="0">
            <ComboBox x:Name="cmbSchedules" DisplayMemberPath="Name" SelectionChanged="cmbSchedules_SelectionChanged"/>
        </GroupBox>

        <GroupBox Header="2. Seleccionar Propiedades" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Seleccionar Todo" Click="btnSelectAll_Click" Margin="0,0,10,0" Padding="8,5" Background="#4A5568"/>
                    <Button Content="Deseleccionar Todo" Click="btnDeselectAll_Click" Padding="8,5" Background="#4A5568"/>
                </StackPanel>
                <ListBox x:Name="lstProperties" Grid.Row="1" Background="#1A1C20" Foreground="#E3E5E8" BorderBrush="#4A5568">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Foreground="#E3E5E8" Margin="0,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <GroupBox Header="3. Pre-prompts Rápidos" Grid.Row="2">
            <StackPanel Orientation="Vertical">
                <Button Content="Crear nueva propiedad con fórmula" Click="btnPrePromptFormula_Click" Margin="0,0,0,5" Padding="8,5" Background="#4A5568" HorizontalAlignment="Stretch"/>
                <Button Content="Formatear vista condicionalmente" Click="btnPrePromptFormat_Click" Margin="0,0,0,5" Padding="8,5" Background="#4A5568" HorizontalAlignment="Stretch"/>
                <Button Content="Modificar propiedades de elementos" Click="btnPrePromptModify_Click" Margin="0,0,0,5" Padding="8,5" Background="#4A5568" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="4. Escribe el Prompt para Gemini" Grid.Row="3">
            <TextBox x:Name="txtPrompt" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto" 
                     Text="Ejemplo: Suma todos los valores de la columna Costo y crea una nueva propiedad sugerida para los elementos."/>
        </GroupBox>

        <Button x:Name="btnCopy" Grid.Row="4" Content="Copiar Información + Prompt al Portapapeles" Click="btnCopy_Click" Margin="0,10,0,0"/>
    </Grid>
</Window>
