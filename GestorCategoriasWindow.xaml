<Window x:Class="RevitToSupabasePlugin.GestorCategoriasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de Categorías de Sistema de Revit | ARCA REVIEW" 
        Height="840" Width="1200" 
        MinHeight="700" MinWidth="1020"
        WindowStartupLocation="CenterScreen" 
        Background="#121214"
        Foreground="#E3E5E8"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#3182CE"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="#1A1C20" Margin="0,10,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="5" ShadowDepth="2"/>
                                </Border.Effect>
                            </Border>
                            <Border Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#121214" Padding="6,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2B2D31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F4248"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E2024"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#3B4252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Header y banner explicativo -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Barra de herramientas de escaneo -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Lista / DataGrid principal e Inspector lateral -->
            <RowDefinition Height="*"/>
            <!-- 3. Panel inferior de asignación de categorías -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. HEADER & EDUCATIONAL BANNER -->
        <Border Grid.Row="0" Background="#181B20" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#2B3240" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="🏛️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gestor de Categorías de Sistema de Revit" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Asigna categorías de sistema (Suelos, Muros, etc.) a elementos y familias genéricas del plugin para adquirir cómputos y propiedades" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tarjetas Explicativas: Familias de Sistema vs Familias Cargables -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1 -->
                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,6,0" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📌 Familias de Sistema (Suelos, Muros)" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                            <TextBlock Text="Viven solo en el archivo .rvt (no tienen archivo .rfa externo). Soportan estructuras compuestas, cómputos de suelos nativos y visibilidad/gráficos por categoría de sistema." TextWrapping="Wrap" FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2 -->
                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="10" Margin="3,0,3,0" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📦 Familias Cargables (.rfa)" FontWeight="Bold" FontSize="11" Foreground="#F59E0B"/>
                            <TextBlock Text="Se crean en el Editor de Familias externo. Revit prohíbe asignarles la categoría Suelos (OST_Floors) o Muros (OST_Walls) en el .rfa, por lo que nacen como Modelos Genéricos." TextWrapping="Wrap" FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3 -->
                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="10" Margin="6,0,0,0" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⚡ Solución del Gestionador" FontWeight="Bold" FontSize="11" Foreground="#4ADE80"/>
                            <TextBlock Text="Reasigna la geometría interna a la categoría de sistema (OST_Floors, etc.) o genera Suelos Nativos (Floor), permitiendo que aparezcan en Tablas de Suelos y adquieran sus propiedades." TextWrapping="Wrap" FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 1. TOOLBAR DE ESCANEO Y FILTRADO -->
        <Border Grid.Row="1" Background="#16181D" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#252A36" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnScanProject" Content="🔄 Escanear Proyecto" Click="btnScanProject_Click" Margin="0,0,8,0" Background="#1E293B"/>
                <Button Grid.Column="1" x:Name="btnScanActiveView" Content="👁️ Vista Activa" Click="btnScanActiveView_Click" Margin="0,0,8,0" Background="#1E293B"/>
                <Button Grid.Column="2" x:Name="btnPickInRevit" Content="🎯 Seleccionar en Revit" Click="btnPickInRevit_Click" Margin="0,0,12,0" Background="#2563EB"/>

                <CheckBox Grid.Column="3" x:Name="chkOnlyPlugin" Content="Solo elementos creados por el plugin" IsChecked="true" Checked="chkOnlyPlugin_Checked" Unchecked="chkOnlyPlugin_Checked" VerticalAlignment="Center" Foreground="#CBD5E1" Margin="0,0,12,0"/>

                <!-- Buscador de texto -->
                <TextBox Grid.Column="4" x:Name="txtSearch" Height="30" Background="#1F232B" Foreground="#F8FAFC" BorderBrush="#333D4F" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center" TextChanged="txtSearch_TextChanged" Margin="0,0,12,0"/>

                <Button Grid.Column="5" x:Name="btnCreateFloorSchedule" Content="📊 Crear Tabla Suelos" Click="btnCreateFloorSchedule_Click" Margin="0,0,10,0" Padding="10,6" FontSize="11" Background="#0D9488"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnSelectAll" Content="Seleccionar Todo" Click="btnSelectAll_Click" Margin="0,0,6,0" Padding="8,5" FontSize="11" Background="#334155"/>
                    <Button x:Name="btnUnselectAll" Content="Deseleccionar" Click="btnUnselectAll_Click" Padding="8,5" FontSize="11" Background="#334155"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. LISTADO / DATAGRID DE ELEMENTOS ESCANEADOS E INSPECTOR LATERAL -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid Principal -->
            <Border Grid.Column="0" Background="#14161A" CornerRadius="6" BorderBrush="#252A36" BorderThickness="1" Margin="0,0,10,0">
                <DataGrid x:Name="gridElements" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          Background="Transparent" 
                          RowBackground="#181B20" 
                          AlternatingRowBackground="#1F2228"
                          Foreground="#E2E8F0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#2B3240"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          SelectionMode="Extended"
                          SelectionChanged="gridElements_SelectionChanged"
                          MouseDoubleClick="gridElements_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#1E293B"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdString}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Rol en Plugin" Binding="{Binding PluginRole}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tipo Interno" Binding="{Binding ElementTypeKind}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Categoría Actual" Binding="{Binding CurrentCategoryName}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nivel" Binding="{Binding LevelName}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding AreaM2, StringFormat={}{0:F2}}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Volumen (m³)" Binding="{Binding VolumeM3, StringFormat={}{0:F4}}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Comentarios" Binding="{Binding Comments}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Inspector de Propiedades Lateral -->
            <Border Grid.Column="1" Background="#181B20" CornerRadius="6" BorderBrush="#252A36" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🔍 Inspector de Elemento" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,10"/>

                        <Border Background="#0F172A" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="ID REVIT:" FontSize="10" Foreground="#64748B"/>
                                <TextBlock x:Name="inspId" Text="-" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="NOMBRE / TIPO:" FontSize="10" Foreground="#64748B"/>
                                <TextBlock x:Name="inspName" Text="-" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="CATEGORÍA ACTUAL:" FontSize="10" Foreground="#64748B"/>
                                <TextBlock x:Name="inspCategory" Text="-" FontWeight="Bold" FontSize="12" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="ROL CONSTRUCTIVO:" FontSize="10" Foreground="#64748B"/>
                                <TextBlock x:Name="inspRole" Text="-" FontWeight="Bold" FontSize="12" Foreground="#4ADE80"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="MATERIAL ASIGNADO:" FontSize="10" Foreground="#64748B"/>
                                <TextBlock x:Name="inspMaterial" Text="-" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ÁREA ESTIMADA:" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="inspArea" Text="-" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="VOLUMEN:" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="inspVolume" Text="-" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="COMENTARIOS BIM:" FontSize="10" Foreground="#64748B"/>
                                <TextBlock x:Name="inspComments" Text="-" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnHighlightInRevit" Content="🎯 Resaltar en Revit" Click="btnHighlightInRevit_Click" Background="#2563EB" Margin="0,0,0,6"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. PANEL INFERIOR DE ASIGNACIÓN -->
        <Border Grid.Row="3" Background="#181B20" CornerRadius="8" Padding="14" BorderBrush="#2B3240" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Columna Izquierda: Configuración de Categoría y Modo -->
                    <ColumnDefinition Width="2*"/>
                    <!-- Columna Derecha: Parámetros y Botón de Ejecución -->
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Categoría de Sistema Destino:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#F8FAFC"/>
                        <ComboBox Grid.Column="1" x:Name="cmbTargetCategory" SelectionChanged="cmbTargetCategory_SelectionChanged" DisplayMemberPath="DisplayName"/>
                    </Grid>

                    <TextBlock x:Name="lblCategoryDescription" Text="Categoría nativa para acabados de piso, baldosas y morteros." FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Método de Conversión -->
                    <TextBlock Text="Método de Aplicación:" FontWeight="Bold" Margin="0,0,0,6" Foreground="#CBD5E1"/>
                    <StackPanel Orientation="Vertical">
                        <RadioButton x:Name="rbDirectShape" Content="Reasignar Categoría de Sistema (DirectShape 3D Exacto)" IsChecked="True" Checked="rbMethod_Checked" Foreground="#F1F5F9" Margin="0,0,0,4"/>
                        <TextBlock Text="  • Mantiene el sólido 3D exacto (baldosas, juntas, cortes, morteros). Adquiere visibilidad y tablas de la categoría elegida." FontSize="10.5" Foreground="#94A3B8" Margin="16,0,0,8"/>

                        <RadioButton x:Name="rbNativeFloor" Content="Convertir a Suelo Nativo de Revit (Entidad Floor)" Checked="rbMethod_Checked" Foreground="#F1F5F9" Margin="0,0,0,4"/>
                        <TextBlock Text="  • Genera un elemento Floor real en Revit con espesor y FloorType a partir del contorno horizontal." FontSize="10.5" Foreground="#94A3B8" Margin="16,0,0,4"/>
                    </StackPanel>

                    <!-- Selector de FloorType (solo visible para Suelo Nativo) -->
                    <Grid x:Name="gridFloorTypeSelector" Visibility="Collapsed" Margin="16,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tipo de Suelo (FloorType):" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#94A3B8"/>
                        <ComboBox Grid.Column="1" x:Name="cmbFloorTypes" DisplayMemberPath="Name"/>
                    </Grid>
                </StackPanel>

                <!-- Columna Derecha: Opciones y Botón Principal -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <CheckBox x:Name="chkPreserveMetadata" Content="Preservar comentarios, materiales y marcas" IsChecked="True" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                    <CheckBox x:Name="chkDeleteOriginals" Content="Reemplazar/Eliminar elementos genéricos originales" IsChecked="True" Foreground="#CBD5E1" Margin="0,0,0,12"/>

                    <Button x:Name="btnApplyCategory" 
                            Content="✨ Aplicar Categoría de Sistema" 
                            Click="btnApplyCategory_Click" 
                            Height="44" 
                            Background="#16A34A" 
                            FontSize="13" 
                            FontWeight="Bold">
                        <Button.Effect>
                            <DropShadowEffect Color="#16A34A" Opacity="0.3" BlurRadius="8" ShadowDepth="2"/>
                        </Button.Effect>
                    </Button>

                    <TextBlock x:Name="lblStatus" Text="0 elementos listados" HorizontalAlignment="Center" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
