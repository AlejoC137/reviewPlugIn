  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "################################\r\n\r\n#LIBRARIES. \r\n\r\n################################\r\nimport sys\r\nimport clr\r\nimport os\r\n#System classes and methods.\r\nclr.AddReference(\"System.Core\")\r\nimport System\r\nfrom System                     import Array, Enum\r\nfrom System.IO                  import *\r\nfrom System.Collections.Generic import List\r\n#Access to Revit classes and methods.\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference(\"RevitAPIUI\")\r\nclr.AddReference(\"RevitServices\")\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB         import *\r\nfrom Autodesk.Revit.UI         import *\r\nfrom RevitServices.Persistence import DocumentManager\r\n#Access to Windows Forms and other libraries for UI/UX.\r\nclr.AddReference('System.Data')\r\nclr.AddReference('System.Drawing')\r\nclr.AddReference('System.Windows.Forms')\r\nclr.AddReference('System.Threading.Tasks')\r\nfrom System.Data            import *\r\nfrom System.Drawing         import *\r\nfrom System.Windows.Forms   import *\r\nfrom System.Threading.Tasks import Task\r\n\r\n################################\r\n\r\n#CUSTOM CLASSES. To later use custom objects.\r\n\r\n################################\r\n\r\n#(If any)\r\n\r\n################################\r\n\r\n#EXTERNAL EVENTS. Called from the main window to modify the document.\r\n\r\n################################\r\n\t\t\t\r\nclass myExternalEvent(IExternalEventHandler):\t\t\r\n\tdef Execute(self, uiapp):\r\n\t\ttry:\r\n\t\t\t#Basic variables\r\n\t\t\tglobal doc\r\n\t\t\tglobal rvt_ver\r\n\t\t\tuidoc   = uiapp.ActiveUIDocument\r\n\t\t\tdoc     = uidoc.Document\r\n\t\t\trvt_ver = int(uiapp.Application.VersionNumber)\r\n\t\t\t\r\n\t\t\t#Get information from control main window using main window object. \r\n\t\t\t\t#data = mainWindow._control\r\n\t\t\t\t#For example, if we have a CheckedListBox, we can get the checked items.\r\n\t\t\t\t#list_element_ids_to_process = [item[\"Value\"] for item in mainWindow._checklistbox.CheckedItems]\r\n\t\t\tlist_element_ids_to_process = [1, 2, 3, 4, 5]\r\n\t\t\t\r\n\t\t\t#Progress/loading bar. Hide main window and show progress window.\r\n\t\t\tglobal windowProgress\r\n\t\t\twindowProgress = WindowWithProgresBar()\r\n\t\t\tnum_items      = len(list_element_ids_to_process)\r\n\t\t\twindowProgress._progressBar.Maximum = num_items\r\n\t\t\twindowProgress._progressBar.Minimum = 0\r\n\t\t\twindowProgress._progressBar.Step    = 1\r\n\t\t\tmainWindow.Hide()\r\n\t\t\twindowProgress.Show()\r\n\t\t\t\r\n\t\t\t#A transaction needed to modify the Revit document.\r\n\t\t\twith Transaction(doc, \"Transaction Name\") as tr:\r\n\t\t\t\ttr.Start()\r\n\t\t\t\t#Iterate to process each element.\r\n\t\t\t\tfor counter, item in enumerate(list_element_ids_to_process):\r\n\t\t\t\t\t#Update progress bar while loading.\r\n\t\t\t\t\twindowProgress._txtBlock.Text = str(counter) + \" / \" + str(num_items) + \" Items Processed\"\r\n\t\t\t\t\twindowProgress._progressBar.PerformStep()\r\n\t\t\t\t\twindowProgress.Refresh()\r\n\t\t\t\t\tApplication.DoEvents()\r\n\t\t\t\t\tif windowProgress.interrupt == True:\r\n\t\t\t\t\t\t#Check if process should be interrupted\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t\r\n\t\t\t\t\t###\r\n\t\t\t\t\t#Your code to process comes here.\r\n\t\t\t\t\t###\r\n\t\t\t\t\t\r\n\t\t\t\t\t#Delete the 2 lines below (time.sleep), only for visualization purposes.\r\n\t\t\t\t\timport time\r\n\t\t\t\t\ttime.sleep(0.5)\r\n\t\t\t\tif windowProgress.interrupt == True:\r\n\t\t\t\t\ttr.RollBack()\r\n\t\t\t\telse:\r\n\t\t\t\t\ttr.Commit()\r\n\r\n\t\t\tif windowProgress.interrupt == True:\r\n\t\t\t\t#If process was interrupted, show message to user.\r\n\t\t\t\twindowProgress.Close()\r\n\t\t\t\tAutodesk.Revit.UI.TaskDialog.Show(\"Process Cancelled\",\"The process has been interrupted / cancelled.\\n\\n\" + \"No changes were applied to the document.\")\r\n\t\t\telse:\r\n\t\t\t\t#If not interrupted, just close progress bar.\r\n\t\t\t\twindowProgress.Close()\r\n\t\t\t#Show main window and reactivate controls\r\n\t\t\tmainWindow.Show()\t\r\n\t\t\tmainWindow.EnableDisableRunningControls(True)\r\n\t\texcept Exception as e:\r\n\t\t\t#If there is a exception, show exception message and line in code.\r\n\t\t\twindowProgress.Close()\r\n\t\t\tAutodesk.Revit.UI.TaskDialog.Show(\"Exception\", str(e) + \" - \" + str(sys.exc_info()[-1].tb_lineno))\r\n\t\t\t#Show main window and reactivate controls\r\n\t\t\tmainWindow.Show()\r\n\t\t\tmainWindow.EnableDisableRunningControls(True)\t\t\t\t\t\r\n\t        \r\n\tdef GetName(self):\r\n\t\treturn \"Name Event\"\t\t\r\n\r\n################################\r\n\r\n#WINDOWS. To interact with the user and gather inputs.\r\n\r\n################################\r\n\r\nclass MainWindow(Form):\r\n\tdef __init__(self, ex_event):\r\n\t\t#Basic window variables.\r\n\t\tself.Font = Font(self.Font.FontFamily, 16, FontStyle.Regular, GraphicsUnit.Pixel)\r\n\t\tself.ext_ev = ex_event\r\n\t\tself.InitializeComponent()\r\n\r\n\tdef InitializeComponent(self):\r\n\t\t#Controls in window (buttons, ...)\r\n\t\tself._spr_top          = System.Windows.Forms.Label()\r\n\t\tself.groupFolder       = System.Windows.Forms.GroupBox()\r\n\t\tself._tlTip            = System.Windows.Forms.ToolTip()\r\n\t\tself._txtBox           = System.Windows.Forms.TextBox()\r\n\t\tself._btn_extra        = System.Windows.Forms.Button()\r\n\t\tself._chckBoxRcsv      = System.Windows.Forms.CheckBox()\r\n\t\tself._btn_main         = System.Windows.Forms.Button()\r\n\t\tself.SuspendLayout()\r\n\t\t# \r\n\t\t# Top branded line\r\n\t\t# \r\n\t\tself._spr_top.Anchor     = System.Windows.Forms.AnchorStyles.Top | System.Windows.Forms.AnchorStyles.Left | System.Windows.Forms.AnchorStyles.Right\r\n\t\tself._spr_top.Location   = System.Drawing.Point(0, 0)\r\n\t\tself._spr_top.Name       = \"spr_top\"\r\n\t\tself._spr_top.Size       = System.Drawing.Size(5000, 2)\r\n\t\tself._spr_top.BackColor  = Color.FromArgb(82, 53, 239)\r\n\t\t# \r\n\t\t# Sample Textbox\r\n\t\t#\r\n\t\tself._txtBox.Anchor   = System.Windows.Forms.AnchorStyles.Top | System.Windows.Forms.AnchorStyles.Left | System.Windows.Forms.AnchorStyles.Right\r\n\t\tself._txtBox.Location = System.Drawing.Point(10, 25)\r\n\t\tself._txtBox.Name     = \"txtBox\"\r\n\t\tself._txtBox.Size     = System.Drawing.Size(75, 23)\r\n\t\tself._txtBox.Text     = \"Sample TextBox\"\r\n\t\tself._tlTip.SetToolTip(self._txtBox, \"Tooltip when mouse is over\")\r\n\t\tself.groupFolder.Controls.Add(self._txtBox)\r\n\t\t# \r\n\t\t# Sample Button\r\n\t\t# \r\n\t\tself._btn_extra.Anchor    = System.Windows.Forms.AnchorStyles.Top | System.Windows.Forms.AnchorStyles.Right \r\n\t\tself._btn_extra.Location  = System.Drawing.Point(95, 24)\r\n\t\tself._btn_extra.Name      = \"btn_extra\"\r\n\t\tself._btn_extra.Size      = System.Drawing.Size(95, 29)\r\n\t\tself._btn_extra.Text      = \"Button\"\r\n\t\tself._btn_extra.Cursor    = Cursors.Hand\r\n\t\tself._btn_extra.Click    += self.click_extraProcess\r\n\t\tself._tlTip.SetToolTip(self._btn_extra, \"Tooltip when mouse is over\")\r\n\t\tself.groupFolder.Controls.Add(self._btn_extra)\r\n\t\t# \r\n\t\t# Sample Checkbox\r\n\t\t# \r\n\t\tself._chckBoxRcsv.Anchor   = System.Windows.Forms.AnchorStyles.Top | System.Windows.Forms.AnchorStyles.Left\r\n\t\tself._chckBoxRcsv.Location = System.Drawing.Point(12, 55)\r\n\t\tself._chckBoxRcsv.Name     = \"radiobutton2\"\r\n\t\tself._chckBoxRcsv.Size     = System.Drawing.Size(300, 25)\r\n\t\tself._chckBoxRcsv.Text     = \"Sample Checkbox.\"\r\n\t\tself._chckBoxRcsv.Checked  = True\r\n\t\tself._tlTip.SetToolTip(self._chckBoxRcsv, \"Tooltip when mouse is over\")\r\n\t\tself.groupFolder.Controls.Add(self._chckBoxRcsv)\r\n\t\t# \r\n\t\t# Group of Controls\r\n\t\t#\r\n\t\tself.groupFolder.Text     = \"Group of Controls\"\r\n\t\tself.groupFolder.Location = System.Drawing.Point(12, 5)\r\n\t\tself.groupFolder.Size     = System.Drawing.Size(530, 85)\r\n\t\t# \r\n\t\t# Button Main\r\n\t\t# \r\n\t\tself._btn_main.Anchor    = System.Windows.Forms.AnchorStyles.Top | System.Windows.Forms.AnchorStyles.Left | System.Windows.Forms.AnchorStyles.Right  \r\n\t\tself._btn_main.Location  = System.Drawing.Point(12, 100)\r\n\t\tself._btn_main.Name      = \"btn_main\"\r\n\t\tself._btn_main.Size      = System.Drawing.Size(530, 30)\r\n\t\tself._btn_main.Text      = \"Sample Loading Process\"\r\n\t\tself._btn_main.Cursor    = Cursors.Hand\r\n\t\tself._btn_main.Click    += self.click_mainProcess\r\n\t\tself._tlTip.SetToolTip(self._btn_main, \"Tooltip when mouse is over.\")\r\n\t\t# \r\n\t\t# General settings window (size, topmost, ...)\r\n\t\t# \r\n\t\tself.ClientSize = System.Drawing.Size(554, 145)\r\n\t\tself.MaximizeBox = 0\r\n\t\tself.MinimizeBox = 0\r\n\t\tself.CenterToScreen() \r\n\t\tself.FormBorderStyle = FormBorderStyle.FixedSingle\r\n\t\tself.Controls.Add(self._spr_top)\r\n\t\tself.Controls.Add(self.groupFolder)\r\n\t\tself.Controls.Add(self._btn_main)\r\n\t\tself.Name = \"Name Small Tool\"\r\n\t\tself.Text = \"Name Small Tool\"\r\n\t\tself.TopMost = True\r\n\t\t#Icons to show in the corner of the window.\r\n\t\t#iconFilename = 'C:\\\\NONICAPRO\\\\OtherFiles\\\\System\\\\Nonicafavicon.ICO'\r\n\t\t#if not os.path.exists(iconFilename):\r\n\t\t\t#iconFilename = 'C:\\\\NONICA\\\\OtherFiles\\\\System\\\\Nonicafavicon.ICO'\r\n\t\t#icon = Icon(iconFilename)\r\n\t\t#self.Icon = icon\r\n\t\tself.ResumeLayout(False)\r\n\t\t\r\n\tdef EnableDisableRunningControls(self, IsEnabled):\r\n\t\tself.groupFolder.Enabled = IsEnabled\r\n\t\tself._btn_main.Enabled   = IsEnabled\r\n\t\tif IsEnabled == False:\r\n\t\t\t#In case, there is another command blocking Revit, let the user know.\r\n\t\t\tself._btn_main.Text = \"Revit is Blocked (Other command being run). Press Esc\"\r\n\t\telse:\r\n\t\t\t#Set original button text after processing\r\n\t\t\tself._btn_main.Text = \"Sample Loading Process\"\r\n            \r\n\tdef click_mainProcess(self, sender, e):\r\n\t\t#Disable controls\r\n\t\tself.EnableDisableRunningControls(False)\r\n\t\t#Run external event\r\n\t\tself.ext_ev.Raise()\r\n\t\r\n\tdef click_extraProcess(self, sender, e):\r\n\t\t#Sample Action\r\n\t\tself.Hide()\r\n\t\tAutodesk.Revit.UI.TaskDialog.Show(\"Sample Button Click\",\"Sample message to show to the user.\")\r\n\t\tself.Show()\r\n\r\nclass WindowWithProgresBar(Form):\r\n\tdef __init__(self):\r\n\t\t#Basic window variables and events.\r\n\t\tself.Font      = Font(\"Arial\", 15, FontStyle.Regular, GraphicsUnit.Pixel)\r\n\t\tself.interrupt = False\r\n\t\tself.TopMost   = True\r\n\t\tself.Closing  += self.closingevent\r\n\t\tself.InitializeComponent()\r\n\t\t\r\n\tdef InitializeComponent(self):\r\n\t\t#Controls in window (buttons, ...)\r\n\t\tself._spr_top      = System.Windows.Forms.Label()\r\n\t\tself._progressBar  = System.Windows.Forms.ProgressBar()\r\n\t\tself._btn_inter    = System.Windows.Forms.Button()\r\n\t\tself._txtBlock     = System.Windows.Forms.Label()\r\n\t\tself.SuspendLayout()\r\n\t\t# \r\n\t\t# Top branded line.\r\n\t\t# \r\n\t\tself._spr_top.Anchor     = System.Windows.Forms.AnchorStyles.Top | System.Windows.Forms.AnchorStyles.Left | System.Windows.Forms.AnchorStyles.Right\r\n\t\tself._spr_top.Location   = System.Drawing.Point(0, 0)\r\n\t\tself._spr_top.Name       = \"spr_branded_line\"\r\n\t\tself._spr_top.Size       = System.Drawing.Size(2000, 2)\r\n\t\tself._spr_top.BackColor  = Color.FromArgb(82, 53, 239)\r\n\t\t# \r\n\t\t# TextBlock\r\n\t\t# \r\n\t\tself._txtBlock.Anchor    = System.Windows.Forms.AnchorStyles.Top | System.Windows.Forms.AnchorStyles.Left\r\n\t\tself._txtBlock.TextAlign = ContentAlignment.MiddleCenter\r\n\t\tself._txtBlock.Location  = System.Drawing.Point(0, 5)\r\n\t\tself._txtBlock.Name      = \"txt_items\"\r\n\t\tself._txtBlock.Size      = System.Drawing.Size(250, 20)\r\n\t\tself._txtBlock.Text      = \"0 / 0 Items Processed\"\r\n\t\t# \r\n\t\t# ProgressBar\r\n\t\t# \r\n\t\tself._progressBar.Anchor   = System.Windows.Forms.AnchorStyles.Bottom | System.Windows.Forms.AnchorStyles.Left\r\n\t\tself._progressBar.Location = System.Drawing.Point(15, 30)\r\n\t\tself._progressBar.Name     = \"prg_bar\"\r\n\t\tself._progressBar.Size     = System.Drawing.Size(220, 15)\r\n\t\tself._progressBar.Value    = 0\r\n\t\t# \r\n\t\t# Button Interrupt\r\n\t\t# \r\n\t\tself._btn_inter.Anchor   = System.Windows.Forms.AnchorStyles.Bottom | System.Windows.Forms.AnchorStyles.Right\r\n\t\tself._btn_inter.Location = System.Drawing.Point(14, 50)\r\n\t\tself._btn_inter.Name     = \"btn_interrupt\"\r\n\t\tself._btn_inter.Size     = System.Drawing.Size(222, 20)\r\n\t\tself._btn_inter.Text     = \"Interrupt / Cancel\"\r\n\t\tself._btn_inter.Click   += self.Button1Click\r\n\t\tself._btn_inter.UseVisualStyleBackColor = True\r\n\t\t# \r\n\t\t# Form24\r\n\t\t# \r\n\t\tself.ClientSize      = System.Drawing.Size(250, 85)\r\n\t\tself.MaximizeBox     = 0\r\n\t\tself.MinimizeBox     = 0\r\n\t\tself.FormBorderStyle = FormBorderStyle.FixedSingle\r\n\t\tself.CenterToScreen() \r\n\t\tself.Controls.Add(self._spr_top)\r\n\t\tself.Controls.Add(self._txtBlock)\r\n\t\tself.Controls.Add(self._btn_inter)\r\n\t\tself.Controls.Add(self._progressBar)\r\n\t\tself.Name = \"Processing...\"\r\n\t\tself.Text = \"Processing...\"\r\n\t\t#Icons to show in the corner of the window.\r\n\t\t#iconFilename = 'C:\\\\NONICAPRO\\\\OtherFiles\\\\System\\\\Nonicafavicon.ICO'\r\n\t\t#if not os.path.exists(iconFilename):\r\n\t\t\t#iconFilename = 'C:\\\\NONICA\\\\OtherFiles\\\\System\\\\Nonicafavicon.ICO'\r\n\t\t#icon = Icon(iconFilename)\r\n\t\t#self.Icon = icon\r\n\t\tself.ResumeLayout(False)\r\n\t\t\r\n\tdef Button1Click(self, sender, e):\r\n\t\t#If interrupted is pressed, change interrupted variable.\r\n\t\tself.interrupt = True\r\n\t\t\r\n\tdef closingevent(self, sender, e):\r\n\t\t#If window is closed, change interrupted variable.\r\n\t\tself.interrupt = True\r\n\r\n################################\r\n\r\n#STATIC FUNCTIONS. General functions to call.\r\n\r\n################################\r\n\r\n#Eventually failure processing, to swallow non-critical warnings.\r\n\"\"\"\r\ndef OnFailuresProcessing(sender, e):\r\n\ta = e.GetFailuresAccessor()\r\n\tfailures = a.GetFailureMessages()\r\n\tfor f in failures:\r\n\t\tfseverity = a.GetSeverity()\r\n\t\tif fseverity == FailureSeverity.Warning:\r\n\t\t\ta.DeleteWarning(f)\r\n\t\telse:\r\n\t\t\ta.ResolveFailure(f)\r\n\t\t\treturn FailureProcessingResult.ProceedWithCommit\r\n\treturn FailureProcessingResult.Continue\r\n\r\n#How to use:\r\n\t1-Create EventHandler in Main.\r\n\t\tglobal failureProc\r\n\t\tfailureProc = System.EventHandler[Autodesk.Revit.DB.Events.FailuresProcessingEventArgs](OnFailuresProcessing)\r\n\t2-Subscription and unsub in external event.\r\n\t\tuiapp.Application.FailuresProcessing += failureProc\r\n\t\t#Transaction goes here.\r\n\t\tuiapp.Application.FailuresProcessing -= failureProc\t\t\r\n\"\"\"\r\n\r\n################################\r\n\r\n#MAIN. Main thread. Only shows the main window.\r\n\r\n################################\r\n\r\n#Basic variables if preview info in window required, like sheets or views to select.\r\n#doc = DocumentManager.Instance.CurrentDBDocument\r\n#uiapp = DocumentManager.Instance.CurrentUIApplication\r\n#uidoc = uiapp.ActiveUIDocument\r\n\r\n#Create external event instance.\r\nevent_hnd = myExternalEvent()\r\next_event = ExternalEvent.Create(event_hnd)\r\n\r\n#Create and show main window. Pass ext. event and any other preview info.\r\nglobal mainWindow\r\nmainWindow = MainWindow(ext_event)\r\nmainWindow.Show()\r\n\r\nOUT = 0\r\n\r\n#Python Template by Nonica.io\r\n\r\n################################\r\n\r\n#LICENSE PYTHON TEMPLATE. \r\n\t#You are free to:\r\n    \t#Share — copy and redistribute the material in any medium or format.\r\n        #Adapt — remix, transform, and build upon the material.\r\n\t#You cannot:\r\n    \t#NonCommercial — Sell or re-sell the material.\r\n        #Remove licensing or attributions Nonica\r\n\r\n################################\r\n\"\"\"\r\nCC Attribution-NonCommercial-ShareAlike 4.0 International\r\n\r\nBy exercising the Licensed Rights (defined below), You accept and agree to be bound by the terms and conditions of this Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International Public License (\"Public License\"). To the extent this Public License may be interpreted as a contract, You are granted the Licensed Rights in consideration of Your acceptance of these terms and conditions, and the Licensor grants You such rights in consideration of benefits the Licensor receives from making the Licensed Material available under these terms and conditions.\r\n\r\nSection 1 – Definitions.\r\nAdapted Material means material subject to Copyright and Similar Rights that is derived from or based upon the Licensed Material and in which the Licensed Material is translated, altered, arranged, transformed, or otherwise modified in a manner requiring permission under the Copyright and Similar Rights held by the Licensor. For purposes of this Public License, where the Licensed Material is a musical work, performance, or sound recording, Adapted Material is always produced where the Licensed Material is synched in timed relation with a moving image.\r\nAdapter's License means the license You apply to Your Copyright and Similar Rights in Your contributions to Adapted Material in accordance with the terms and conditions of this Public License.\r\nBY-NC-SA Compatible License means a license listed at creativecommons.org/compatiblelicenses , approved by Creative Commons as essentially the equivalent of this Public License.\r\nCopyright and Similar Rights means copyright and/or similar rights closely related to copyright including, without limitation, performance, broadcast, sound recording, and Sui Generis Database Rights, without regard to how the rights are labeled or categorized. For purposes of this Public License, the rights specified in Section 2(b)(1)-(2) are not Copyright and Similar Rights.\r\nEffective Technological Measur