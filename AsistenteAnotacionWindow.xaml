<Window x:Class="RevitToSupabasePlugin.AsistenteAnotacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📐 Asistente de Anotación &amp; Gráficos | ARCA REVIEW"
        Height="680" Width="960"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4"
        Foreground="#1C1C19"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0DCD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0F4369"/>
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LaunchButton" TargetType="Button">
            <Setter Property="Background" Value="#0F4369"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Background="#0F4369" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📐 ASISTENTE DE ANOTACIÓN, GRÁFICOS &amp; ENTREGAS" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Centro unificado de producción gráfica, ambientación de vistas, detalles constructivos y gestión masiva de nomenclaturas" FontSize="12" Foreground="#D1E4F9" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1B5E8C" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="ARCA REVIEW BIM" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Border>
            </Grid>
        </Border>

        <!-- RESUMEN DEL MODELO -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E0DCD5" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtProjectName" Text="Proyecto: ..." FontSize="13" FontWeight="Bold" Foreground="#1C1C19"/>
                    <TextBlock x:Name="txtDocTitle" Text="Archivo: ..." FontSize="11" Foreground="#72777F"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="#EAE5DC" BorderThickness="1,0,0,0" Margin="14,0" Padding="14,0">
                    <StackPanel>
                        <TextBlock Text="LÁMINAS / SHEETS" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                        <TextBlock x:Name="txtKpiSheets" Text="--" FontSize="16" FontWeight="Bold" Foreground="#1C1C19"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="#EAE5DC" BorderThickness="1,0,0,0" Margin="0,0,14,0" Padding="14,0">
                    <StackPanel>
                        <TextBlock Text="FAMILIAS CARGADAS" FontSize="10" FontWeight="Bold" Foreground="#0F4369"/>
                        <TextBlock x:Name="txtKpiFamilies" Text="--" FontSize="16" FontWeight="Bold" Foreground="#1C1C19"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" BorderBrush="#EAE5DC" BorderThickness="1,0,0,0" Padding="14,0">
                    <StackPanel>
                        <TextBlock Text="VISTAS DE DETALLE" FontSize="10" FontWeight="Bold" Foreground="#D97706"/>
                        <TextBlock x:Name="txtKpiDrafting" Text="--" FontSize="16" FontWeight="Bold" Foreground="#1C1C19"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- GRID DE LAS 4 HERRAMIENTAS PRINCIPALES -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MÓDULO 1: PLAN AMBIENTADOR -->
            <Border Grid.Row="0" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0DCD5" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🎨" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Plan Ambientador" FontSize="15" FontWeight="Bold" Foreground="#0F4369"/>
                            <TextBlock Text="Gráficos de Vista &amp; Entrega de Alto Nivel" FontSize="11" Foreground="#72777F"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Configura en un solo clic sombras ambientales, siluetas gruesas de corte, líneas de boceto (croquis), esquemas de color arquitectónicos y plantillas de presentación visual." FontSize="11" Foreground="#555550" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button Grid.Row="2" Content="🎨 Abrir Plan Ambientador" Style="{StaticResource LaunchButton}" Click="BtnOpenAmbientador_Click"/>
                </Grid>
            </Border>

            <!-- MÓDULO 2: GESTOR DE DETALLES -->
            <Border Grid.Row="0" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E0DCD5" BorderThickness="1" CornerRadius="8" Padding="18" Margin="10,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📐" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Gestor de Detalles Constructivos" FontSize="15" FontWeight="Bold" Foreground="#0F4369"/>
                            <TextBlock Text="Detalles 2D/3D &amp; Drafting Views Estándar" FontSize="11" Foreground="#72777F"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Administra la biblioteca corporativa de detalles constructivos, crea e inserta vistas de diseño (Drafting Views), componentes de detalle y leyendas con trazabilidad estándar." FontSize="11" Foreground="#555550" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button Grid.Row="2" Content="📐 Abrir Gestor de Detalles" Style="{StaticResource LaunchButton}" Click="BtnOpenDetalles_Click"/>
                </Grid>
            </Border>

            <!-- MÓDULO 3: RENOMBRADOR DE FAMILIAS (Family Revisor) -->
            <Border Grid.Row="1" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0DCD5" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,10,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🏷️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Renombrador Masivo de Familias" FontSize="15" FontWeight="Bold" Foreground="#0F4369"/>
                            <TextBlock Text="Nomenclatura BEP / Estándar (Family Revisor)" FontSize="11" Foreground="#72777F"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Búsqueda y reemplazo masivo de nombres de familias y tipos por categoría, adición de prefijos/sufijos y conversión instantánea a MAYÚSCULAS o formato título." FontSize="11" Foreground="#555550" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button Grid.Row="2" Content="🏷️ Abrir Family Revisor" Style="{StaticResource LaunchButton}" Background="#059669" Click="BtnOpenFamilyRevisor_Click"/>
                </Grid>
            </Border>

            <!-- MÓDULO 4: RENOMBRADOR DE SHEETS (ProSheets) -->
            <Border Grid.Row="1" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E0DCD5" BorderThickness="1" CornerRadius="8" Padding="18" Margin="10,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📑" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Renombrador Masivo de Sheets" FontSize="15" FontWeight="Bold" Foreground="#0F4369"/>
                            <TextBlock Text="Renumeración &amp; Nomenclatura (ProSheets)" FontSize="11" Foreground="#72777F"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Renumera planos correlativamente con ceros a la izquierda (001, 101), gestiona prefijos de disciplina, busca y reemplaza títulos sin riesgo de conflictos de números duplicados." FontSize="11" Foreground="#555550" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button Grid.Row="2" Content="📑 Abrir ProSheets" Style="{StaticResource LaunchButton}" Background="#0284C7" Click="BtnOpenSheetRevisor_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- PIE -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="ARCA REVIEW Suite de Anotación y Producción Gráfica" FontSize="11" Foreground="#72777F" VerticalAlignment="Center"/>
            <Button Content="Cerrar" HorizontalAlignment="Right" Padding="14,6" Background="#F6F3EE" BorderBrush="#D0CBC2" BorderThickness="1" Foreground="#1C1C19" Cursor="Hand" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
