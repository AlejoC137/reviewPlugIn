<Window x:Class="RevitToSupabasePlugin.ManualAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📘 Manual Técnico &amp; Mapa de la App | ARCA REVIEW" 
        Height="580" Width="880"
        MinHeight="450" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4"
        Foreground="#1C1C19"
        FontFamily="Segoe UI">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F6F3EE" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="📘 Manual Técnico, Mapa de Estado &amp; Exportador de Contexto IA" FontSize="15" FontWeight="Bold" Foreground="#0F4369"/>
                    <TextBlock Text="Documentación técnica y mapa de arquitectura para análisis de Inteligencia Artificial." FontSize="11" Foreground="#72777F" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- ACTION BUTTONS TOOLBAR -->
                <WrapPanel Grid.Row="1">
                    <Button x:Name="btnCopyContext" Click="BtnCopyContext_Click" Content="🗺️ Contexto IA (JSON)" Background="#0F4369" Foreground="#FFFFFF" FontWeight="Bold" Padding="8,4" Margin="0,0,6,4" Cursor="Hand" BorderBrush="#0F4369" BorderThickness="1" FontSize="11"/>
                    <Button x:Name="btnCopyDocs" Click="BtnCopyDocs_Click" Content="📋 Copiar Docs (.md)" Background="#137333" Foreground="#FFFFFF" FontWeight="Bold" Padding="8,4" Margin="0,0,6,4" Cursor="Hand" BorderBrush="#137333" BorderThickness="1" FontSize="11"/>
                    <Button x:Name="btnCopyCode" Click="BtnCopyCode_Click" Content="💻 Copiar Todo el Código" Background="#F6F3EE" Foreground="#1C1C19" FontWeight="Bold" Padding="8,4" Margin="0,0,6,4" Cursor="Hand" BorderBrush="#1C1C19" BorderThickness="1" FontSize="11"/>
                    <Button x:Name="btnExportZip" Click="BtnExportZip_Click" Content="📦 Exportar ZIP" Background="#0F4369" Foreground="#FFFFFF" FontWeight="Bold" Padding="8,4" Margin="0,0,6,4" Cursor="Hand" BorderBrush="#0F4369" BorderThickness="1" FontSize="11"/>
                    <Button x:Name="btnOpenMarkdown" Click="BtnOpenMarkdown_Click" Content="📄 Abrir .md" Background="#F6F3EE" Foreground="#0F4369" FontWeight="SemiBold" Padding="8,4" Margin="0,0,6,4" Cursor="Hand" BorderBrush="#0F4369" BorderThickness="1" FontSize="11"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY WITH TAB CONTROL -->
        <Grid Grid.Row="1">
            <TabControl Background="#FFFFFF" BorderBrush="#1C1C19" BorderThickness="1" Padding="10">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#F6F3EE"/>
                        <Setter Property="Foreground" Value="#72777F"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderBrush" Value="#E5E2DD"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#0F4369"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="#1C1C19"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: MAPA DE ARQUITECTURA E IA CONTEXT -->
                <TabItem Header="🗺️ Mapa de Estado (IA Context)">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="📌 Mapa de Contexto Estructurado (JSON Schema para LLM)" FontSize="15" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtJsonContext" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="#FCF9F4" Foreground="#1C1C19" Padding="10" Height="220" BorderThickness="1" BorderBrush="#1C1C19"/>
                            
                            <TextBlock Text="📊 Matriz de Componentes y Responsabilidades" FontSize="15" FontWeight="Bold" Foreground="#0F4369" Margin="0,20,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#1C1C19" LineHeight="20">
                                • App.cs: Registro de pestaña Ribbon 📕 Review y botones.<LineBreak/>
                                • Command.cs: Entrada para Metadata Exporter, Generador IA y Schedules.<LineBreak/>
                                • CommandConvertirMurosALadrillos.cs: Algoritmo de aparejo y extrusión 3D de mortero.<LineBreak/>
                                • CommandGenerarFamiliasLadrillo.cs: Creación y edición de familias RFA.<LineBreak/>
                                • CommandCargarPlantillaRiego.cs: Importación de cotización JSON y modelado MEP.<LineBreak/>
                                • MetadataExporterService.cs: Extracción de geometría, niveles y exportación JSON 3D.<LineBreak/>
                                • SupabaseService.cs: Sincronización REST y autenticación JWT en PostgreSQL Cloud.<LineBreak/>
                                • SharedParameterHelper.cs: Enlace automático de parámetros compartidos en Revit.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: VISTA PREVIA DEL CÓDIGO CONCATENADO -->
                <TabItem Header="💻 Vista Previa del Código Completo">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="💻 Código Fuente Completo Unificado (C#, XAML, Configs):" FontSize="14" FontWeight="Bold" Foreground="#0F4369" Margin="5,5,5,10"/>
                        <TextBox Grid.Row="1" x:Name="txtFullCodePreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#FCF9F4" Foreground="#1C1C19" Padding="10" BorderThickness="1" BorderBrush="#1C1C19"/>
                    </Grid>
                </TabItem>

                <!-- TAB 3: ALBAÑILERÍA -->
                <TabItem Header="🧱 Albañilería 3D">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="🧱 Módulo de Albañilería y Familias de Ladrillos" FontSize="15" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#1C1C19" LineHeight="20">
                                <Bold Foreground="#0F4369">Propósito:</Bold> Transforma muros simples de Revit en piezas individuales de ladrillo RFA y calcula mortero genérico 3D mediante DirectShapeType.<LineBreak/><LineBreak/>
                                <Bold Foreground="#0F4369">Reglas Técnicas Clave:</Bold><LineBreak/>
                                1. <Bold>Pre-corte en Perfil 2D:</Bold> Sustrae huecos de canchas y dovelas en 2D antes de extruir en 3D para evitar fallos de sólidos disjuntos.<LineBreak/>
                                2. <Bold>DirectShapeType:</Bold> Habilita la edición de propiedades ('Edit Type') en Revit.<LineBreak/>
                                3. <Bold>Autocentrado por BoundingBoxXYZ:</Bold> Desplaza instancias de ladrillo al centro geométrico del muro.<LineBreak/>
                                4. <Bold>Parseo Numérico Seguro:</Bold> Soporta comas ',' y puntos '.' intercambiables.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 4: RIEGO -->
                <TabItem Header="💧 Sistema de Riego">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="💧 Módulo de Instalaciones de Riego" FontSize="15" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#1C1C19" LineHeight="20">
                                <Bold Foreground="#0F4369">Propósito:</Bold> Lee cotizaciones de catálogo (RainBird / Evans) en JSON y genera redes MEP completas de riego.<LineBreak/><LineBreak/>
                                <Bold Foreground="#0F4369">Funcionalidades:</Bold><LineBreak/>
                                • Carga automática de familias RFA desde la carpeta FamiliasRiego/.<LineBreak/>
                                • Modelado de tuberías PE de 16mm con conectores e iteración de fittings (Tees y Codos).<LineBreak/>
                                • Asignación de caudales (LPH/GPH) a nebulizadores Naan GreenMist y goteros Xeri-Bug.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 5: METADATA & IFC -->
                <TabItem Header="📊 Exportador Metadata &amp; IFC">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="📊 Módulo Exportador de Metadata, IFC/JSON y Web3D" FontSize="15" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#1C1C19" LineHeight="20">
                                <Bold Foreground="#0F4369">Propósito:</Bold> Extrae la estructura paramétrica y geométrica del modelo para exportación web y nube.<LineBreak/><LineBreak/>
                                <Bold Foreground="#0F4369">Capacidades:</Bold><LineBreak/>
                                • Extracción limpia con FilteredElementCollector sin recargar memoria.<LineBreak/>
                                • Generación de mallas Web3D (vértices e índices) para visores Three.js/Xeokit.<LineBreak/>
                                • Integración de habitaciones (Rooms), cuadros de superficies y tablas Schedules.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 6: CONFIGURADOR IA -->
                <TabItem Header="🤖 Configurador IA &amp; Schedules">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="🤖 Módulo Configurador IA de Plantillas y Schedules" FontSize="15" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#1C1C19" LineHeight="20">
                                <Bold Foreground="#0F4369">Propósito:</Bold> Estandariza la representación gráfica y presupuestaria en Revit.<LineBreak/><LineBreak/>
                                <Bold Foreground="#0F4369">Componentes:</Bold><LineBreak/>
                                • ParameterFilterElement: Genera filtros visuales por regla de parámetro.<LineBreak/>
                                • ViewSchedule Builder: Inserta campos de cuantificación de forma automatizada.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 7: SUPABASE CLOUD -->
                <TabItem Header="☁️ Supabase Cloud Sync">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="☁️ Módulo de Sincronización Supabase Cloud" FontSize="15" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#1C1C19" LineHeight="20">
                                <Bold Foreground="#0F4369">Propósito:</Bold> Conecta Revit con bases de datos PostgreSQL en la nube.<LineBreak/><LineBreak/>
                                <Bold Foreground="#0F4369">Seguridad y Protocolos:</Bold><LineBreak/>
                                • Autenticación JWT OAuth con SupabaseAuthService.<LineBreak/>
                                • Peticiones HTTP REST (GET, POST, PATCH) para sincronizar materiales y proyectos.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#F6F3EE" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="lblStatus" Text="Documentación y herramientas de exportación listas. Usa la barra superior para copiar o exportar en ZIP." Foreground="#72777F" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
