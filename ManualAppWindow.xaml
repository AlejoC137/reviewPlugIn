<Window x:Class="RevitToSupabasePlugin.ManualAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📘 Manual Técnico &amp; Exportador de Código IA - reviewPlugIn" 
        Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#181825"
        Foreground="#CDD6F4">
    <Window.Resources>
        <!-- Style ScrollViewer -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E2E"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="📘 Manual Técnico, Mapa de Estado &amp; Exportador de Código para IA" FontSize="20" FontWeight="Bold" Foreground="#89B4FA"/>
                    <TextBlock Text="Copia la documentación completa, el código fuente o exporta un ZIP preparado para análisis de Inteligencia Artificial." FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ACTION BUTTONS TOOLBAR -->
                <WrapPanel Grid.Row="1">
                    <Button x:Name="btnCopyContext" Click="BtnCopyContext_Click" Content="🗺️ Contexto IA (JSON)" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="10,6" Margin="0,0,8,6" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnCopyDocs" Click="BtnCopyDocs_Click" Content="📋 Copiar Docs (.md)" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Padding="10,6" Margin="0,0,8,6" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnCopyCode" Click="BtnCopyCode_Click" Content="💻 Copiar Todo el Código" Background="#FAB387" Foreground="#11111B" FontWeight="Bold" Padding="10,6" Margin="0,0,8,6" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnExportZip" Click="BtnExportZip_Click" Content="📦 Exportar Proyecto ZIP" Background="#CBA6F7" Foreground="#11111B" FontWeight="Bold" Padding="10,6" Margin="0,0,8,6" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnOpenMarkdown" Click="BtnOpenMarkdown_Click" Content="📄 Abrir .md en Sistema" Background="#313244" Foreground="#CDD6F4" FontWeight="SemiBold" Padding="10,6" Margin="0,0,8,6" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY WITH TAB CONTROL -->
        <Grid Grid.Row="1">
            <TabControl Background="#1E1E2E" BorderThickness="0" Padding="10">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#181825"/>
                        <Setter Property="Foreground" Value="#BAC2DE"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: MAPA DE ARQUITECTURA E IA CONTEXT -->
                <TabItem Header="🗺️ Mapa de Estado (IA Context)">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="📌 Mapa de Contexto Estructurado (JSON Schema para LLM)" FontSize="16" FontWeight="Bold" Foreground="#F9E2AF" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtJsonContext" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="#11111B" Foreground="#A6E3A1" Padding="10" Height="220" BorderThickness="1" BorderBrush="#313244"/>
                            
                            <TextBlock Text="📊 Matriz de Componentes y Responsabilidades" FontSize="16" FontWeight="Bold" Foreground="#F9E2AF" Margin="0,20,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#CDD6F4" LineHeight="20">
                                • App.cs: Registro de pestaña Ribbon 📕 Review y botones.<LineBreak/>
                                • Command.cs: Entrada para Metadata Exporter, Generador IA y Schedules.<LineBreak/>
                                • CommandConvertirMurosALadrillos.cs: Algoritmo de aparejo y extrusión 3D de mortero.<LineBreak/>
                                • CommandGenerarFamiliasLadrillo.cs: Creación y edición de familias RFA.<LineBreak/>
                                • CommandCargarPlantillaRiego.cs: Importación de cotización JSON y modelado MEP.<LineBreak/>
                                • MetadataExporterService.cs: Extracción de geometría, niveles y exportación JSON 3D.<LineBreak/>
                                • SupabaseService.cs: Sincronización REST y autenticación JWT en PostgreSQL Cloud.<LineBreak/>
                                • SharedParameterHelper.cs: Enlace automático de parámetros compartidos en Revit.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: VISTA PREVIA DEL CÓDIGO CONCATENADO -->
                <TabItem Header="💻 Vista Previa del Código Completo">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="💻 Código Fuente Completo Unificado (C#, XAML, Configs):" FontSize="14" FontWeight="Bold" Foreground="#FAB387" Margin="5,5,5,10"/>
                        <TextBox Grid.Row="1" x:Name="txtFullCodePreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#11111B" Foreground="#CDD6F4" Padding="10" BorderThickness="1" BorderBrush="#313244"/>
                    </Grid>
                </TabItem>

                <!-- TAB 3: ALBAÑILERÍA -->
                <TabItem Header="🧱 Albañilería 3D">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="🧱 Módulo de Albañilería y Familias de Ladrillos" FontSize="16" FontWeight="Bold" Foreground="#FAB387" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#CDD6F4" LineHeight="20">
                                <Bold Foreground="#89B4FA">Propósito:</Bold> Transforma muros simples de Revit en piezas individuales de ladrillo RFA y calcula mortero genérico 3D mediante DirectShapeType.<LineBreak/><LineBreak/>
                                <Bold Foreground="#89B4FA">Reglas Técnicas Clave:</Bold><LineBreak/>
                                1. <Bold>Pre-corte en Perfil 2D:</Bold> Sustrae huecos de canchas y dovelas en 2D antes de extruir en 3D para evitar fallos de sólidos disjuntos.<LineBreak/>
                                2. <Bold>DirectShapeType:</Bold> Habilita la edición de propiedades ('Edit Type') en Revit.<LineBreak/>
                                3. <Bold>Autocentrado por BoundingBoxXYZ:</Bold> Desplaza instancias de ladrillo al centro geométrico del muro.<LineBreak/>
                                4. <Bold>Parseo Numérico Seguro:</Bold> Soporta comas ',' y puntos '.' intercambiables.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 4: RIEGO -->
                <TabItem Header="💧 Sistema de Riego">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="💧 Módulo de Instalaciones de Riego" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#CDD6F4" LineHeight="20">
                                <Bold Foreground="#89B4FA">Propósito:</Bold> Lee cotizaciones de catálogo (RainBird / Evans) en JSON y genera redes MEP completas de riego.<LineBreak/><LineBreak/>
                                <Bold Foreground="#89B4FA">Funcionalidades:</Bold><LineBreak/>
                                • Carga automática de familias RFA desde la carpeta FamiliasRiego/.<LineBreak/>
                                • Modelado de tuberías PE de 16mm con conectores e iteración de fittings (Tees y Codos).<LineBreak/>
                                • Asignación de caudales (LPH/GPH) a nebulizadores Naan GreenMist y goteros Xeri-Bug.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 5: METADATA & IFC -->
                <TabItem Header="📊 Exportador Metadata &amp; IFC">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="📊 Módulo Exportador de Metadata, IFC/JSON y Web3D" FontSize="16" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#CDD6F4" LineHeight="20">
                                <Bold Foreground="#89B4FA">Propósito:</Bold> Extrae la estructura paramétrica y geométrica del modelo para exportación web y nube.<LineBreak/><LineBreak/>
                                <Bold Foreground="#89B4FA">Capacidades:</Bold><LineBreak/>
                                • Extracción limpia con FilteredElementCollector sin recargar memoria.<LineBreak/>
                                • Generación de mallas Web3D (vértices e índices) para visores Three.js/Xeokit.<LineBreak/>
                                • Integración de habitaciones (Rooms), cuadros de superficies y tablas Schedules.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 6: CONFIGURADOR IA -->
                <TabItem Header="🤖 Configurador IA &amp; Schedules">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="🤖 Módulo Configurador IA de Plantillas y Schedules" FontSize="16" FontWeight="Bold" Foreground="#CBA6F7" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#CDD6F4" LineHeight="20">
                                <Bold Foreground="#89B4FA">Propósito:</Bold> Estandariza la representación gráfica y presupuestaria en Revit.<LineBreak/><LineBreak/>
                                <Bold Foreground="#89B4FA">Componentes:</Bold><LineBreak/>
                                • ParameterFilterElement: Genera filtros visuales por regla de parámetro.<LineBreak/>
                                • ViewSchedule Builder: Inserta campos de cuantificación de forma automatizada.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 7: SUPABASE CLOUD -->
                <TabItem Header="☁️ Supabase Cloud Sync">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <TextBlock Text="☁️ Módulo de Sincronización Supabase Cloud" FontSize="16" FontWeight="Bold" Foreground="#F5E0DC" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#CDD6F4" LineHeight="20">
                                <Bold Foreground="#89B4FA">Propósito:</Bold> Conecta Revit con bases de datos PostgreSQL en la nube.<LineBreak/><LineBreak/>
                                <Bold Foreground="#89B4FA">Seguridad y Protocolos:</Bold><LineBreak/>
                                • Autenticación JWT OAuth con SupabaseAuthService.<LineBreak/>
                                • Peticiones HTTP REST (GET, POST, PATCH) para sincronizar materiales y proyectos.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="8" Padding="10,6" Margin="0,15,0,0">
            <Grid>
                <TextBlock x:Name="lblStatus" Text="Documentación y herramientas de exportación listas. Usa la barra superior para copiar o exportar en ZIP." Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
