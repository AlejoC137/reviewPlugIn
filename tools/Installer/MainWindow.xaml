<Window x:Class="ArcaReviewInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador de ARCA REVIEW para Revit"
        Height="590" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo Boton Primario -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Boton Secundario -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Alerta si Revit esta abierto -->
            <RowDefinition Height="Auto"/> <!-- Versiones seleccionables -->
            <RowDefinition Height="Auto"/> <!-- Botones principales -->
            <RowDefinition Height="*"/>    <!-- Log / Progreso -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,14" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ARCA REVIEW" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#0EA5E9" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="REVIT ADDIN" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Instalador y actualizador automático para Autodesk Revit" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="v2026.1" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Alerta Revit Abierto -->
        <Border x:Name="RevitWarningBorder" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,16" Padding="12,10" Background="#451A03" BorderBrush="#D97706" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ " FontSize="14"/>
                    <TextBlock Text="Revit está actualmente abierto. Cierra Revit antes de instalar para evitar bloqueos." FontSize="12" Foreground="#FDE68A" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Verificar de nuevo" Click="CheckRevitProcess_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Versiones -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="16,12" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Selecciona las versiones de Revit donde instalar:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                <WrapPanel x:Name="VersionWrapPanel" Orientation="Horizontal">
                    <!-- Checkboxes generados dinamicamente o predefinidos -->
                    <CheckBox x:Name="Chk2025" Content="Revit 2025" Foreground="#F8FAFC" FontSize="13" Margin="0,0,20,0" IsChecked="True"/>
                    <CheckBox x:Name="Chk2026" Content="Revit 2026" Foreground="#F8FAFC" FontSize="13" Margin="0,0,20,0"/>
                    <CheckBox x:Name="Chk2027" Content="Revit 2027" Foreground="#F8FAFC" FontSize="13" Margin="0,0,20,0" IsChecked="True"/>
                    <CheckBox x:Name="Chk2024" Content="Revit 2024" Foreground="#F8FAFC" FontSize="13" Margin="0,0,20,0"/>
                </WrapPanel>
                <TextBlock x:Name="DetectionNoticeText" Text="Detectando carpetas de Revit instaladas..." FontSize="11" Foreground="#38BDF8" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Botones de Acción -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnInstall" Grid.Column="0" Content="🚀 Instalar / Actualizar ARCA REVIEW" Style="{StaticResource PrimaryButtonStyle}" Click="BtnInstall_Click"/>
            <Button x:Name="BtnUninstall" Grid.Column="1" Content="🗑️ Desinstalar" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="BtnUninstall_Click"/>
            <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="📂 Ver Carpeta Addins" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="BtnOpenFolder_Click"/>
        </Grid>

        <!-- Progreso y Registro -->
        <Border Grid.Row="4" Background="#020617" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ProgressBar x:Name="InstallProgressBar" Grid.Row="0" Height="6" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Margin="0,0,0,8" Value="0" Maximum="100"/>

                <TextBox x:Name="LogTextBox" Grid.Row="1" 
                         Background="Transparent" 
                         Foreground="#94A3B8" 
                         BorderThickness="0" 
                         FontFamily="Consolas" 
                         FontSize="11" 
                         IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" 
                         TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="ARCA REVIEW Plugin Installer • Compatible con Revit 2024 - 2027" FontSize="11" Foreground="#475569" HorizontalAlignment="Left"/>
            <TextBlock Text="Desarrollado por Alejandro" FontSize="11" Foreground="#475569" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
