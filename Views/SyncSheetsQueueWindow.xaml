<Window x:Class="reviewPlugIn.Views.SyncSheetsQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REVIEW BIM — Gestor de Cambios (Cola de Cambios desde la App)"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4"
        Foreground="#1C1C19"
        FontFamily="Segoe UI, Inter, sans-serif">

    <Window.Resources>
        <!-- ARCA Palette & Control Styles -->
        <Style x:Key="ArcaPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0F4369"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1C1C19"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArcaSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E2DD"/>
                                <Setter Property="Foreground" Value="#0F4369"/>
                                <Setter Property="BorderBrush" Value="#0F4369"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bulletproof ARCA ComboBox for Dialogs -->
        <ControlTemplate x:Key="DialogComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="#FFFFFF" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#0F4369"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#0F4369"/>
                    <Setter TargetName="ToggleBorder" Property="Background" Value="#F6F3EE"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DialogArcaComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#1C1C19"/>
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#D1E4F9"/>
                                            <Setter Property="Foreground" Value="#0F4369"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0F4369"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DialogComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,24,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1C1C19"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="220">
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#1C1C19"
                                            BorderThickness="1"
                                            Margin="0,1,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" Color="#1C1C19" Opacity="0.15"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER (ARCA Technical Container) -->
        <Border Grid.Row="0" Background="#F6F3EE" CornerRadius="0" Padding="16,12" Margin="0,0,0,12" BorderBrush="#1C1C19" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📋 GESTOR DE CAMBIOS (REVIEW APP ➔ REVIT)" FontSize="14" FontWeight="Bold" Foreground="#0F4369"/>
                    <TextBlock Text="Revisión e implementación controlada de cambios propuestos desde la App Review. Nada es automático: audita cada cambio antes de aplicarlo." FontSize="10" Foreground="#5A5D62" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtActiveDocument" Text="Documento Revit: Cargando..." FontSize="11" Foreground="#72777F" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefreshQueue" Content="🔄 Recargar Cola" Click="BtnRefreshQueue_Click"
                            Style="{StaticResource ArcaSecondaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSelectAll" Content="☑ Selec. Todo" Click="BtnSelectAll_Click"
                            Style="{StaticResource ArcaSecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SELECTOR DE COLA -->
        <Border Grid.Row="1" Background="#F6F3EE" CornerRadius="0" Padding="14,10" Margin="0,0,0,12" BorderBrush="#1C1C19" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Lote / Solicitud de Cambios:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1C1C19" Margin="0,0,12,0"/>
                <ComboBox x:Name="CmbQueues" Grid.Column="1" SelectionChanged="CmbQueues_SelectionChanged"
                          Style="{StaticResource DialogArcaComboBox}"
                          DisplayMemberPath="DisplayTitle" Height="30" VerticalContentAlignment="Center"/>
                <Border Grid.Column="2" Background="#D1FAE5" BorderBrush="#059669" BorderThickness="1" Padding="8,4" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtQueueSummaryBadge" Text="0 cambios" FontWeight="Bold" Foreground="#065F46" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <!-- TABLA DE CAMBIOS PROPUESTOS -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="0" Padding="10" BorderBrush="#1C1C19" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CAMBIOS PROPUESTOS DESDE LA APP (Desmarca los que no desees aplicar)"
                               FontSize="11" FontWeight="Bold" Foreground="#0F4369" Margin="4,0,0,8"/>

                    <DataGrid x:Name="GridChanges"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="#FFFFFF"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F6F3EE"
                              Foreground="#1C1C19"
                              BorderThickness="1"
                              BorderBrush="#C2C7CF"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E2DD"
                              HeadersVisibility="Column"
                              RowHeight="32">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F6F3EE"/>
                                <Setter Property="Foreground" Value="#0F4369"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#1C1C19"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Numeración (Actual ➔ Nuevo)" Binding="{Binding NumberChangeSummary}" IsReadOnly="True" Width="170"/>
                            <DataGridTextColumn Header="Nombre del Plano (Actual ➔ Nuevo)" Binding="{Binding NameChangeSummary}" IsReadOnly="True" Width="280"/>
                            <DataGridTextColumn Header="Categoría / Colección" Binding="{Binding CollectionChangeSummary}" IsReadOnly="True" Width="190"/>
                            <DataGridTextColumn Header="Propiedades / Orden" Binding="{Binding PropertiesSummary}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- NUEVOS PLANOS A CREAR (SI HAY EN COLA) -->
            <Border x:Name="BorderNewSheets" Grid.Row="1" Background="#FFFFFF" CornerRadius="0" Padding="10" Margin="0,10,0,0" BorderBrush="#1C1C19" BorderThickness="1" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="➕ NUEVOS PLANOS EN COLA PARA CREAR AUTOMÁTICAMENTE" FontSize="11" FontWeight="Bold" Foreground="#059669" Margin="4,0,0,6"/>
                    <DataGrid x:Name="GridNewSheets"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              MaxHeight="130"
                              Background="#FFFFFF"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F6F3EE"
                              Foreground="#1C1C19"
                              BorderThickness="1"
                              BorderBrush="#C2C7CF"
                              HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F6F3EE"/>
                                <Setter Property="Foreground" Value="#0F4369"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#1C1C19"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Crear" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Número" Binding="{Binding SheetNumber}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="Nombre del Plano" Binding="{Binding SheetName}" IsReadOnly="True" Width="280"/>
                            <DataGridTextColumn Header="Categoría / Colección" Binding="{Binding SheetCollection}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="Dibujó" Binding="{Binding DrawnBy}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="Revisó" Binding="{Binding CheckedBy}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- LOG DE ESTADO (Technical Console) -->
        <Border Grid.Row="3" Background="#1C1C19" CornerRadius="0" Padding="10,8" Margin="0,12,0,12" BorderBrush="#0F4369" BorderThickness="1">
            <TextBlock x:Name="TxtStatusLog" Text="Listo para verificar cambios en cola desde Supabase..."
                       FontFamily="Consolas, monospace" FontSize="11" Foreground="#E5E2DD" TextWrapping="Wrap"/>
        </Border>

        <!-- BOTONES DE ACCIÓN -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#72777F"
                       Text="Nota: La renumeración se ejecuta en 2 fases anti-colisión dentro de una Transacción de Revit."/>

            <Button Grid.Column="1" Content="Cancelar" Click="BtnClose_Click"
                    Style="{StaticResource ArcaSecondaryButton}" Padding="18,8" Margin="0,0,10,0"/>

            <Button x:Name="BtnApplyChanges" Grid.Column="2" Content="✅ CONFIRMAR Y APLICAR CAMBIOS EN REVIT"
                    Click="BtnApplyChanges_Click"
                    Style="{StaticResource ArcaPrimaryButton}" FontSize="12" Padding="20,9"/>
        </Grid>
    </Grid>
</Window>
