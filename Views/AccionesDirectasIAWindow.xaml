<Window x:Class="reviewPlugIn.Views.AccionesDirectasIAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCA REVIEW — ⚡ Acciones Directas de IA (Gemini ➔ Revit)"
        Height="760" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4"
        Foreground="#1C1C19"
        FontFamily="Segoe UI, Inter, sans-serif">

    <Window.Resources>
        <!-- ARCA Palette & Control Styles -->
        <Style x:Key="ArcaPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0F4369"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1C1C19"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArcaSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E2DD"/>
                                <Setter Property="Foreground" Value="#0F4369"/>
                                <Setter Property="BorderBrush" Value="#0F4369"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bulletproof ARCA ComboBox -->
        <ControlTemplate x:Key="DialogComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="#FFFFFF" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#0F4369"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#0F4369"/>
                    <Setter TargetName="ToggleBorder" Property="Background" Value="#F6F3EE"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DialogArcaComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#1C1C19"/>
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#D1E4F9"/>
                                            <Setter Property="Foreground" Value="#0F4369"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0F4369"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DialogComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,24,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="220">
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#1C1C19"
                                            BorderThickness="1"
                                            Margin="0,1,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" Color="#1C1C19" Opacity="0.15"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F6F3EE" CornerRadius="0" Padding="16,12" Margin="0,0,0,10" BorderBrush="#1C1C19" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="⚡ ACCIONES DIRECTAS DE IA (GEMINI ➔ REVIT)" FontSize="14" FontWeight="Bold" Foreground="#0F4369"/>
                    <TextBlock Text="Pega el bloque JSON generado por Gemini Desktop o Web. Audita y simula los cambios antes de aplicarlos en el modelo activo." FontSize="10" Foreground="#5A5D62" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtActiveDoc" Text="Documento Revit: Cargando..." FontSize="10.5" Foreground="#72777F" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCopyPrompt" Content="📘 Copiar Prompt para Gemini" Click="BtnCopyPrompt_Click"
                            Style="{StaticResource ArcaSecondaryButton}" Margin="0,0,8,0"
                            ToolTip="Copia las instrucciones y esquemas que debes pegar en Gemini para que genere JSONs válidos"/>
                    <Button x:Name="BtnPasteClipboard" Content="📋 Pegar del Portapapeles" Click="BtnPasteClipboard_Click"
                            Style="{StaticResource ArcaSecondaryButton}"
                            ToolTip="Pega el contenido del portapapeles directamente en el editor"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BARRA DE PLANTILLAS -->
        <Border Grid.Row="1" Background="#F6F3EE" CornerRadius="0" Padding="12,8" Margin="0,0,0,8" BorderBrush="#1C1C19" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Cargar Plantilla de Ejemplo:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1C1C19" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbTemplates" Grid.Column="1" SelectionChanged="CmbTemplates_SelectionChanged"
                          Style="{StaticResource DialogArcaComboBox}" Height="28"/>
                <Button Grid.Column="2" x:Name="BtnClearEditor" Content="🗑️ Limpiar" Click="BtnClearEditor_Click"
                        Style="{StaticResource ArcaSecondaryButton}" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- EDITOR DE JSON -->
        <Border Grid.Row="2" Background="#1C1C19" CornerRadius="0" Padding="8" BorderBrush="#0F4369" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="INSTRUCCIÓN JSON (Edita o pega aquí):" FontSize="9.5" FontWeight="Bold" Foreground="#8EB4D8" Margin="2,0,0,4"/>
                <TextBox Grid.Row="1" x:Name="TxtJsonEditor"
                         Background="Transparent" Foreground="#E5E2DD" BorderThickness="0"
                         FontFamily="Consolas, 'Courier New', monospace" FontSize="11"
                         AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </Grid>
        </Border>

        <!-- BARRA INTERMEDIA DE SIMULACIÓN -->
        <Grid Grid.Row="3" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnSimulate" Content="🔍 VALIDAR &amp; SIMULAR CAMBIOS" Click="BtnSimulate_Click"
                    Style="{StaticResource ArcaPrimaryButton}" Padding="16,7"/>
            <TextBlock Grid.Column="1" x:Name="TxtSimulationSummary" Text="Haz clic en 'Validar &amp; Simular' para revisar los elementos que se verán afectados sin modificar el modelo."
                       VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11" Foreground="#5A5D62"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnSelectAll" Content="☑ Marcar Todo" Click="BtnSelectAll_Click"
                        Style="{StaticResource ArcaSecondaryButton}" Margin="0,0,6,0"/>
                <Button x:Name="BtnDeselectAll" Content="☐ Desmarcar Todo" Click="BtnDeselectAll_Click"
                        Style="{StaticResource ArcaSecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- TABLA DE RESULTADOS DE SIMULACIÓN -->
        <Border Grid.Row="4" Background="#FFFFFF" CornerRadius="0" Padding="10" BorderBrush="#1C1C19" BorderThickness="1">
            <DataGrid x:Name="GridSimulation"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="#FFFFFF"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#F6F3EE"
                      Foreground="#1C1C19"
                      BorderThickness="1"
                      BorderBrush="#C2C7CF"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E5E2DD"
                      HeadersVisibility="Column"
                      RowHeight="28">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F6F3EE"/>
                        <Setter Property="Foreground" Value="#0F4369"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="10.5"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="BorderBrush" Value="#1C1C19"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                    <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="Nombre / Tipo" Binding="{Binding ElementName}" IsReadOnly="True" Width="200"/>
                    <DataGridTextColumn Header="Parámetro" Binding="{Binding ParameterName}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="Valor Actual" Binding="{Binding CurrentValue}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="Valor Destino (Nuevo)" Binding="{Binding TargetValue}" IsReadOnly="True" Width="160"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Status}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Detalle / Advertencia" Binding="{Binding Warning}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- LOG BAR -->
        <Border Grid.Row="5" Background="#1C1C19" CornerRadius="0" Padding="8,6" Margin="0,8,0,8" BorderBrush="#0F4369" BorderThickness="1">
            <TextBlock x:Name="TxtLogStatus" Text="Listo para pegar o escribir instrucciones JSON de IA..."
                       FontFamily="Consolas, monospace" FontSize="10.5" Foreground="#E5E2DD" TextWrapping="Wrap"/>
        </Border>

        <!-- FOOTER ACTIONS -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10.5" Foreground="#72777F"
                       Text="Nota: La ejecución se realiza en una Transacción única de Revit. Puedes deshacer los cambios con Ctrl+Z."/>

            <Button Grid.Column="1" Content="Cerrar" Click="BtnClose_Click"
                    Style="{StaticResource ArcaSecondaryButton}" Padding="18,8" Margin="0,0,10,0"/>

            <Button x:Name="BtnExecute" Grid.Column="2" Content="⚡ CONFIRMAR Y EJECUTAR EN REVIT" Click="BtnExecute_Click"
                    Style="{StaticResource ArcaPrimaryButton}" FontSize="11.5" Padding="20,9"/>
        </Grid>
    </Grid>
</Window>
