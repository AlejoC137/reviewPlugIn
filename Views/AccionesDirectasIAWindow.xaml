<Window x:Class="reviewPlugIn.Views.AccionesDirectasIAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCA Review — Receptor de Esquemas &amp; Acciones de Revit (JSON / Cloud)"
        Width="1040" Height="740"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="BorderBrush" Value="#C2C7CF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0F4369"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#062B49"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#C2C7CF"/>
                                <Setter Property="Foreground" Value="#72777F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EFECE7"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#72777F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="215"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0F4369" BorderBrush="#1C1C19" BorderThickness="2" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="⚡ RECEPTOR DE ESQUEMAS Y ACCIONES DE REVIT (JSON / CLOUD)"
                               Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Recibe esquemas jerárquicos o colas de acciones desde ARCA Review Web o IA, organízalos por procesos y ejecútalos sobre el modelo Revit activo."
                               Foreground="#D1E4F9" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnCopyPrompt"
                            Style="{StaticResource SecondaryButton}"
                            Background="#FACC15" Foreground="#1C1C19" BorderBrush="#1C1C19"
                            Content="🤖 Copiar Prompt IA (Esquema Revit)"
                            Margin="0,0,6,0"
                            Click="BtnCopyPrompt_Click"/>
                    <Button x:Name="btnLoadExample"
                            Style="{StaticResource SecondaryButton}"
                            Content="📄 Cargar Esquema Ejemplo"
                            Click="BtnLoadExample_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CLOUD SCHEMA LOADER BAR -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Background="#E0F2FE" BorderBrush="#0F4369" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="☁️ ESQUEMAS EN ARCA REVIEW CLOUD:"
                           FontWeight="Bold" FontSize="10.5" Foreground="#0F4369"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox x:Name="cmbCloudSchemas"
                          Grid.Column="1"
                          Height="28"
                          FontSize="11"
                          DisplayMemberPath="DisplayLabel"
                          Margin="0,0,8,0"/>

                <Button x:Name="btnRefreshCloudSchemas"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButton}"
                        Content="🔄 Actualizar Lista Cloud"
                        Padding="10,4" FontSize="10.5"
                        Margin="0,0,6,0"
                        Click="BtnRefreshCloudSchemas_Click"/>

                <Button x:Name="btnLoadSelectedCloudSchema"
                        Grid.Column="3"
                        Style="{StaticResource PrimaryButton}"
                        Content="📥 Cargar Esquema Seleccionado"
                        Padding="12,4" FontSize="10.5"
                        Click="BtnLoadSelectedCloudSchema_Click"/>
            </Grid>
        </Border>

        <!-- JSON INPUT AREA -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock x:Name="txtSchemaHeaderLabel"
                               Text="1. PEGAR JSON DE ESQUEMA O COLA DE ACCIONES REVIT (ACEPTA ÁRBOL JERÁRQUICO O LISTA DE ACCIONES)"
                               FontWeight="Bold" FontSize="10.5" Foreground="#0F4369" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnPasteClipboard"
                                Style="{StaticResource SecondaryButton}"
                                Content="📋 Pegar Portapapeles"
                                Padding="8,3" FontSize="10" Margin="0,0,6,0"
                                Click="BtnPasteClipboard_Click"/>
                        <Button x:Name="btnClearJson"
                                Style="{StaticResource SecondaryButton}"
                                Content="🗑️ Limpiar"
                                Padding="8,3" FontSize="10" Margin="0,0,6,0"
                                Click="BtnClearJson_Click"/>
                        <Button x:Name="btnSimulate"
                                Style="{StaticResource PrimaryButton}"
                                Content="🔍 2. Analizar Esquema y Simular en Modelo"
                                Padding="12,4" FontSize="10.5"
                                Click="BtnSimulate_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#1C1C19" BorderBrush="#0F4369" BorderThickness="1" Padding="6">
                    <TextBox x:Name="txtJsonInput"
                             Background="Transparent"
                             Foreground="#E5E2DD"
                             CaretBrush="#FFFFFF"
                             BorderThickness="0"
                             FontFamily="Consolas, monospace"
                             FontSize="11"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Border>

        <!-- TABS: ORGANIZED ACTIONS TABLE + EXECUTION LOGS -->
        <TabControl Grid.Row="3" Background="#F6F3EE" BorderBrush="#0F4369" BorderThickness="1" Margin="0,0,0,10">
            <!-- TAB 1: ACCIONES ORGANIZADAS POR PROCESO / RAMA -->
            <TabItem Header="⚡ Pestaña de Acciones y Procesos del Esquema" FontWeight="Bold">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="3. ACCIONES EXTRAÍDAS DEL ESQUEMA Y ELEMENTOS COINCIDENTES EN EL MODELO REVIT"
                                   FontWeight="Bold" FontSize="10.5" Foreground="#0F4369" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtSimSummary"
                                   Text="Esperando simulación..."
                                   HorizontalAlignment="Right"
                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#72777F"/>
                    </Grid>

                    <DataGrid x:Name="gridActions"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E2DD"
                              Background="#FFFFFF"
                              BorderBrush="#C2C7CF"
                              BorderThickness="1"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F9F7F3"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Ejecutar" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" IsReadOnly="True" Width="38"/>
                            <DataGridTextColumn Header="Rama / Proceso" Binding="{Binding ProcessBranch}" IsReadOnly="True" Width="150"/>
                            <DataGridTextColumn Header="Paso / Nodo del Esquema" Binding="{Binding StepName}" IsReadOnly="True" Width="170"/>
                            <DataGridTextColumn Header="Herramienta" Binding="{Binding EffectiveTool}" IsReadOnly="True" Width="125"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" IsReadOnly="True" Width="105"/>
                            <DataGridTextColumn Header="Filtro" Binding="{Binding FilterSummary}" IsReadOnly="True" Width="135"/>
                            <DataGridTextColumn Header="Coincidencias" Binding="{Binding MatchedCount}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Parámetros / Configuración" Binding="{Binding ParametersSummary}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding SimulationStatus}" IsReadOnly="True" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: REGISTRO DETALLADO DE EJECUCIÓN -->
            <TabItem Header="📜 Registro Técnico de Ejecución (Logs)" FontWeight="Bold">
                <Border Background="#1C1C19" BorderBrush="#0F4369" BorderThickness="1" Margin="8" Padding="8">
                    <TextBox x:Name="txtExecutionLogs"
                             Background="Transparent"
                             Foreground="#A7F3D0"
                             BorderThickness="0"
                             FontFamily="Consolas, monospace"
                             FontSize="11"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="Aquí se mostrará el detalle técnico tras ejecutar el esquema de acciones sobre el modelo Revit..."/>
                </Border>
            </TabItem>
        </TabControl>

        <!-- FOOTER / EXECUTION -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtFooterStatus"
                       Text="💡 Puedes pegar un Esquema JSON de ARCA Review o cargarlo desde la nube, simular y aplicar en 1 clic."
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#1C1C19"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cerrar"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="BtnClose_Click"/>

                <Button x:Name="btnExecute"
                        Style="{StaticResource PrimaryButton}"
                        Background="#059669"
                        BorderBrush="#065F46"
                        Content="⚡ 3. Ejecutar Esquema de Acciones en Revit"
                        IsEnabled="False"
                        Click="BtnExecute_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
