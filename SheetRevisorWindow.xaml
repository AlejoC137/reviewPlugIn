<Window x:Class="RevitToSupabasePlugin.SheetRevisorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📑 Gestor &amp; Renombrador Masivo de Sheets (ProSheets) | ARCA REVIEW"
        Height="780" Width="1080"
        MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4"
        Foreground="#1C1C19"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo Botón Primario (Navy) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F4369"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0F4369"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Éxito (Emerald) -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Secundario (Ivory) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0CBC2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAE5DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Card Border -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0DCD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#C4BFB6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#C4BFB6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Background="#0F4369" CornerRadius="6" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📑 GESTOR &amp; RENOMBRADOR MASIVO DE SHEETS" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Renumeración correlativa, prefijos, sufijos y nomenclatura de planos (Inspirado en ProSheets / SheetGen)" FontSize="12" Foreground="#D1E4F9" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1B5E8C" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="Módulo de Anotación &amp; Láminas" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </Border>
            </Grid>
        </Border>

        <!-- PANEL DE REGLAS DE RENOMBRAMIENTO DE SHEETS -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <StackPanel>
                <!-- Grupo 1: Reglas para Número de Lámina (Sheet Number) -->
                <TextBlock Text="🔢 REGLAS PARA NÚMERO DE LÁMINA (SHEET NUMBER)" FontSize="11" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Prefijo Número -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Prefijo:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNumPrefix" TextChanged="RulesChanged"/>
                    </StackPanel>

                    <!-- Sufijo Número -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Sufijo:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNumSuffix" TextChanged="RulesChanged"/>
                    </StackPanel>

                    <!-- Buscar en Número -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Buscar en Número:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNumFind" TextChanged="RulesChanged"/>
                    </StackPanel>

                    <!-- Reemplazar en Número -->
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Reemplazar con:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNumReplace" TextChanged="RulesChanged"/>
                    </StackPanel>

                    <!-- Renumeración Correlativa -->
                    <Border Grid.Column="4" Background="#F0F7FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <StackPanel>
                            <CheckBox x:Name="chkRenumber" Content="Renumerar Correlativamente" FontSize="11" FontWeight="Bold" Foreground="#0284C7" Checked="RulesChanged" Unchecked="RulesChanged"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Inicio:" FontSize="9" Foreground="#555550"/>
                                    <TextBox x:Name="txtNumStart" Text="101" TextChanged="RulesChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                    <TextBlock Text="Paso:" FontSize="9" Foreground="#555550"/>
                                    <TextBox x:Name="txtNumStep" Text="1" TextChanged="RulesChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dígitos:" FontSize="9" Foreground="#555550"/>
                                    <TextBox x:Name="txtNumDigits" Text="3" TextChanged="RulesChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Background="#EAE5DC" Margin="0,2,0,8"/>

                <!-- Grupo 2: Reglas para Nombre de Lámina (Sheet Name) -->
                <TextBlock Text="📝 REGLAS PARA NOMBRE DE LÁMINA (SHEET NAME)" FontSize="11" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Prefijo Nombre:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNamePrefix" TextChanged="RulesChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Sufijo Nombre:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNameSuffix" TextChanged="RulesChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Buscar en Nombre:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNameFind" TextChanged="RulesChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Reemplazar con:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNameReplace" TextChanged="RulesChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="Formato Texto:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbNameCase" SelectionChanged="RulesChanged">
                            <ComboBoxItem Content="Mantener Original" IsSelected="True"/>
                            <ComboBoxItem Content="MAYÚSCULAS"/>
                            <ComboBoxItem Content="minúsculas"/>
                            <ComboBoxItem Content="Formato Título"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                        <Button Content="🧹 Limpiar" Style="{StaticResource SecondaryButtonStyle}" Click="BtnResetRules_Click" ToolTip="Restablecer todas las reglas"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- DATA GRID DE SHEETS -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRA DE INSERCIÓN / DESPLAZAMIENTO EN CASCADA -->
                <Border Grid.Row="0" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="➕ INSERTAR / DESPLAZAR EN CASCADA (selecciona una lámina de referencia en la tabla)" FontSize="11" FontWeight="Bold" Foreground="#C2410C" Margin="0,0,0,6"/>
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,8,4">
                                <TextBlock Text="Nombre nueva lámina:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtInsertName" Width="220" ToolTip="Nombre de la lámina que se va a crear"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,4">
                                <TextBlock Text="Cartela (Title Block):" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                                <ComboBox x:Name="cmbTitleBlock" Width="230"/>
                            </StackPanel>
                            <Button Content="⬆️ Insertar Antes" Style="{StaticResource PrimaryButtonStyle}" Click="BtnInsertBefore_Click" Margin="0,0,6,4" VerticalAlignment="Bottom"
                                    ToolTip="Crea la lámina con el número de la seleccionada y desplaza +1 la seleccionada y las siguientes de la misma serie"/>
                            <Button Content="⬇️ Insertar Después" Style="{StaticResource PrimaryButtonStyle}" Click="BtnInsertAfter_Click" Margin="0,0,8,4" VerticalAlignment="Bottom"
                                    ToolTip="Crea la lámina con el número siguiente a la seleccionada y desplaza +1 todas las siguientes de la misma serie"/>
                            <CheckBox x:Name="chkCopyProps" Content="Copiar propiedades de la referencia" IsChecked="True" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,16,8"
                                      ToolTip="Duplica en la nueva lámina todos los parámetros editables de la lámina seleccionada (dibujado por, fecha, parámetros compartidos/de proyecto, revisiones), los parámetros de la cartela y su posición"/>

                            <Border Width="1" Background="#FED7AA" Margin="0,0,16,4"/>

                            <StackPanel Margin="0,0,8,4">
                                <TextBlock Text="Cantidad:" FontSize="10" FontWeight="Bold" Foreground="#555550" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtShiftAmount" Text="1" Width="50"/>
                            </StackPanel>
                            <Button Content="➕ Desplazar +N" Style="{StaticResource SecondaryButtonStyle}" Click="BtnShiftUp_Click" Margin="0,0,6,4" VerticalAlignment="Bottom"
                                    ToolTip="Suma N a la lámina seleccionada y a todas las siguientes de la misma serie (reserva huecos)"/>
                            <Button Content="➖ Desplazar -N" Style="{StaticResource SecondaryButtonStyle}" Click="BtnShiftDown_Click" Margin="0,0,12,4" VerticalAlignment="Bottom"
                                    ToolTip="Resta N a la lámina seleccionada y a todas las siguientes de la misma serie (cierra huecos)"/>
                            <CheckBox x:Name="chkStopAtGap" Content="Detener en el primer hueco" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                      ToolTip="Al insertar o desplazar +N, solo mueve las láminas necesarias hasta encontrar un número libre"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

            <DataGrid Grid.Row="1" x:Name="dgSheets" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAE5DC" Background="#FFFFFF"
                      BorderThickness="0" RowHeight="28" FontSize="11">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="[X]" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                    <DataGridTextColumn Header="Nº Actual" Binding="{Binding OriginalSheetNumber}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="Nuevo Nº (Preview)" Binding="{Binding NewSheetNumber, UpdateSourceTrigger=PropertyChanged}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#0F4369"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Nombre Actual" Binding="{Binding OriginalSheetName}" IsReadOnly="True" Width="260"/>
                    <DataGridTextColumn Header="Nuevo Nombre (Preview)" Binding="{Binding NewSheetName, UpdateSourceTrigger=PropertyChanged}" Width="300">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#059669"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Vistas" Binding="{Binding ViewportsCount}" IsReadOnly="True" Width="70"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>

        <!-- BARRA INFERIOR DE ACCIONES -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Acciones de Selección rápida -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="☑️ Seleccionar Todas" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSelectAll_Click" Margin="0,0,6,0"/>
                <Button Content="⬜ Deseleccionar" Style="{StaticResource SecondaryButtonStyle}" Click="BtnDeselectAll_Click" Margin="0,0,12,0"/>
                <TextBlock x:Name="lblStatusSummary" Text="Cargando láminas..." FontSize="12" Foreground="#555550" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Botones de Acción -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="🚀 Aplicar Cambios a Láminas de Revit" Style="{StaticResource SuccessButtonStyle}" Click="BtnApply_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
