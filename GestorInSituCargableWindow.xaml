<Window x:Class="RevitToSupabasePlugin.GestorInSituCargableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review BIM - Gestor y Convertidor de Familias In-Situ a Cargables (.RFA)"
        Height="760" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4" Foreground="#1C1C19"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="ArcaBg" Color="#FCF9F4"/>
        <SolidColorBrush x:Key="ArcaSurface" Color="#F6F3EE"/>
        <SolidColorBrush x:Key="ArcaCardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ArcaPrimary" Color="#0F4369"/>
        <SolidColorBrush x:Key="ArcaPrimaryHover" Color="#1D5A85"/>
        <SolidColorBrush x:Key="ArcaPrimaryLight" Color="#EBF2F7"/>
        <SolidColorBrush x:Key="ArcaBorder" Color="#DEDBD5"/>
        <SolidColorBrush x:Key="ArcaInk" Color="#1C1C19"/>
        <SolidColorBrush x:Key="ArcaMuted" Color="#5F6368"/>

        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="{StaticResource ArcaPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ArcaPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#D6D3CD"/>
                                <Setter Property="Foreground" Value="#8A8D91"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryBtn">
            <Setter Property="Background" Value="{StaticResource ArcaCardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ArcaInk}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ArcaBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ArcaPrimaryLight}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ArcaPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource ArcaPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#DEDBD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#DEDBD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Identidad Arquitectónica Navy -->
        <Rectangle Grid.Row="0" Fill="#0F4369"/>

        <!-- Encabezado Editorial con Icono Grande -->
        <Border Grid.Row="1" Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="42" Height="42" Background="#0F4369" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GESTOR Y CONVERTIDOR DE FAMILIAS IN-SITU A CARGABLES (.RFA)"
                               FontSize="10" FontWeight="Bold" Foreground="#0F4369"/>
                    <TextBlock Text="Auditoría de Elementos In-Situ (IsInPlace), Normalización (0,0,0) y Conversión a .RFA"
                               FontSize="16" FontWeight="Bold" Foreground="#1C1C19" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#EBF2F7" BorderBrush="#0F4369" BorderThickness="1" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="ORIGEN CARTESIANO (0,0,0) · CONVERSIÓN .RFA"
                               FontSize="10.5" FontWeight="Bold" Foreground="#0F4369"/>
                </Border>
            </Grid>
        </Border>

        <!-- Cuerpo Principal: Izquierda Lista y Conversión / Derecha Visor 3D Interactivo -->
        <Grid Grid.Row="2" Margin="18,14,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Gestor In-Situ con Iconos Grandes -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DEDBD5" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FAMILIAS IN-SITU (ISINPLACE) DETECTADAS EN EL MODELO"
                                       FontSize="10.5" FontWeight="Bold" Foreground="#0F4369"/>
                            <TextBlock Text="Selecciona un elemento In-Situ para auditar su origen (0,0,0) y convertirlo a familia cargable (.rfa)."
                                       FontSize="11" Foreground="#5F6368" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}"
                                Padding="12,8" Click="BtnRefreshInPlace_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Escanear Modelo" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox x:Name="lstInPlaceFamilies" Grid.Row="1"
                             Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="1"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="LstInPlaceFamilies_SelectionChanged"
                             Margin="0,0,0,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" BorderBrush="#DEDBD5" BorderThickness="0,0,0,1" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Icono Grande de Elemento In-Situ -->
                                        <Border Grid.Column="0" Width="42" Height="42" Background="#EBF2F7" BorderBrush="#0F4369" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="🧊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" Foreground="#1C1C19" FontSize="12.5"/>
                                            <TextBlock Text="{Binding DimensionsSummary}" Foreground="#0F4369" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding MaterialName, StringFormat='Material: {0}'}" Foreground="#5F6368" FontSize="10.5"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="CONFIGURACIÓN DE CONVERSIÓN A FAMILIA CARGABLE (.RFA)"
                                       FontSize="10.5" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nuevo Nombre de Familia (.rfa):" FontSize="11" Foreground="#5F6368" Margin="0,0,0,3"/>
                                    <TextBox x:Name="txtInPlaceNewFamilyName" Text=""/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Material para Parámetro 'Mat':" FontSize="11" Foreground="#5F6368" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cmbInPlaceMaterial" DisplayMemberPath="Name"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="chkReplaceInPlaceInstance"
                                      Content="Reemplazar el elemento In-Situ en el modelo por una instancia cargable en su coordenada (0,0)"
                                      IsChecked="True" FontSize="11.5" FontWeight="SemiBold" Foreground="#1C1C19" Margin="0,4,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnSelectInPlaceInView" Grid.Column="0"
                                        Style="{StaticResource SecondaryBtn}" Height="42" Padding="14,6"
                                        Click="BtnSelectInPlaceInView_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" FontSize="17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Seleccionar en Vista" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnConvertInPlace" Grid.Column="2"
                                        Style="{StaticResource PrimaryBtn}" Height="42"
                                        Click="BtnConvertInPlace_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Convertir In-Situ a Cargable (.RFA) en (0,0)" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Panel Derecho: Visor 3D Interactivo con Ejes Cartesianos (0,0,0) -->
            <Border Grid.Column="2" Background="#1C1C19" BorderBrush="#DEDBD5" BorderThickness="1">
                <Grid>
                    <Viewport3D x:Name="viewport3D" ClipToBounds="True"
                                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                                MouseMove="Viewport_MouseMove"
                                MouseWheel="Viewport_MouseWheel">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="camera3D" Position="80,-80,65" LookDirection="-80,80,-65" UpDirection="0,0,1" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="modelGroup"/>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>

                    <!-- Etiqueta Superior del Visor 3D -->
                    <Border Background="#CC0F4369" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,6">
                        <StackPanel>
                            <TextBlock x:Name="lblPreviewTitle" Text="VISTA PREVIA 3D IN-SITU NORMALIZADA EN (0,0,0)"
                                       Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                            <TextBlock x:Name="lblPreviewSubtitle" Text="Eje Rojo = U (X) | Eje Verde = V (Y) | Eje Azul = Z | Esquina mínima en (0,0,0)"
                                       Foreground="#EBF2F7" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Métricas de Geometría en Esquina Inferior -->
                    <Border Background="#CC1C1C19" BorderBrush="#0F4369" BorderThickness="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblPreviewMetrics"
                                       Text="Selecciona una familia In-Situ de la lista para visualizar su geometría en (0,0,0)."
                                       Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Centrar Cámara (0,0)" Style="{StaticResource SecondaryBtn}"
                                    Padding="8,3" FontSize="10.5" Click="BtnResetCamera_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de Estado y Cierre -->
        <Border Grid.Row="3" Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblStatus"
                           Text="Listo. Escanea y selecciona cualquier familia In-Situ para convertirla en familia cargable (.RFA) en (0,0,0)."
                           FontSize="11.5" Foreground="#5F6368" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Cerrar Gestor" Style="{StaticResource SecondaryBtn}"
                        Width="120" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
