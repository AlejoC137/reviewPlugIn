<Window x:Class="RevitToSupabasePlugin.GeneradorIAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Family Builder Dashboard | ARCA REVIEW" 
        Height="860" Width="520" 
        MinHeight="600" MinWidth="460"
        WindowStartupLocation="CenterScreen" 
        Background="#FCF9F4"
        Foreground="#1C1C19"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#1C1C19"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="#0F4369"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="#FFFFFF" Margin="0,8,0,0"/>
                            <Border Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FCF9F4" Padding="6,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#1C1C19"/>
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="🤖 Dashboard Generador IA Multi-Modal" FontSize="18" FontWeight="Bold" Foreground="#0F4369"/>
                <TextBlock Text="Genera familias de Revit desde texto, fotos o videos usando IA" FontSize="11" Foreground="#72777F" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Configuración de API Key y Modelo -->
            <GroupBox Header="1. Conexión de Agente IA &amp; Modelo" Grid.Row="1">
                <StackPanel Margin="0,4,0,0">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="API Key (OpenAI / OpenRouter / Gemini):" FontWeight="SemiBold" Foreground="#1C1C19" Margin="0,0,0,3" FontSize="10"/>
                            <TextBox x:Name="txtApiKey" Text="" Padding="5" Background="#FCF9F4" Foreground="#1C1C19" BorderBrush="#1C1C19" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Modelo IA:" FontWeight="SemiBold" Foreground="#1C1C19" Margin="0,0,0,3" FontSize="10"/>
                            <ComboBox x:Name="cmbModel" SelectedIndex="0">
                                <ComboBoxItem Content="gpt-4o-mini (Texto/Visión)"/>
                                <ComboBoxItem Content="gpt-4o (Visión HD)"/>
                                <ComboBoxItem Content="gemini-2.0-flash (Visión)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="💡 Modelos 'gpt-4o' o 'gemini' procesan imágenes y frames de video directamente." FontSize="10" Foreground="#72777F"/>
                </StackPanel>
            </GroupBox>

            <!-- Configuración LOD & LOI Section -->
            <GroupBox Header="2. Configuración de LOD &amp; LOI" Grid.Row="2">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Nivel Geométrico (LOD):" FontWeight="SemiBold" Foreground="#1C1C19" Margin="0,0,0,3" FontSize="10"/>
                        <ComboBox x:Name="cmbLOD" SelectedIndex="1">
                            <ComboBoxItem Content="LOD 200 (Bloque Conceptual)"/>
                            <ComboBoxItem Content="LOD 300 (Geometría Básica)"/>
                            <ComboBoxItem Content="LOD 350 (Alta Segmentación)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Nivel de Información (LOI):" FontWeight="SemiBold" Foreground="#1C1C19" Margin="0,0,0,3" FontSize="10"/>
                        <ComboBox x:Name="cmbLOI" SelectedIndex="1">
                            <ComboBoxItem Content="Básico (Peso y Dimensiones)"/>
                            <ComboBoxItem Content="Técnico (Voltajes y Flujos)"/>
                            <ComboBoxItem Content="Mantenimiento (Garantía)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Solicitud / Prompt en Vivo + Archivos Multimedia -->
            <GroupBox Header="3. Solicitud IA en Vivo (Texto / PDF / IFC / DWG / Foto / Video)" Grid.Row="3">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="Descripción o instrucciones del elemento:" FontWeight="SemiBold" Foreground="#1C1C19" Margin="0,0,0,4" FontSize="10"/>
                    <TextBox x:Name="txtUserPrompt" Height="45" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                             Text="Tanque industrial de agua con gabinete principal de 600x400x800mm, 4 patas cilíndricas de 50mm y panel frontal"
                             FontFamily="Segoe UI" FontSize="11" Background="#FCF9F4" Foreground="#1C1C19" BorderBrush="#1C1C19" 
                             BorderThickness="1" Padding="4" CaretBrush="#0F4369"/>

                    <!-- Adjuntar Imagen / Video / PDF / IFC / DWG -->
                    <Border Background="#F6F3EE" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Miniatura o Icono -->
                            <Border Grid.Column="0" Width="60" Height="50" Background="#FFFFFF" BorderBrush="#1C1C19" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                                <Grid>
                                    <Image x:Name="imgPreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtMediaIcon" Text="📄/📐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#72777F"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="btnSelectMedia" Content="📁 Adjuntar Archivo (PNG, JPG, PDF, IFC, DWG, MP4)" Height="26" FontSize="10" Background="#FFFFFF" Foreground="#1C1C19" BorderBrush="#1C1C19"/>
                                <TextBlock x:Name="lblMediaStatus" Text="Sin archivo adjunto" FontSize="10" Foreground="#72777F" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button x:Name="btnClearMedia" Grid.Column="2" Content="❌" Width="26" Height="26" Margin="6,0,0,0" Background="#F6F3EE" Foreground="#BA1A1A" BorderBrush="#BA1A1A" FontSize="10" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Button x:Name="btnGenerateLive" Height="36" Background="#0F4369" BorderBrush="#0F4369" BorderThickness="1" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨ Generar Geometría con IA en Vivo" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </GroupBox>

            <!-- Construction Section -->
            <GroupBox Header="4. Geometría JSON Generada" Grid.Row="4" Margin="0,0,0,8">
                <StackPanel Margin="0,4,0,0">
                    <TextBox x:Name="txtJson" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" 
                             FontFamily="Consolas" FontSize="11" Background="#FCF9F4" Foreground="#1C1C19" BorderBrush="#1C1C19" 
                             BorderThickness="1" Padding="4" CaretBrush="#0F4369"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnCopyPrompt" Grid.Column="0" Content="📋 Copiar Prompt" Height="28" Margin="0,0,3,0" FontSize="10" Foreground="#1C1C19" Background="#F6F3EE" BorderBrush="#1C1C19"/>
                        <Button x:Name="btnPaste" Grid.Column="1" Content="📥 Pegar JSON" Height="28" Margin="3,0,0,0" FontSize="10" Foreground="#1C1C19" Background="#F6F3EE" BorderBrush="#1C1C19"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Status Bar -->
            <TextBlock x:Name="txtStatus" Text="Listo para comunicarse con el agente de IA multi-modal..." Foreground="#72777F" FontStyle="Italic" Grid.Row="6" Margin="0,0,0,8" FontSize="11"/>

            <!-- Build Button -->
            <Button x:Name="btnBuild" Grid.Row="7" Height="42" Background="#137333" BorderBrush="#137333" BorderThickness="1" Cursor="Hand">
                <TextBlock Text="🚀 Construir Geometría en Revit" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </ScrollViewer>
</Window>
