<Window x:Class="RevitToSupabasePlugin.GeneradorIAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Family Builder Dashboard - Multi-Modal" 
        Height="860" Width="500" 
        MinHeight="600" MinWidth="460"
        WindowStartupLocation="CenterScreen" 
        Background="#121214"
        Foreground="#E3E5E8"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#3182CE">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1C20"/>
            <Setter Property="Foreground" Value="#121214"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2B2D31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Gradient Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="🤖 Dashboard Generador IA Multi-Modal" FontSize="20" FontWeight="Bold">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#63B3ED" Offset="0.0"/>
                            <GradientStop Color="#4FD1C5" Offset="1.0"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Genera familias de Revit desde texto, fotos o videos usando IA" FontSize="11" Foreground="#A0AEC0" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Configuración de API Key y Modelo -->
            <GroupBox Header="1. Conexión de Agente IA &amp; Modelo" Grid.Row="1">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="API Key (OpenAI / OpenRouter / Gemini):" FontWeight="Normal" Foreground="#A0AEC0" Margin="0,0,0,3" FontSize="10"/>
                            <TextBox x:Name="txtApiKey" Text="" Padding="5" Background="#1A1C20" Foreground="#63B3ED" BorderBrush="#4A5568" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Modelo IA:" FontWeight="Normal" Foreground="#A0AEC0" Margin="0,0,0,3" FontSize="10"/>
                            <ComboBox x:Name="cmbModel" SelectedIndex="0">
                                <ComboBoxItem Content="gpt-4o-mini (Texto/Visión)"/>
                                <ComboBoxItem Content="gpt-4o (Visión HD)"/>
                                <ComboBoxItem Content="gemini-2.0-flash (Visión)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="💡 Modelos 'gpt-4o' o 'gemini' procesan imágenes y frames de video directamente." FontSize="10" Foreground="#718096" FontStyle="Italic"/>
                </StackPanel>
            </GroupBox>

            <!-- Configuración LOD & LOI Section -->
            <GroupBox Header="2. Configuración de LOD &amp; LOI" Grid.Row="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Nivel Geométrico (LOD):" FontWeight="Normal" Foreground="#A0AEC0" Margin="0,0,0,3" FontSize="10"/>
                        <ComboBox x:Name="cmbLOD" SelectedIndex="1">
                            <ComboBoxItem Content="LOD 200 (Bloque Conceptual)"/>
                            <ComboBoxItem Content="LOD 300 (Geometría Básica)"/>
                            <ComboBoxItem Content="LOD 350 (Alta Segmentación)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Nivel de Información (LOI):" FontWeight="Normal" Foreground="#A0AEC0" Margin="0,0,0,3" FontSize="10"/>
                        <ComboBox x:Name="cmbLOI" SelectedIndex="1">
                            <ComboBoxItem Content="Básico (Peso y Dimensiones)"/>
                            <ComboBoxItem Content="Técnico (Voltajes y Flujos)"/>
                            <ComboBoxItem Content="Mantenimiento (Garantía)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Solicitud / Prompt en Vivo + Archivos Multimedia -->
            <GroupBox Header="3. Solicitud IA en Vivo (Texto / PDF / IFC / DWG / Foto / Video)" Grid.Row="3">
                <StackPanel>
                    <TextBlock Text="Descripción o instrucciones del elemento:" FontWeight="Normal" Foreground="#A0AEC0" Margin="0,0,0,4" FontSize="10"/>
                    <TextBox x:Name="txtUserPrompt" Height="45" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                             Text="Tanque industrial de agua con gabinete principal de 600x400x800mm, 4 patas cilíndricas de 50mm y panel frontal"
                             FontFamily="Segoe UI" FontSize="11" Background="#1A1C20" Foreground="#F7FAFC" BorderBrush="#4A5568" 
                             BorderThickness="1" Padding="4" CaretBrush="White"/>

                    <!-- Adjuntar Imagen / Video / PDF / IFC / DWG -->
                    <Border Background="#1A1C20" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Miniatura o Icono -->
                            <Border Grid.Column="0" Width="60" Height="50" Background="#2D3748" CornerRadius="3" Margin="0,0,8,0">
                                <Grid>
                                    <Image x:Name="imgPreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtMediaIcon" Text="📄/📐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0AEC0"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="btnSelectMedia" Content="📁 Adjuntar Archivo (PNG, JPG, PDF, IFC, DWG, MP4)" Height="26" FontSize="10" Background="#2D3748" Foreground="#E2E8F0"/>
                                <TextBlock x:Name="lblMediaStatus" Text="Sin archivo adjunto" FontSize="10" Foreground="#718096" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button x:Name="btnClearMedia" Grid.Column="2" Content="❌" Width="26" Height="26" Margin="6,0,0,0" Background="#742A2A" Foreground="White" FontSize="10" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Button x:Name="btnGenerateLive" Height="36">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" BorderThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#805AD5" Offset="0"/>
                                            <GradientStop Color="#3182CE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨ Generar Geometría con IA en Vivo" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </GroupBox>

            <!-- Construction Section -->
            <GroupBox Header="4. Geometría JSON Generada" Grid.Row="4" Margin="0,0,0,8">
                <StackPanel>
                    <TextBox x:Name="txtJson" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" 
                             FontFamily="Consolas" FontSize="11" Background="#1A1C20" Foreground="#F7FAFC" BorderBrush="#4A5568" 
                             BorderThickness="1" Padding="4" CaretBrush="White"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnCopyPrompt" Grid.Column="0" Content="📋 Copiar Prompt" Height="26" Margin="0,0,3,0" FontSize="10" Foreground="#CBD5E0"/>
                        <Button x:Name="btnPaste" Grid.Column="1" Content="📥 Pegar JSON" Height="26" Margin="3,0,0,0" FontSize="10" Foreground="#CBD5E0"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Status Bar -->
            <TextBlock x:Name="txtStatus" Text="Listo para comunicarse con el agente de IA multi-modal..." Foreground="#718096" FontStyle="Italic" Grid.Row="6" Margin="0,0,0,8" FontSize="11"/>

            <!-- Build Button with emerald gradient -->
            <Button x:Name="btnBuild" Grid.Row="7" Height="42">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" BorderThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#38A169" Offset="0"/>
                                    <GradientStop Color="#2F855A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="🚀 Construir Geometría en Revit" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </ScrollViewer>
</Window>
