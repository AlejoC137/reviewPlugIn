<Window x:Class="RevitToSupabasePlugin.GeneradorIAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Family Builder Dashboard" 
        Height="630" Width="440" 
        WindowStartupLocation="CenterScreen" 
        Background="#121214"
        Foreground="#E3E5E8"
        ResizeMode="NoResize"
        BorderThickness="1"
        BorderBrush="#3182CE">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1C20"/>
            <Setter Property="Foreground" Value="#121214"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2B2D31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Gradient Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🤖 Dashboard Generador IA" FontSize="22" FontWeight="Bold">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#63B3ED" Offset="0.0"/>
                        <GradientStop Color="#4FD1C5" Offset="1.0"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="Genera familias de Revit usando Inteligencia Artificial" FontSize="11" Foreground="#A0AEC0" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Configuración Section -->
        <GroupBox Header="1. Configuración de LOD &amp; LOI" Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Nivel Geométrico (LOD):" FontWeight="Normal" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="11"/>
                <ComboBox x:Name="cmbLOD" SelectedIndex="1">
                    <ComboBoxItem Content="LOD 200 (Bloque General Conceptual)"/>
                    <ComboBoxItem Content="LOD 300 (Formas Básicas Detalladas)"/>
                    <ComboBoxItem Content="LOD 350 (Alta Segmentación y Patas)"/>
                </ComboBox>

                <TextBlock Text="Nivel de Información (LOI):" FontWeight="Normal" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="11"/>
                <ComboBox x:Name="cmbLOI" SelectedIndex="1">
                    <ComboBoxItem Content="Básico (Peso, Dimensiones y Modelo)"/>
                    <ComboBoxItem Content="Técnico (Flujos, Voltajes y Conexiones)"/>
                    <ComboBoxItem Content="Mantenimiento (Garantía, Repuestos, Fabricante)"/>
                </ComboBox>
            </StackPanel>
        </GroupBox>

        <!-- Copy Prompt Button with rounded corners & gradient -->
        <Button x:Name="btnCopyPrompt" Grid.Row="2" Height="42" Margin="0,0,0,15">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6" BorderThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3182CE" Offset="0"/>
                                <GradientStop Color="#319795" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋 1. Copiar Instrucciones para la IA" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Construction Section -->
        <GroupBox Header="2. Construcción de Geometría" Grid.Row="3" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="JSON devuelto por el Asistente:" FontWeight="Normal" Foreground="#A0AEC0" Margin="0,0,0,5" FontSize="11"/>
                <TextBox x:Name="txtJson" Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" 
                         FontFamily="Consolas" FontSize="11" Background="#1A1C20" Foreground="#F7FAFC" BorderBrush="#4A5568" 
                         BorderThickness="1" Padding="5" CaretBrush="White"/>
                <Button x:Name="btnPaste" Content="📋 Pegar desde el Portapapeles" Height="30" Foreground="#E2E8F0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="4" Background="#2D3748" BorderBrush="#4A5568" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </GroupBox>

        <!-- Status Bar -->
        <TextBlock x:Name="txtStatus" Text="Esperando instrucciones..." Foreground="#718096" FontStyle="Italic" Grid.Row="5" Margin="0,0,0,10" FontSize="12"/>

        <!-- Build Button with emerald gradient -->
        <Button x:Name="btnBuild" Grid.Row="6" Height="45">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6" BorderThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#38A169" Offset="0"/>
                                <GradientStop Color="#2F855A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <TextBlock Text="🚀 2. Construir Geometría en Revit" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
        </Button>
    </Grid>
</Window>
