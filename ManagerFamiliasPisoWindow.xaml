<Window x:Class="RevitToSupabasePlugin.ManagerFamiliasPisoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de Familias y Piezas de Baldosas (Tiles) | ARCA REVIEW" 
        Height="720" Width="1060" 
        MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen" 
        Background="#FCF9F4"
        Foreground="#1C1C19"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="#1C1C19"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Foreground" Value="#0F4369"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="#FFFFFF" Margin="0,10,0,0"/>
                            <Border Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FCF9F4" Padding="5,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1E4F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#1C1C19"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#1C1C19"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#0F4369"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D1E4F9"/>
                                            <Setter Property="Foreground" Value="#0F4369"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="200"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="270" MinWidth="220"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA 1: Selección (Baldosas y Pegas de Piso) -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CARD SUPERIOR: Familias de Baldosa (Tiles) -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="4" Padding="10" BorderBrush="#1C1C19" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="🪵 Familias de Baldosas (Tiles)" FontSize="14" FontWeight="Bold" Foreground="#0F4369"/>
                        <TextBlock Text="Formatos y enchapes de piso del proyecto" FontSize="10" Foreground="#72777F" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="lstTiles" Grid.Row="1" SelectionChanged="LstTiles_SelectionChanged" DisplayMemberPath="FullName" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="btnAddTile" Content="➕ Cargar / Agregar Baldosa" Click="BtnAddTile_Click" Background="#2B6CB0" Margin="0,0,0,4"/>
                        <Button x:Name="btnExportTile" Content="📤 Exportar Baldosa" Click="BtnExportTile_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SPLITTER INTERNO VERTICAL -->
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#2D3748" Cursor="SizeNS"/>

            <!-- CARD INFERIOR: Familias de Pega / Fragua (Juntas de Piso) -->
            <Border Grid.Row="2" Background="#1A202C" CornerRadius="8" Padding="10" BorderBrush="#2D3748" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="🧈 Familias de Pega / Fragua" FontSize="14" FontWeight="Bold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DD6B20" Offset="0.0"/>
                                    <GradientStop Color="#F6AD55" Offset="1.0"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Cama de pega adhesiva y juntas/fraguas" FontSize="10" Foreground="#A0AEC0" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="lstPegas" Grid.Row="1" SelectionChanged="LstPegas_SelectionChanged" DisplayMemberPath="FullName" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="btnAddPega" Content="➕ Cargar / Agregar Pega o Junta" Click="BtnAddPega_Click" Background="#D69E2E" Margin="0,0,0,4"/>
                        <Button x:Name="btnExportPega" Content="📤 Exportar Pega / Junta" Click="BtnExportPega_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- BARRA 1: Modificar Tamaño Columna 1 vs 2 -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#2D3748" Cursor="SizeWE" ToolTip="Arrastrar para ajustar ancho de columna"/>

        <!-- COLUMNA 2: Gestión (Botones y Propiedades del Tipo) -->
        <Border Grid.Column="2" BorderBrush="#2D3748" BorderThickness="1,0,1,0" Padding="10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Gestión de Baldosas" FontWeight="SemiBold" FontSize="14" Foreground="#A0AEC0" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,0,0,12">
                    <Button x:Name="btnLocate" Content="📍 Ubicar en Modelo" Click="BtnLocate_Click" Height="30" IsEnabled="False"/>
                    <Button x:Name="btnUpdate" Content="🔄 Actualizar RFA" Click="BtnUpdate_Click" Height="30" IsEnabled="False"/>
                    <Button x:Name="btnEdit" Content="✏️ Editar Familia" Click="BtnEdit_Click" Height="30" IsEnabled="False"/>
                    <Button x:Name="btnDuplicate" Content="📑 Duplicar Tipo" Click="BtnDuplicate_Click" Height="30" IsEnabled="False"/>
                    <Button x:Name="btnDeleteType" Content="🗑️ Eliminar Tipo" Click="BtnDeleteType_Click" Height="30" IsEnabled="False" Background="#C53030"/>
                    <Button x:Name="btnDelete" Content="🗑️ Eliminar Familia" Click="BtnDelete_Click" Height="30" IsEnabled="False" Background="#742A2A"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Propiedades de la Pieza" FontWeight="SemiBold" FontSize="14" Foreground="#A0AEC0" Margin="0,0,0,10"/>
                
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="pnlProperties" IsEnabled="False">
                        <TextBlock Text="Identificación:" Foreground="#E3E5E8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Familia" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtFamilyName" Margin="0,0,0,6" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                        <TextBlock Text="Tipo" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtTypeName" Margin="0,0,0,8" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>

                        <TextBlock Text="Dimensiones de Baldosa (cm):" Foreground="#E3E5E8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Largo (Length)" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtLength" TextChanged="DimensionField_TextChanged" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Ancho (Width)" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtWidth" TextChanged="DimensionField_TextChanged" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
                                <TextBlock Text="Espesor (Thickness)" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtThickness" TextChanged="DimensionField_TextChanged" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,0">
                                <TextBlock Text="Bisel / Junta (mm)" Foreground="#A0AEC0" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtBevel" TextChanged="DimensionField_TextChanged" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                            </StackPanel>
                        </Grid>

                        <!-- Métricas en Vivo de Baldosas -->
                        <Border Background="#15171A" CornerRadius="4" Padding="6" Margin="0,2,0,8" BorderBrush="#2D3748" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Área / Pieza:" FontSize="9" Foreground="#A0AEC0"/>
                                    <TextBlock x:Name="lblTileArea" Text="0.360 m²" FontSize="11" FontWeight="Bold" Foreground="#63B3ED"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="Rendimiento:" FontSize="9" Foreground="#A0AEC0"/>
                                    <TextBlock x:Name="lblYield" Text="2.78 pz/m²" FontSize="11" FontWeight="Bold" Foreground="#48BB78"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,3,0,0">
                                    <TextBlock Text="Proporción:" FontSize="9" Foreground="#A0AEC0"/>
                                    <TextBlock x:Name="lblAspectRatio" Text="1.00 (Cuadrada)" FontSize="10" FontWeight="SemiBold" Foreground="#ECC94B"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Clasificación:" Foreground="#A0AEC0" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbCategory" Margin="0,0,0,6" Background="#FFFFFF" Foreground="#1C1C19" BorderBrush="#1C1C19" BorderThickness="1" Padding="6,4">
                            <ComboBoxItem Content="Porcelanato" IsSelected="True"/>
                            <ComboBoxItem Content="Cerámica"/>
                            <ComboBoxItem Content="Madera / Parquet"/>
                            <ComboBoxItem Content="Mármol / Granito / Piedra"/>
                            <ComboBoxItem Content="Terrazo / Hormigón"/>
                            <ComboBoxItem Content="Adoquín / Exterior"/>
                        </ComboBox>

                        <TextBlock Text="Costo ($ / m²)" Foreground="#A0AEC0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtCost" Margin="0,0,0,6" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                        
                        <TextBlock Text="Descripción" Foreground="#A0AEC0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtDescription" Margin="0,0,0,6" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                        
                        <TextBlock Text="Fabricante / Marca" Foreground="#A0AEC0" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtManufacturer" Margin="0,0,0,6" Background="#2D3748" Foreground="White" BorderThickness="0" Padding="4"/>
                        
                        <TextBlock Text="Material en Revit" Foreground="#A0AEC0" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbMaterial" DisplayMemberPath="Name" Margin="0,0,0,12" Background="#FFFFFF" Foreground="#1C1C19" BorderBrush="#1C1C19" BorderThickness="1" Padding="6,4"/>

                        <Button x:Name="btnSaveProperties" Content="💾 Guardar Propiedades" Click="BtnSaveProperties_Click" Height="34" Background="#38A169" FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- BARRA 2: Modificar Tamaño Columna 2 vs 3 -->
        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#2D3748" Cursor="SizeWE" ToolTip="Arrastrar para ajustar ancho del previsualizador"/>

        <!-- COLUMNA 3: Previsualizador 3D -->
        <Grid Grid.Column="4" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Previsualizador Interactivo (Tiles)" FontWeight="SemiBold" FontSize="14" Foreground="#A0AEC0" Grid.Row="0" Margin="0,0,0,10"/>
            <Border Grid.Row="1" Background="#1A1A1D" CornerRadius="8" ClipToBounds="True" BorderBrush="#2D3748" BorderThickness="1">
                <Grid MouseLeftButtonDown="Viewport_MouseLeftButtonDown" MouseLeftButtonUp="Viewport_MouseLeftButtonUp" MouseMove="Viewport_MouseMove" MouseWheel="Viewport_MouseWheel" Background="Transparent">
                    
                    <!-- Main 3D Viewport -->
                    <Viewport3D x:Name="viewport3D">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="camera3D" Position="1,1,1" LookDirection="-1,-1,-1" UpDirection="0,0,1" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="modelGroup">
                                    <AmbientLight Color="#666666" />
                                    <DirectionalLight Color="#FFFFFF" Direction="-1,-1,-1" />
                                    <DirectionalLight Color="#444444" Direction="1,1,1" />
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>

                    <!-- Labels and Overlay -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10">
                        <TextBlock x:Name="lblViewOrientation" Text="Isométrica" Foreground="#A0AEC0" FontWeight="Bold" FontSize="15"/>
                        <TextBlock x:Name="lblTileSize" Text="Selecciona una baldosa o elemento" Foreground="#718096" FontSize="11"/>
                    </StackPanel>

                    <!-- Axis Gizmo 3D -->
                    <Viewport3D x:Name="gizmoViewport" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="gizmoCamera" Position="2,2,2" LookDirection="-1,-1,-1" UpDirection="0,0,1" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D x:Name="gizmoVisual">
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="gizmoGroup">
                                    <AmbientLight Color="White"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>
                    <Canvas Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                        <TextBlock x:Name="lblAxisZ" Text="Z" Foreground="#4299E1" Canvas.Top="0" Canvas.Left="40" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="lblAxisY" Text="Y" Foreground="#48BB78" Canvas.Top="60" Canvas.Left="70" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="lblAxisX" Text="X" Foreground="#F56565" Canvas.Top="60" Canvas.Left="0" FontSize="10" FontWeight="Bold"/>
                    </Canvas>
                    
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
