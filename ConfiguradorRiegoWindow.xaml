<Window x:Class="RevitToSupabasePlugin.ConfiguradorRiegoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌱 Sistema de Riego Automático - Diagrama y Generación MEP" 
        Height="720" Width="850" 
        MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterScreen" 
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="💧 Diseñador y Automatizador de Sistema de Riego" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="Esquema gráfico simplificado de ensamble (Basado en Cotización Riego y Campo)" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="btnExploradorPlantilla" Content="📂 Cargar Plantilla .RTE/.RFA" Height="32" Click="btnExploradorPlantilla_Click"/>
            </Grid>
        </StackPanel>

        <!-- Main Body split into Graphical Diagram (Left) and JSON / Material List (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Low-Res Graphical Diagram -->
            <GroupBox Header="1. Esquema Gráfico del Sistema (Topología de Conexión)" Grid.Column="0" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="15">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Canvas x:Name="canvasDiagram" Width="440" Height="420" Background="#0F172A">
                                <!-- Background Grid lines -->
                                <Path Data="M 0,50 L 440,50 M 0,100 L 440,100 M 0,150 L 440,150 M 0,200 L 440,200 M 0,250 L 440,250 M 0,300 L 440,300 M 0,350 L 440,350" Stroke="#1E293B" StrokeThickness="1"/>
                                <Path Data="M 50,0 L 50,420 M 100,0 L 100,420 M 150,0 L 150,420 M 200,0 L 200,420 M 250,0 L 250,420 M 300,0 L 300,420 M 350,0 L 350,420 M 400,0 L 400,420" Stroke="#1E293B" StrokeThickness="1"/>

                                <!-- 1. Motobomba -->
                                <Rectangle Canvas.Left="20" Canvas.Top="180" Width="60" Height="50" Fill="#0284C7" RadiusX="6" RadiusY="6" Stroke="#38BDF8" StrokeThickness="2"/>
                                <TextBlock Canvas.Left="25" Canvas.Top="195" Text="⚡ Bomba\nEvans 85" Foreground="White" FontSize="10" FontWeight="Bold" TextAlignment="Center"/>

                                <!-- Pipe 1: Bomba -> Filtro -->
                                <Line X1="80" Y1="205" X2="120" Y2="205" Stroke="#0EA5E9" StrokeThickness="4"/>

                                <!-- 2. Filtro de Malla -->
                                <Rectangle Canvas.Left="120" Canvas.Top="185" Width="45" Height="40" Fill="#0D9488" RadiusX="4" RadiusY="4" Stroke="#2DD4BF" StrokeThickness="2"/>
                                <TextBlock Canvas.Left="125" Canvas.Top="195" Text="🛡️ Filtro\n3/4&quot;" Foreground="White" FontSize="9" FontWeight="Bold" TextAlignment="Center"/>

                                <!-- Pipe 2: Filtro -> Válvula Bola -->
                                <Line X1="165" Y1="205" X2="200" Y2="205" Stroke="#0EA5E9" StrokeThickness="4"/>

                                <!-- 3. Válvula Bola PVC -->
                                <Polygon Points="200,195 215,205 200,215" Fill="#EAB308"/>
                                <Polygon Points="230,195 215,205 230,215" Fill="#EAB308"/>
                                <TextBlock Canvas.Left="198" Canvas.Top="175" Text="🚰 Válvula 1/2&quot;" Foreground="#FDE047" FontSize="9" FontWeight="Bold"/>

                                <!-- Pipe 3: Válvula -> Tubería PE Matrix -->
                                <Line X1="230" Y1="205" X2="270" Y2="205" Stroke="#0EA5E9" StrokeThickness="4"/>

                                <!-- Main PE Pipe 16mm (25m) -->
                                <Rectangle Canvas.Left="270" Canvas.Top="60" Width="12" Height="300" Fill="#10B981" RadiusX="3" RadiusY="3" Stroke="#34D399" StrokeThickness="2"/>
                                <TextBlock Canvas.Left="275" Canvas.Top="370" Text="🌱 Tubería PE 16mm (25m)" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>

                                <!-- Emitters / Nebulizadores (Elevados Z=+1.5m) -->
                                <!-- Line to Nebulizadores -->
                                <Line X1="282" Y1="100" X2="360" Y2="100" Stroke="#A855F7" StrokeThickness="2" StrokeDashArray="2,2"/>
                                <Ellipse Canvas.Left="360" Canvas.Top="90" Width="20" Height="20" Fill="#A855F7" Stroke="#E9D5FF" StrokeThickness="2"/>
                                <TextBlock Canvas.Left="385" Canvas.Top="92" Text="☁️ 11x Nebulizadores\nNaan Green Mist (+1.5m)" Foreground="#C084FC" FontSize="9" FontWeight="Bold"/>

                                <!-- Emitters / Goteros 1.0 GPH (Negro) -->
                                <Line X1="282" Y1="200" X2="360" Y2="200" Stroke="#64748B" StrokeThickness="2"/>
                                <Ellipse Canvas.Left="360" Canvas.Top="192" Width="16" Height="16" Fill="#334155" Stroke="#94A3B8" StrokeThickness="2"/>
                                <TextBlock Canvas.Left="385" Canvas.Top="192" Text="💧 16x Goteros 1 GPH\n(RainBird Negro)" Foreground="#CBD5E1" FontSize="9" FontWeight="Bold"/>

                                <!-- Emitters / Goteros 2.0 GPH (Rojo) -->
                                <Line X1="282" Y1="300" X2="360" Y2="300" Stroke="#EF4444" StrokeThickness="2"/>
                                <Ellipse Canvas.Left="360" Canvas.Top="292" Width="16" Height="16" Fill="#DC2626" Stroke="#FCA5A5" StrokeThickness="2"/>
                                <TextBlock Canvas.Left="385" Canvas.Top="292" Text="🔴 16x Goteros 2 GPH\n(RainBird Rojo)" Foreground="#FCA5A5" FontSize="9" FontWeight="Bold"/>

                                <!-- Legend -->
                                <Border Canvas.Left="10" Canvas.Top="10" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Padding="6" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="LEYENDA: " Foreground="#94A3B8" FontSize="9" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <Ellipse Width="8" Height="8" Fill="#0284C7" Margin="2,0"/>
                                        <TextBlock Text="Bomba " Foreground="#94A3B8" FontSize="9"/>
                                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="4,0,2,0"/>
                                        <TextBlock Text="PE 16mm " Foreground="#94A3B8" FontSize="9"/>
                                        <Ellipse Width="8" Height="8" Fill="#A855F7" Margin="4,0,2,0"/>
                                        <TextBlock Text="Nebulizador " Foreground="#94A3B8" FontSize="9"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="💡 El esquema representa la secuencia lógica que el plugin creará automáticamente en Revit MEP mediante conectores de tubería (Connector.ConnectTo)." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Right: JSON Input & Config -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Header="2. Datos de Cotización (JSON)" Grid.Row="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Mapeo de SKUs a Familias MEP:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="1" x:Name="txtJsonData" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="10" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" Padding="8"/>
                    </Grid>
                </GroupBox>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button x:Name="btnRestaurarJson" Content="🔄 Cargar Cotización 'Riego y Campo'" Margin="0,0,0,8" Click="btnRestaurarJson_Click"/>
                    <TextBlock x:Name="lblStatus" Text="Listo para generar el sistema en Revit." Foreground="#10B981" FontStyle="Italic" FontSize="11" Margin="0,0,0,8" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Footer Action Button -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="btnGenerarSistema" Height="45" Click="btnGenerarSistema_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" BorderThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#0D9488" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚀 GENERAR SISTEMA DE RIEGO MEP EN REVIT" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
