<Window x:Class="RevitToSupabasePlugin.ExportadorMetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexión Supabase - Exportador de Metadata (por ID)" Height="620" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#181818" Foreground="#FFFFFF">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <!-- Nonica Top Branded Line (#5235EF) -->
        <Rectangle Grid.Row="0" Fill="#5235EF" HorizontalAlignment="Stretch"/>

        <!-- Header -->
        <Border Grid.Row="1" Background="#222226" Padding="15,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DB" FontSize="18" FontWeight="Bold" Foreground="#5235EF" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Conexión Supabase &amp; Exportador de Metadata del Proyecto" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Ingresa tus credenciales y selecciona la información que será guardada en Supabase (/fromPlugIn)" FontSize="11" Foreground="#AAAAAA"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="2" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Autenticación y Credenciales -->
            <GroupBox Header="Autenticación de Usuario (Supabase)" Foreground="#5235EF" FontWeight="Bold" Margin="0,0,0,10" Background="#202024" BorderBrush="#333338" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Correo Electrónico:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtEmail" Grid.Column="1" Text="usuario@ejemplo.com" Background="#2A2A2E" Foreground="#FFFFFF" BorderBrush="#44444A" Padding="5,3"/>

                    <TextBlock Text="Contraseña:" Grid.Column="3" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <PasswordBox x:Name="txtPassword" Grid.Column="4" Password="••••••••" Background="#2A2A2E" Foreground="#FFFFFF" BorderBrush="#44444A" Padding="5,3"/>
                </Grid>
            </GroupBox>

            <!-- Checklist de Datos a Guardar en Base de Datos -->
            <GroupBox Grid.Row="1" Header="Listado de Información a Guardar en Base de Datos (Checklist)" Foreground="#5235EF" FontWeight="Bold" Margin="0,0,0,10" Background="#202024" BorderBrush="#333338" Padding="10">
                <StackPanel>
                    <TextBlock Text="Selecciona qué bloques de información de Revit serán enviados a Supabase:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <CheckBox x:Name="chkProjectInfo" Content="Información del Proyecto &amp; Dirección" IsChecked="True" Foreground="#EEEEEE" Margin="0,0,20,8"/>
                        <CheckBox x:Name="chkSiteLocation" Content="Ubicación / Georreferenciación (SiteLocation)" IsChecked="True" Foreground="#EEEEEE" Margin="0,0,20,8"/>
                        <CheckBox x:Name="chkLevels" Content="Niveles del Modelo" IsChecked="True" Foreground="#EEEEEE" Margin="0,0,20,8"/>
                        <CheckBox x:Name="chkCategorySummary" Content="Resumen por Categorías" IsChecked="True" Foreground="#EEEEEE" Margin="0,0,20,8"/>
                        <CheckBox x:Name="chkElementDetails" Content="Detalle Paramétrico de Elementos por ElementId" IsChecked="True" Foreground="#EEEEEE" Margin="0,0,20,8"/>
                        <CheckBox x:Name="chkRooms" Content="Habitaciones &amp; Espacios (Rooms)" IsChecked="True" Foreground="#EEEEEE" Margin="0,0,20,8"/>
                        <CheckBox x:Name="chkSchedules" Content="Tablas de Planificación / Datos (Schedules)" IsChecked="True" Foreground="#EEEEEE" Margin="0,0,20,8"/>
                        <CheckBox x:Name="chkSheetsViews" Content="Planos &amp; Vistas (Sheets/Views)" IsChecked="True" Foreground="#EEEEEE" Margin="0,0,20,8"/>
                        <CheckBox x:Name="chkMaterials" Content="Materiales del Modelo" IsChecked="True" Foreground="#EEEEEE" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Vista Previa del Paquete JSON a enviar a Supabase" Foreground="#5235EF" FontWeight="Bold" Background="#202024" BorderBrush="#333338" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="txtPreview" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#141416" Foreground="#00FF88" FontFamily="Consolas" FontSize="11" Padding="6" Margin="0,0,0,8"/>
                    <Button x:Name="btnSaveJson" Grid.Row="1" Content="💾 Exportar JSON a Archivo" Width="180" Height="28" HorizontalAlignment="Right" Background="#3E3E42" Foreground="#FFFFFF" BorderBrush="#555555" Click="BtnSaveJson_Click"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#222226" Padding="15,10">
            <Grid>
                <TextBlock x:Name="txtStatus" Text="Listo para conectar con Supabase." Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnPreview" Content="Generar Vista Previa" Width="140" Height="30" Margin="0,0,10,0" Background="#3E3E42" Foreground="#FFFFFF" BorderBrush="#555555" Click="BtnPreview_Click"/>
                    <Button x:Name="btnExport" Content="Conectar y Guardar en Supabase" Width="210" Height="30" Background="#5235EF" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#6B4EFF" Click="BtnExport_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
