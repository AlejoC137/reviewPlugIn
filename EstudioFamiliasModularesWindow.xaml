<Window x:Class="RevitToSupabasePlugin.EstudioFamiliasModularesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review BIM - Estudio de Familias Modulares (0,0) y Convertidor In-Situ"
        Height="780" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4" Foreground="#1C1C19"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="ArcaBg" Color="#FCF9F4"/>
        <SolidColorBrush x:Key="ArcaSurface" Color="#F6F3EE"/>
        <SolidColorBrush x:Key="ArcaCardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ArcaPrimary" Color="#0F4369"/>
        <SolidColorBrush x:Key="ArcaPrimaryHover" Color="#1D5A85"/>
        <SolidColorBrush x:Key="ArcaPrimaryLight" Color="#EBF2F7"/>
        <SolidColorBrush x:Key="ArcaBorder" Color="#DEDBD5"/>
        <SolidColorBrush x:Key="ArcaInk" Color="#1C1C19"/>
        <SolidColorBrush x:Key="ArcaMuted" Color="#5F6368"/>
        <SolidColorBrush x:Key="ArcaSuccess" Color="#1E6B45"/>
        <SolidColorBrush x:Key="ArcaWarning" Color="#B26A00"/>

        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="{StaticResource ArcaPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ArcaPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#D6D3CD"/>
                                <Setter Property="Foreground" Value="#8A8D91"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryBtn">
            <Setter Property="Background" Value="{StaticResource ArcaCardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ArcaInk}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ArcaBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ArcaPrimaryLight}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ArcaPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource ArcaPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#DEDBD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="BorderBrush" Value="#DEDBD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Identidad Arquitectónica Navy -->
        <Rectangle Grid.Row="0" Fill="#0F4369"/>

        <!-- Encabezado Editorial -->
        <Border Grid.Row="1" Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ESTUDIO DE FAMILIAS CARGABLES MODULARES (0,0) Y GESTOR IN-SITU"
                               FontSize="10" FontWeight="Bold" Foreground="#0F4369"/>
                    <TextBlock Text="Creador Paramétrico .RFA Residencial, Convertidor In-Situ y Motor de Instanciamiento"
                               FontSize="16" FontWeight="Bold" Foreground="#1C1C19" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#EBF2F7" BorderBrush="#0F4369" BorderThickness="1" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="ESTÁNDAR CARTESIANO (0,0) · 100% FAMILIAS CARGABLES (.RFA)"
                               FontSize="10.5" FontWeight="Bold" Foreground="#0F4369"/>
                </Border>
            </Grid>
        </Border>

        <!-- Cuerpo Principal: Izquierda Pestañas de Trabajo / Derecha Visor 3D Interactivo -->
        <Grid Grid.Row="2" Margin="18,14,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="580"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: 3 Pestañas -->
            <TabControl x:Name="tabMain" Grid.Column="0" Background="#FFFFFF" BorderBrush="#DEDBD5" BorderThickness="1"
                        SelectionChanged="TabMain_SelectionChanged">

                <!-- ========================================================================= -->
                <!-- PESTAÑA 1: CREADOR DE FAMILIAS CARGABLES (.RFA) PARA MODULACIÓN DESDE (0,0) -->
                <!-- ========================================================================= -->
                <TabItem Header="1. Creador Familias (.RFA)" Padding="12,6" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock Text="ARQUETIPO DE ELEMENTO RESIDENCIAL MODULAR"
                                       FontSize="10.5" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Categoría Modular:" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbModularCategory" SelectionChanged="CmbModularCategory_SelectionChanged">
                                        <ComboBoxItem Content="1. Tejas para Cubiertas (Instancia por Instancia)" IsSelected="True"/>
                                        <ComboBoxItem Content="2. Zócalos / Guardaescobas Perimetrales"/>
                                        <ComboBoxItem Content="3. Baldosas / Enchapes de Piso y Muro"/>
                                        <ComboBoxItem Content="4. Juntas / Pegas / Perfiles de Dilatación"/>
                                        <ComboBoxItem Content="5. Listones / Cielo Raso / Deck"/>
                                        <ComboBoxItem Content="6. Caballetes / Cumbreras de Techo"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Subtipo Geométrico en (0,0):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbModularSubtype" SelectionChanged="CmbModularSubtype_SelectionChanged"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nombre de Familia (.rfa):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtNewFamilyName" Text="Teja_Barro_Modular"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nombre de Tipo Inicial:" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtNewTypeName" Text="Colonial 45x22 cm"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="DIMENSIONES Y PARÁMETROS DESDE EL ORIGEN CARTESIANO (0,0,0)"
                                       FontSize="10.5" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblSpecLength" Text="Largo U (Length cm):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSpecLengthCm" Text="45.0" TextChanged="SpecInput_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="lblSpecWidth" Text="Ancho V (Width cm):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSpecWidthCm" Text="22.0" TextChanged="SpecInput_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock x:Name="lblSpecThickness" Text="Espesor (Thickness cm):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSpecThicknessCm" Text="1.8" TextChanged="SpecInput_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblSpecWave" Text="Alto Onda / Zócalo (cm):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSpecWaveCm" Text="6.5" TextChanged="SpecInput_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Traslapo Lat. Overlap_U (cm):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSpecOverlapUCm" Text="3.0" TextChanged="SpecInput_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Traslapo Sup. Overlap_V (cm):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSpecOverlapVCm" Text="7.0" TextChanged="SpecInput_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Bisel / Chaflán (mm):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSpecBevelMm" Text="2.0" TextChanged="SpecInput_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Material Asignado (Parámetro 'Mat'):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbSpecMaterial" DisplayMemberPath="Name"/>
                                </StackPanel>
                            </Grid>

                            <!-- Contrato Técnico de Parámetros -->
                            <Border Background="#EBF2F7" BorderBrush="#0F4369" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="CONTRATO DE PARÁMETROS INYECTADOS EN EL .RFA"
                                               FontSize="10" FontWeight="Bold" Foreground="#0F4369"/>
                                    <TextBlock x:Name="lblParameterContractInfo"
                                               Text="• Origen: Esquina inferior izquierda en (0,0,0) (X ≥ 0, Y ≥ 0, Z ≥ 0)&#x0a;• Tipo: Length, Width, Thickness, Height, Overlap_U, Overlap_V, WaveHeight, Mat&#x0a;• Instancia: Cut Lat, Cut Top (recortes en bordes) y Lenght (tramos lineales)"
                                               FontSize="11" Foreground="#1C1C19" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="btnGenerateModularRfa"
                                    Content="✨ Generar Familia Cargable (.RFA) en (0,0) y Cargar al Proyecto"
                                    Style="{StaticResource PrimaryBtn}"
                                    Height="40"
                                    Click="BtnGenerateModularRfa_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================================================= -->
                <!-- PESTAÑA 2: GESTOR Y CONVERTIDOR DE FAMILIAS IN-SITU A CARGABLES (.RFA)     -->
                <!-- ========================================================================= -->
                <TabItem Header="2. Gestor In-Situ ➔ Cargable (.RFA)" Padding="12,6" FontWeight="SemiBold">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="FAMILIAS IN-SITU (ISINPLACE) DETECTADAS EN EL MODELO"
                                           FontSize="10.5" FontWeight="Bold" Foreground="#0F4369"/>
                                <TextBlock Text="Selecciona un elemento In-Situ para auditar su origen (0,0,0) y convertirlo a familia cargable (.rfa)."
                                           FontSize="11" Foreground="#5F6368"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="🔄 Escanear Modelo" Style="{StaticResource SecondaryBtn}"
                                    Click="BtnRefreshInPlace_Click"/>
                        </Grid>

                        <ListBox x:Name="lstInPlaceFamilies" Grid.Row="1"
                                 Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="1"
                                 SelectionChanged="LstInPlaceFamilies_SelectionChanged"
                                 Margin="0,0,0,12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" BorderBrush="#DEDBD5" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" Foreground="#1C1C19" FontSize="12"/>
                                            <TextBlock Text="{Binding DimensionsSummary}" Foreground="#0F4369" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding MaterialName, StringFormat='Material: {0}'}" Foreground="#5F6368" FontSize="10.5"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="CONFIGURACIÓN DE CONVERSIÓN A FAMILIA CARGABLE (.RFA)"
                                           FontSize="10" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nuevo Nombre de Familia (.rfa):" FontSize="11" Foreground="#5F6368" Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtInPlaceNewFamilyName" Text=""/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Material para Parámetro 'Mat':" FontSize="11" Foreground="#5F6368" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="cmbInPlaceMaterial" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="chkReplaceInPlaceInstance"
                                          Content="Reemplazar el elemento In-Situ en el modelo por una instancia cargable en su coordenada (0,0)"
                                          IsChecked="True" FontSize="11.5" FontWeight="SemiBold" Foreground="#1C1C19" Margin="0,4,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnSelectInPlaceInView" Grid.Column="0"
                                            Content="🔍 Seleccionar en Vista" Style="{StaticResource SecondaryBtn}"
                                            Click="BtnSelectInPlaceInView_Click"/>
                                    <Button x:Name="btnConvertInPlace" Grid.Column="2"
                                            Content="⚡ Convertir In-Situ a Familia Cargable (.RFA) en (0,0)"
                                            Style="{StaticResource PrimaryBtn}"
                                            Click="BtnConvertInPlace_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========================================================================= -->
                <!-- PESTAÑA 3: MOTOR DE INSTANCIAMIENTO EN PROYECTO DESDE (0,0)                -->
                <!-- ========================================================================= -->
                <TabItem Header="3. Instanciador (Tejas / Zócalos)" Padding="12,6" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Sección A: Cubiertas y Tejas Instancia por Instancia -->
                            <Border Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="A. INSTANCIADOR DE TEJAS EN CUBIERTAS DESDE EL ALERO (0,0)"
                                               FontSize="10.5" FontWeight="Bold" Foreground="#0F4369"/>
                                    <TextBlock Text="Coloca tejas cargables (.rfa) instancia por instancia sobre cada faldón inclinado desde su origen (0,0) con traslapos y recortes en limatesas/cumbreras."
                                               FontSize="11" Foreground="#5F6368" TextWrapping="Wrap" Margin="0,3,0,10"/>

                                    <TextBlock Text="Familia Cargable de Teja (.rfa):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbRoofTileSymbol" DisplayMemberPath="FullName" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Traslapo U (cm):" FontSize="11" Foreground="#5F6368" Margin="0,0,0,3"/>
                                            <TextBox x:Name="txtRoofOverlapUCm" Text="3.0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Traslapo V (cm):" FontSize="11" Foreground="#5F6368" Margin="0,0,0,3"/>
                                            <TextBox x:Name="txtRoofOverlapVCm" Text="7.0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Material Teja:" FontSize="11" Foreground="#5F6368" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="cmbRoofTileMaterial" DisplayMemberPath="Name"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="btnPlaceRoofTiles"
                                            Content="🏠 Seleccionar Cubierta en Revit e Instanciar Tejas desde (0,0)"
                                            Style="{StaticResource PrimaryBtn}"
                                            Click="BtnPlaceRoofTiles_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Sección B: Zócalos Perimetrales -->
                            <Border Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="B. INSTANCIADOR DE ZÓCALOS PERIMETRALES DESDE (0,0)"
                                               FontSize="10.5" FontWeight="Bold" Foreground="#0F4369"/>
                                    <TextBlock Text="Recorre el perímetro del piso seleccionado desde su esquina (0,0) e instancia tramos de zócalo cargable ajustando 'Lenght'."
                                               FontSize="11" Foreground="#5F6368" TextWrapping="Wrap" Margin="0,3,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Familia Cargable de Zócalo (.rfa):" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="cmbSkirtingSymbol" DisplayMemberPath="FullName"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Material Zócalo:" FontSize="11.5" Foreground="#5F6368" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="cmbSkirtingMaterial" DisplayMemberPath="Name"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="btnPlaceSkirtingOnFloor"
                                            Content="📏 Seleccionar Piso e Instanciar Zócalos Perimetrales"
                                            Style="{StaticResource SecondaryBtn}"
                                            Click="BtnPlaceSkirtingOnFloor_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Sección C:Acceso directo al Modelador de Pisos (0,0) -->
                            <Border Background="#EBF2F7" BorderBrush="#0F4369" BorderThickness="1" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="C. MODELADOR INTEGRAL DE PISOS, BALDOSAS Y PEGAS (0,0)"
                                                   FontSize="10.5" FontWeight="Bold" Foreground="#0F4369"/>
                                        <TextBlock Text="Abre el motor de despiece de pisos alineado al Span Direction con junta perimetral de 5 mm y pegas sin solapamiento."
                                                   FontSize="11" Foreground="#1C1C19" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Abrir Modelador de Pisos"
                                            Style="{StaticResource SecondaryBtn}" Margin="10,0,0,0"
                                            Click="BtnOpenFloorModeler_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Panel Derecho: Visor 3D Interactivo con Ejes Cartesianos (0,0,0) -->
            <Border Grid.Column="2" Background="#1C1C19" BorderBrush="#DEDBD5" BorderThickness="1">
                <Grid>
                    <Viewport3D x:Name="viewport3D" ClipToBounds="True"
                                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                                MouseMove="Viewport_MouseMove"
                                MouseWheel="Viewport_MouseWheel">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="camera3D" Position="80,-80,65" LookDirection="-80,80,-65" UpDirection="0,0,1" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="modelGroup"/>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>

                    <!-- Etiqueta Superior del Visor 3D -->
                    <Border Background="#CC0F4369" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,6">
                        <StackPanel>
                            <TextBlock x:Name="lblPreviewTitle" Text="VISTA PREVIA 3D EN ORIGEN CARTESIANO (0,0,0)"
                                       Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                            <TextBlock x:Name="lblPreviewSubtitle" Text="Eje Rojo = U (X) | Eje Verde = V (Y) | Eje Azul = Z | Esquina (0,0,0) marcada"
                                       Foreground="#EBF2F7" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Métricas de Geometría en Esquina Inferior -->
                    <Border Background="#CC1C1C19" BorderBrush="#0F4369" BorderThickness="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblPreviewMetrics"
                                       Text="Largo U: 45.0 cm | Ancho V: 22.0 cm | Espesor: 1.8 cm | Paso útil: 19.0 × 38.0 cm"
                                       Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Centrar Cámara (0,0)" Style="{StaticResource SecondaryBtn}"
                                    Padding="8,3" FontSize="10.5" Click="BtnResetCamera_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de Estado y Cierre -->
        <Border Grid.Row="3" Background="#F6F3EE" BorderBrush="#DEDBD5" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblStatus"
                           Text="Listo. Todas las familias generadas o convertidas se guardan como .RFA cargables con origen en (0,0,0)."
                           FontSize="11.5" Foreground="#5F6368" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Cerrar Estudio" Style="{StaticResource SecondaryBtn}"
                        Width="120" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
