<Window x:Class="RevitToSupabasePlugin.LineStylesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📏 Gestor de Estilos de Línea &amp; Líneas No Imprimibles | ARCA REVIEW"
        Height="780" Width="1160"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#FCF9F4"
        Foreground="#1C1C19"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0F4369"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E8C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F6F3EE"/>
            <Setter Property="Foreground" Value="#1C1C19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#D0CBC2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAE4DA"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#888888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Background="#0F4369" CornerRadius="8" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📏 GESTOR DE ESTILOS DE LÍNEA &amp; LÍNEAS NO IMPRIMIBLES" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Configura calibres, colores y patrones al instante. Crea líneas auxiliares visibles con cotas y ocúltalas al imprimir sin perder las cotas." FontSize="11.5" Foreground="#D1E4F9" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✨ Crear 'ARCA - Auxiliar No Imprimible'" Style="{StaticResource PrimaryBtn}" Background="#7C3AED" VerticalAlignment="Center" Click="BtnCreateDefaultAux_Click" ToolTip="Crea automáticamente un estilo de línea auxiliar Magenta discontinuo marcado como No Imprimible"/>
            </Grid>
        </Border>

        <!-- BANNER MODO TRABAJO VS MODO IMPRESIÓN -->
        <Border Grid.Row="1" x:Name="borderPrintBanner" Background="#FFFFFF" BorderBrush="#D8D2C7" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtPrintModeTitle" Text="👁️ MODO TRABAJO: Líneas auxiliares visibles en pantalla" FontSize="13" FontWeight="Bold" Foreground="#0F4369"/>
                    <TextBlock x:Name="txtPrintModeDetail" Text="0 líneas auxiliares visibles | 0 ocultas para impresión" FontSize="11.5" Foreground="#5B616A" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🖨️ Ocultar para Imprimir (Conserva Cotas)" Style="{StaticResource PrimaryBtn}" Background="#B45309" Margin="10,0,8,0" Click="BtnActivatePrintMode_Click" ToolTip="Cambia las líneas de estilos 'No Imprimibles' a &lt;Invisible lines&gt; para que no salgan en PDF/impresión mientras sus cotas siguen visibles."/>
                <Button Grid.Column="2" Content="👁️ Mostrar en Pantalla (Modo Trabajo)" Style="{StaticResource PrimaryBtn}" Background="#059669" Click="BtnActivateWorkMode_Click" ToolTip="Restaura todas las líneas auxiliares ocultas a su estilo visible original."/>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: TABLA DE ESTILOS -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0DCD5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de Búsqueda y Filtro -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtSearch" Grid.Column="0" Padding="8,6" FontSize="12" Margin="0,0,8,0" TextChanged="TxtSearch_TextChanged" ToolTip="Buscar estilo de línea por nombre..."/>
                        <ComboBox x:Name="cmbFilter" Grid.Column="1" Padding="8,6" FontSize="12" Margin="0,0,8,0" SelectionChanged="CmbFilter_SelectionChanged">
                            <ComboBoxItem Content="Todos los estilos" IsSelected="True"/>
                            <ComboBoxItem Content="Solo No Imprimibles"/>
                            <ComboBoxItem Content="Solo Personalizados"/>
                            <ComboBoxItem Content="Solo Sistema (Revit)"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="🔄" Style="{StaticResource SecondaryBtn}" Padding="10,6" Click="BtnRefresh_Click" ToolTip="Recargar estilos desde Revit"/>
                    </Grid>

                    <!-- DataGrid de Estilos -->
                    <DataGrid x:Name="dgStyles" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EFECE6"
                              RowHeight="34"
                              Background="#FFFFFF"
                              BorderBrush="#E0DCD5"
                              BorderThickness="1"
                              SelectionChanged="DgStyles_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Vista Previa" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="95" Height="20" Background="#FFFFFF">
                                            <Line X1="4" Y1="10" X2="91" Y2="10"
                                                  Stroke="{Binding PreviewBrush}"
                                                  StrokeThickness="{Binding PreviewThickness}"
                                                  StrokeDashArray="{Binding PreviewDashCollection}"
                                                  StrokeStartLineCap="Flat"
                                                  StrokeEndLineCap="Flat"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Nombre del Estilo" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Calibre" Binding="{Binding LineWeight}" Width="62"/>
                            <DataGridTextColumn Header="Patrón" Binding="{Binding LinePatternName}" Width="125"/>

                            <DataGridTemplateColumn Header="Impresión" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NonPrintLabel}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNonPrintable}" Value="True">
                                                            <Setter Property="Foreground" Value="#7C3AED"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoLabel}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- PANEL DERECHO: EDITOR Y CONVERSIÓN -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- TARJETA 1: PROPIEDADES DEL ESTILO -->
                    <Border Background="#FFFFFF" BorderBrush="#E0DCD5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⚙️ CONFIGURACIÓN DEL ESTILO" FontSize="13" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,10"/>

                            <TextBlock Text="Nombre:" FontSize="11.5" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtStyleName" Padding="8,6" FontSize="12" Margin="0,0,0,10"/>

                            <!-- Calibre -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Calibre / Grosor (1 a 16):" FontSize="11.5" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,4"/>
                                    <Slider x:Name="sldWeight" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldWeight_ValueChanged"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbWeight" Grid.Column="1" VerticalAlignment="Bottom" Padding="6,5" SelectionChanged="CmbWeight_SelectionChanged"/>
                            </Grid>

                            <!-- Color -->
                            <TextBlock Text="Color de Línea:" FontSize="11.5" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="rectColorPreview" Grid.Column="0" Height="28" CornerRadius="4" BorderBrush="#888888" BorderThickness="1" Background="#000000"/>
                                <TextBlock x:Name="txtColorRgb" Grid.Column="1" Text="RGB(0, 0, 0)" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#374151"/>
                                <Button Grid.Column="2" Content="🎨 Elegir..." Style="{StaticResource SecondaryBtn}" Click="BtnPickColor_Click"/>
                            </Grid>

                            <!-- Paleta rápida -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource SwatchBtn}" Background="#000000" Tag="0,0,0" Click="BtnPresetColor_Click" ToolTip="Negro"/>
                                <Button Style="{StaticResource SwatchBtn}" Background="#808080" Tag="128,128,128" Click="BtnPresetColor_Click" ToolTip="Gris"/>
                                <Button Style="{StaticResource SwatchBtn}" Background="#DC2626" Tag="220,38,38" Click="BtnPresetColor_Click" ToolTip="Rojo"/>
                                <Button Style="{StaticResource SwatchBtn}" Background="#0284C7" Tag="2,132,199" Click="BtnPresetColor_Click" ToolTip="Azul"/>
                                <Button Style="{StaticResource SwatchBtn}" Background="#059669" Tag="5,150,105" Click="BtnPresetColor_Click" ToolTip="Verde"/>
                                <Button Style="{StaticResource SwatchBtn}" Background="#D946EF" Tag="217,70,239" Click="BtnPresetColor_Click" ToolTip="Magenta Auxiliar"/>
                                <Button Style="{StaticResource SwatchBtn}" Background="#06B6D4" Tag="6,182,212" Click="BtnPresetColor_Click" ToolTip="Cian Auxiliar"/>
                                <Button Style="{StaticResource SwatchBtn}" Background="#F97316" Tag="249,115,22" Click="BtnPresetColor_Click" ToolTip="Naranja"/>
                            </StackPanel>

                            <!-- Patrón -->
                            <TextBlock Text="Patrón de Línea:" FontSize="11.5" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,3"/>
                            <ComboBox x:Name="cmbPattern" Padding="8,6" FontSize="12" Margin="0,0,0,10"/>

                            <!-- Checkbox No Imprimible -->
                            <CheckBox x:Name="chkNonPrintable" Content="🖨️ Estilo No Imprimible (Auxiliar con Cotas)" FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED" Margin="0,0,0,12"/>

                            <!-- Botones CRUD -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button x:Name="btnSaveStyle" Grid.Row="0" Grid.Column="0" Content="💾 Guardar Cambios" Style="{StaticResource PrimaryBtn}" Margin="0,0,4,6" Click="BtnSaveStyle_Click"/>
                                <Button x:Name="btnCreateStyle" Grid.Row="0" Grid.Column="1" Content="➕ Crear Nuevo" Style="{StaticResource PrimaryBtn}" Background="#059669" Margin="4,0,0,6" Click="BtnCreateStyle_Click"/>
                                <Button x:Name="btnDeleteStyle" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="🗑️ Eliminar Estilo Personalizado" Style="{StaticResource SecondaryBtn}" Foreground="#DC2626" Click="BtnDeleteStyle_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TARJETA 2: CONVERTIR LÍNEAS EN EL MODELO -->
                    <Border Background="#FFFFFF" BorderBrush="#E0DCD5" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="🔄 CONVERTIR LÍNEAS AL ESTILO ELEGIDO" FontSize="13" FontWeight="Bold" Foreground="#0F4369" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtSelectionInfo" Text="Selección actual en Revit: 0 líneas" FontSize="11.5" Foreground="#4B5563" Margin="0,0,0,8"/>

                            <Button Content="🎯 Seleccionar Líneas en Revit..." Style="{StaticResource SecondaryBtn}" Margin="0,0,0,6" Click="BtnPickLines_Click" ToolTip="Oculta esta ventana temporalmente para seleccionar líneas en el plano"/>
                            <Button Content="🔄 Convertir Selección al Estilo Elegido" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,10" Click="BtnConvertSelected_Click"/>

                            <Separator Background="#EAE5DC" Margin="0,0,0,10"/>

                            <TextBlock Text="Conversión masiva en Vista Activa:" FontSize="11.5" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cmbSourceStyle" Grid.Column="0" DisplayMemberPath="Name" Padding="6,5" FontSize="11.5" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="Convertir Vista" Style="{StaticResource SecondaryBtn}" Click="BtnConvertBySourceInView_Click"/>
                            </Grid>

                            <Button Content="🔍 Seleccionar en Vista todas las de este Estilo" Style="{StaticResource SecondaryBtn}" Click="BtnSelectAllOfStyleInView_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- PIE -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="txtStatus" Text="Listo. Selecciona un estilo para editarlo o crea uno nuevo." FontSize="11.5" Foreground="#4B5563" VerticalAlignment="Center"/>
            <Button Content="Cerrar" HorizontalAlignment="Right" Style="{StaticResource SecondaryBtn}" Padding="16,6" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
