<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == '' and Exists('C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll')">2025</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and Exists('C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll')">2026</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and Exists('C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll')">2027</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitPath>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitPath>

    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyTitle>ARCA REVIEW</AssemblyTitle>
    <Company>ARCA REVIEW</Company>
    <Product>ARCA REVIEW</Product>
    <Authors>ALEJANDRO</Authors>
    <Copyright>Copyright © 2026 ARCA REVIEW - ALEJANDRO</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitPath)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitPath)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Compile Remove="scratch\**" />
    <None Remove="scratch\**" />
    <Compile Remove="_backup*/**" />
    <None Remove="_backup*/**" />
    <Compile Remove="**/*backup*/**" />
    <None Remove="**/*backup*/**" />
  </ItemGroup>

  <!-- Evento Post-Build para desplegar en Addins de Revit de forma segura sin bloquear si Revit está abierto -->
  <Target Name="PostBuild" AfterTargets="Build">
    <Message Text="Copiando archivos del plugin a las carpetas de Addins de Revit (2025 y 2027)..." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;foreach ($ver in @('2025', '2027')) { $dest = [System.IO.Path]::Combine($env:APPDATA, 'Autodesk', 'Revit', 'Addins', $ver); if (-not (Test-Path $dest)) { New-Item -ItemType Directory -Path $dest -Force | Out-Null }; try { Copy-Item -Path '$(TargetDir)*.dll' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; try { Copy-Item -Path '$(TargetDir)*.deps.json' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; try { Copy-Item -Path '$(ProjectDir)*.png' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; try { Copy-Item -Path '$(ProjectDir)*.rfa' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; try { Copy-Item -Path '$(ProjectDir)*.json' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; try { Copy-Item -Path '$(ProjectDir)RevitToSupabasePlugin.addin' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; if (Test-Path '$(ProjectDir)Familias') { try { Copy-Item -Path '$(ProjectDir)Familias' -Destination $dest -Recurse -Force -ErrorAction SilentlyContinue } catch {} } }&quot;" IgnoreExitCode="true" />
  </Target>
</Project>
