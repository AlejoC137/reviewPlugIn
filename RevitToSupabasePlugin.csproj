<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyTitle>ARCA REVIEW</AssemblyTitle>
    <Company>ARCA REVIEW</Company>
    <Product>ARCA REVIEW</Product>
    <Authors>ALEJANDRO</Authors>
    <Copyright>Copyright © 2026 ARCA REVIEW - ALEJANDRO</Copyright>
    <RevitVersion Condition="'$(RevitVersion)' == '' and Exists('C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll')">2025</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and Exists('C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll')">2026</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and Exists('C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll')">2027</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitPath>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitPath)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitPath)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Compile Remove="scratch\**" />
    <None Remove="scratch\**" />
    <Compile Remove="_backup*/**" />
    <None Remove="_backup*/**" />
    <Compile Remove="**/*backup*/**" />
    <None Remove="**/*backup*/**" />
  </ItemGroup>

  <!-- Evento Post-Build para copiar automáticamente los archivos a las carpetas de Addins de Revit 2025 y 2027 -->
  <Target Name="PostBuild" AfterTargets="Build">
    <Message Text="Copiando archivos del plugin a las carpetas de Addins de Revit (2025 y 2027)..." Importance="high" />
    
    <!-- Despliegue para Revit 2025 -->
    <Exec Command="if not exist &quot;$(AppData)\Autodesk\Revit\Addins\2025&quot; mkdir &quot;$(AppData)\Autodesk\Revit\Addins\2025&quot;" />
    <Exec Command="xcopy &quot;$(TargetDir)*.dll&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2025&quot; /Y /I" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(ProjectDir)*.png&quot; xcopy &quot;$(ProjectDir)*.png&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2025&quot; /Y /I" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(ProjectDir)*.rfa&quot; xcopy &quot;$(ProjectDir)*.rfa&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2025&quot; /Y /I" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(ProjectDir)*.json&quot; xcopy &quot;$(ProjectDir)*.json&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2025&quot; /Y /I" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(ProjectDir)Familias&quot; xcopy &quot;$(ProjectDir)Familias\*.*&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2025\Familias\&quot; /Y /I /E /S" IgnoreExitCode="true" />
    <Exec Command="copy &quot;$(ProjectDir)RevitToSupabasePlugin.addin&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2025&quot; /Y" IgnoreExitCode="true" />

    <!-- Despliegue para Revit 2027 -->
    <Exec Command="if not exist &quot;$(AppData)\Autodesk\Revit\Addins\2027&quot; mkdir &quot;$(AppData)\Autodesk\Revit\Addins\2027&quot;" />
    <Exec Command="xcopy &quot;$(TargetDir)*.dll&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2027&quot; /Y /I" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(ProjectDir)*.png&quot; xcopy &quot;$(ProjectDir)*.png&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2027&quot; /Y /I" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(ProjectDir)*.rfa&quot; xcopy &quot;$(ProjectDir)*.rfa&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2027&quot; /Y /I" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(ProjectDir)*.json&quot; xcopy &quot;$(ProjectDir)*.json&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2027&quot; /Y /I" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(ProjectDir)Familias&quot; xcopy &quot;$(ProjectDir)Familias\*.*&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2027\Familias\&quot; /Y /I /E /S" IgnoreExitCode="true" />
    <Exec Command="copy &quot;$(ProjectDir)RevitToSupabasePlugin.addin&quot; &quot;$(AppData)\Autodesk\Revit\Addins\2027&quot; /Y" IgnoreExitCode="true" />
  </Target>
</Project>
