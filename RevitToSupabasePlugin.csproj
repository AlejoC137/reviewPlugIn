<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">net8.0-windows;net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyTitle>ARCA REVIEW</AssemblyTitle>
    <Company>ARCA REVIEW</Company>
    <Product>ARCA REVIEW</Product>
    <Authors>ALEJANDRO</Authors>
    <Copyright>Copyright © 2026 ARCA REVIEW - ALEJANDRO</Copyright>
  </PropertyGroup>

  <!-- Referencias para Revit 2025 / 2026 (net8.0-windows) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows' and Exists('C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll')">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows' and !Exists('C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll')">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.2.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.2.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- Referencias para Revit 2027 (net10.0-windows) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' and Exists('C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll')">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' and !Exists('C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll')">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.2.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.2.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Compile Remove="scratch\**" />
    <None Remove="scratch\**" />
    <Compile Remove="_backup*/**" />
    <None Remove="_backup*/**" />
    <Compile Remove="**/*backup*/**" />
    <None Remove="**/*backup*/**" />
  </ItemGroup>

  <!-- Evento Post-Build para desplegar en la carpeta de Addins correspondiente a cada version de Revit -->
  <Target Name="PostBuild" AfterTargets="Build">
    <PropertyGroup>
      <TargetRevitVer Condition="'$(TargetFramework)' == 'net8.0-windows'">2025</TargetRevitVer>
      <TargetRevitVer Condition="'$(TargetFramework)' == 'net10.0-windows'">2027</TargetRevitVer>
    </PropertyGroup>
    <Message Text="Copiando archivos del plugin ($(TargetFramework)) a la carpeta de Addins de Revit $(TargetRevitVer)..." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$ver = '$(TargetRevitVer)'; if ($ver) { $dest = [System.IO.Path]::Combine($env:APPDATA, 'Autodesk', 'Revit', 'Addins', $ver); if (-not (Test-Path $dest)) { New-Item -ItemType Directory -Path $dest -Force | Out-Null }; Get-ChildItem -Path '$(TargetDir)*.dll' | ForEach-Object { $tf = Join-Path $dest $_.Name; if (Test-Path $tf) { $old = $tf + '.old'; try { Remove-Item $old -Force -ErrorAction SilentlyContinue } catch {}; try { Move-Item -Path $tf -Destination $old -Force -ErrorAction SilentlyContinue } catch {} }; try { Copy-Item -Path $_.FullName -Destination $dest -Force -ErrorAction SilentlyContinue } catch {} }; try { Copy-Item -Path '$(TargetDir)*.deps.json' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; try { Copy-Item -Path '$(ProjectDir)*.png' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; try { Copy-Item -Path '$(ProjectDir)*.rfa' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; try { Copy-Item -Path '$(ProjectDir)*.json' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; try { Copy-Item -Path '$(ProjectDir)RevitToSupabasePlugin.addin' -Destination $dest -Force -ErrorAction SilentlyContinue } catch {}; if (Test-Path '$(ProjectDir)Familias') { try { Copy-Item -Path '$(ProjectDir)Familias' -Destination $dest -Recurse -Force -ErrorAction SilentlyContinue } catch {} } }&quot;" IgnoreExitCode="true" />
  </Target>
</Project>
