<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         ARCA REVIEW DESIGN SYSTEM — PALETA OFICIAL DE COLORES Y TOKENS GRÁFICOS
         Norma obligatoria: Todas las ventanas, páginas y controles deben basarse
         en esta definición gráfica arquitectónica (Linen, Slate, Navy Blueprint).
         ========================================================================= -->

    <!-- Fondos y Superficies -->
    <SolidColorBrush x:Key="ArcaBg" Color="#FCF9F4"/>
    <SolidColorBrush x:Key="ArcaSurface" Color="#F6F3EE"/>
    <SolidColorBrush x:Key="ArcaSurfaceHighlight" Color="#E5E2DD"/>
    <SolidColorBrush x:Key="ArcaCardBg" Color="#FFFFFF"/>

    <!-- Acentos e Identidad de Marca -->
    <SolidColorBrush x:Key="ArcaPrimary" Color="#0F4369"/>
    <SolidColorBrush x:Key="ArcaPrimaryHover" Color="#1C1C19"/>
    <SolidColorBrush x:Key="ArcaPrimaryContainer" Color="#D1E4F9"/>
    <SolidColorBrush x:Key="ArcaPrimaryDark" Color="#09283F"/>

    <!-- Tinta y Texto -->
    <SolidColorBrush x:Key="ArcaInk" Color="#1C1C19"/>
    <SolidColorBrush x:Key="ArcaMuted" Color="#72777F"/>
    <SolidColorBrush x:Key="ArcaBorder" Color="#1C1C19"/>
    <SolidColorBrush x:Key="ArcaOutlineVariant" Color="#C2C7CF"/>

    <!-- Estados / Semáforo -->
    <SolidColorBrush x:Key="ArcaSuccess" Color="#059669"/>
    <SolidColorBrush x:Key="ArcaSuccessBg" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="ArcaSuccessText" Color="#065F46"/>
    <SolidColorBrush x:Key="ArcaError" Color="#BA1A1A"/>
    <SolidColorBrush x:Key="ArcaErrorBg" Color="#FFDAD6"/>

    <!-- Contenedor Tarjeta Técnica (ARCA Blueprint Sharp Card) -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="#F6F3EE"/>
        <Setter Property="BorderBrush" Value="#1C1C19"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Tarjeta Métrica / KPI -->
    <Style x:Key="KpiCard" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#1C1C19"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="2"/>
    </Style>

    <!-- Botón Primario (Navy Blueprint) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="#0F4369"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#1C1C19"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1C1C19"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#09283F"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón Secundario (Warm Surface + Borde Ink) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#F6F3EE"/>
        <Setter Property="Foreground" Value="#1C1C19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#1C1C19"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E5E2DD"/>
                            <Setter Property="BorderBrush" Value="#0F4369"/>
                            <Setter Property="Foreground" Value="#0F4369"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#D1E4F9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de Éxito / Acción Principal Confirmada -->
    <Style x:Key="SuccessButton" TargetType="Button">
        <Setter Property="Background" Value="#059669"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#1C1C19"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#047857"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#065F46"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de Peligro / Acción Destructiva (Eliminar / Danger) -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="#BA1A1A"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#1C1C19"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#93000A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#690005"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de Tarjeta de Acción -->
    <Style x:Key="ActionCardButton" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#1C1C19"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#1C1C19"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F6F3EE"/>
                            <Setter Property="BorderBrush" Value="#0F4369"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#D1E4F9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox Técnico Plano Cuadrado (Crisp Blueprint) -->
    <Style x:Key="ArcaCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#1C1C19"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border x:Name="BoxBorder" Width="15" Height="15" Background="#FFFFFF" BorderBrush="#1C1C19" BorderThickness="1.5" CornerRadius="0">
                                <Path x:Name="CheckGlyph" Data="M 3 7 L 6 11 L 12 3" Stroke="#0F4369" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="BoxBorder" Property="Background" Value="#D1E4F9"/>
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#0F4369"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#0F4369"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton Técnico Plano -->
    <Style x:Key="ArcaRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#1C1C19"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2,12,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border x:Name="DotBorder" Width="15" Height="15" Background="#FFFFFF" BorderBrush="#1C1C19" BorderThickness="1.5" CornerRadius="8">
                                <Ellipse x:Name="DotGlyph" Width="7" Height="7" Fill="#0F4369" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="DotGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="DotBorder" Property="Background" Value="#D1E4F9"/>
                            <Setter TargetName="DotBorder" Property="BorderBrush" Value="#0F4369"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DotBorder" Property="BorderBrush" Value="#0F4369"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox Técnico -->
    <Style x:Key="ArcaTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#1C1C19"/>
        <Setter Property="BorderBrush" Value="#1C1C19"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="#0F4369"/>
        <Setter Property="SelectionBrush" Value="#0F4369"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
    </Style>

    <!-- GroupBox Técnico Arquitectónico -->
    <Style x:Key="ArcaGroupBox" TargetType="GroupBox">
        <Setter Property="Background" Value="#F6F3EE"/>
        <Setter Property="BorderBrush" Value="#1C1C19"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#0F4369"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Terminal de Consola / Log Técnico -->
    <Style x:Key="ArcaTerminalBorder" TargetType="Border">
        <Setter Property="Background" Value="#1C1C19"/>
        <Setter Property="BorderBrush" Value="#0F4369"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

</ResourceDictionary>
